<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Include="..\TestArtifactDirectory.cs" Link="TestArtifactDirectory.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TESTOUT_01: dotnet test writes results only to logs\Core_Results (docs/05 SYS-STORAGE-TABLE). -->
    <VSTestResultsDirectory>$(MSBuildThisFileDirectory)..\..\logs\Core_Results</VSTestResultsDirectory>
    <IsTestProject>true</IsTestProject>
    <NuGetAudit>false</NuGetAudit>
    <!-- IPCOWNER_01: IpcChildProcess.Main runs real cross-process IPC clients. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FreeVideoStudio.Core\FreeVideoStudio.Core.csproj" />
    <ProjectReference Include="..\..\build\FvsBuild\FvsBuild.csproj" />
  </ItemGroup>

</Project>
