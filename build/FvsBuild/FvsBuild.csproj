<Project Sdk="Microsoft.NET.Sdk">

  <!-- FvsBuild - the structured build orchestrator behind Build.cmd / dev_build.cmd.
       It replaces the old monolithic batch file: dependency staging, payload.zip
       creation (System.IO.Compression replaces tar.exe), the two NativeAOT
       dotnet publish passes, single-file output validation, optional Authenticode
       signing and the optional GitHub release replacement all live here, so CI can
       run the exact same pipeline by invoking this project with the "no-publish"
       flag. No batch quirks, no shell-encoding sensitivity, no temp-dir shuffles
       outside .\obj\StandaloneTemp. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="FreeVideoStudio.Core.Tests" />
    <!--
      SYS-PAYLOADSPLIT. The build needs RuntimePayloadManifest, and it must be the SAME type the
      app reads at update time — a second copy of the fingerprint algorithm here would drift, and a
      drifted fingerprint silently sends everyone the 322 MB installer forever, which reads as "the
      feature does not work" rather than as a bug.
    -->
    <ProjectReference Include="..\..\src\FreeVideoStudio.Core\FreeVideoStudio.Core.csproj" />
  </ItemGroup>

</Project>
