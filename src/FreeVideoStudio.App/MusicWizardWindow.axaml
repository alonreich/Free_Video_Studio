<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FreeVideoStudio.App"
        xmlns:controls="clr-namespace:FreeVideoStudio.App.Controls"
        x:Class="FreeVideoStudio.App.MusicWizardWindow"
        Title="Background Music Selection Wizard"
        Background="{DynamicResource AppSurfaceBrush}"
        CanResize="True"
        MinWidth="1300" MinHeight="730"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        DragDrop.AllowDrop="True">

    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" TextTrimming="CharacterEllipsis" />
                </Border>
                <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="20">

                    <!-- ISSUE_04: the permanent, always-available way back into this screen's walkthrough.
                                     The walkthrough auto-plays only on the first few opens; this button is
                                     how a returning user gets it again. Every screen in the suite has one. -->
                    <Button Grid.Row="0" Name="WizardHelpButton" Classes="Secondary" Content="?" MinWidth="{DynamicResource AppSpeedPresetMinWidth}" MinHeight="{DynamicResource AppButtonMinHeight}" Padding="0" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="5" AutomationProperties.Name="Show me around the music wizard" ToolTip.Tip="New here? Play the short walkthrough that points out what everything on this screen does."/>

                    <!-- Step Progress Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,15" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="50,0,50,0" Height="2" Background="{DynamicResource AppBorderBrush}"/>
                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="50,0,50,0" Height="2" Background="{DynamicResource AppBorderBrush}"/>
                        <!-- Step 1 (Active) -->
                        <Border Grid.Row="0" Grid.Column="0" Name="Step1Dot" Classes="WizDotActive" MinWidth="32" MinHeight="32" CornerRadius="16" HorizontalAlignment="Center" ZIndex="1">
                            <TextBlock Name="Step1Icon" Classes="WizIconOn" Text="1" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="0" Name="Step1Label" Classes="WizLabelActive" Text="Select Music" FontSize="{DynamicResource AppFontSize9}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <!-- Step 2 (Pending) -->
                        <Border Grid.Row="0" Grid.Column="1" Name="Step2Dot" Classes="WizDotPending" MinWidth="32" MinHeight="32" CornerRadius="16" HorizontalAlignment="Center" ZIndex="1">
                            <TextBlock Name="Step2Icon" Classes="WizIconPending" Text="2" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Name="Step2Label" Classes="WizLabelPending" Text="Mix and Preview" FontSize="{DynamicResource AppFontSize9}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <!-- Step 3 (Pending) -->
                        <Border Grid.Row="0" Grid.Column="2" Name="Step3Dot" Classes="WizDotPending" MinWidth="32" MinHeight="32" CornerRadius="16" HorizontalAlignment="Center" ZIndex="1">
                            <TextBlock Name="Step3Icon" Classes="WizIconPending" Text="3" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="2" Name="Step3Label" Classes="WizLabelPending" Text="Confirm" FontSize="{DynamicResource AppFontSize9}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </Grid>

                    <!-- Step Container -->
                    <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppPanelBrush}" BorderThickness="1" Padding="20">
                        <Panel>

                            <!-- STEP 1: Track Selection -->
                            <Grid Name="Step1Panel" IsVisible="True" RowDefinitions="Auto,Auto,Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,10">
                                    <TextBlock Grid.Column="0" Text="SELECT BACKGROUND MUSIC" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                                    <!-- ISSUE_10: the shared song library (the repo's mp3 folder) is distributed exactly
                                         like the memes, but until now only memes had a "download more" route, so users
                                         had no in-app way to get the songs at all. -->
                                    <Button Grid.Column="2" Name="DownloadSongsBtn" Content="⬇ Download More Songs" Classes="Success" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" ToolTip.Tip="Download background music tracks from the official library into the current folder" AutomationProperties.Name="Download more songs"/>
                                    <Button Grid.Column="3" Name="ChangeFolderBtn" Content="Change Folder" Classes="Primary" VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="Choose a different folder to browse for music files"/>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <TextBox Name="MusicSearchBox" Watermark="Search songs" Text="{Binding $parent[local:MusicWizardWindow].MusicSearchText, Mode=TwoWay}" MinHeight="{DynamicResource AppButtonMinHeight}" FontSize="{DynamicResource AppFontSize12}" VerticalContentAlignment="Center" Padding="10,0,38,0"/>
                                        <Button Name="ClearSearchBtn" Content="✕" Classes="Secondary" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Clear search and show all songs" AutomationProperties.Name="Clear search" Cursor="Hand" IsVisible="False" Focusable="False"/>
                                    </Grid>
                                    <ComboBox Grid.Column="1" Name="MusicSortComboBox" MinWidth="150" MinHeight="{DynamicResource AppButtonMinHeight}" Margin="8,0,0,0" SelectedIndex="0" VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Change how the music files are sorted.">
                                        <ComboBoxItem Content="Name"/>
                                        <ComboBoxItem Content="Newest"/>
                                        <ComboBoxItem Content="Shortest"/>
                                        <ComboBoxItem Content="Longest"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="2" Name="MusicResultCountText" Text="0 songs" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <!-- ══════════════════════════════════════════════════════════════
                                     LIST_03 — COLUMN HEADINGS.

                                     The list has had two columns since LIST_01 and neither said what
                                     it was, so "3:41" on the right was a number the user had to infer
                                     the meaning of. This strip sits OUTSIDE the ListBox, so it stays
                                     put while the songs scroll under it.

                                     ⚠️ Its four columns must stay identical to the row template's
                                     (Auto,Auto,Auto,Auto with the same two bound widths). Both the
                                     header and every row take their name width from
                                     TrackNameColumnWidth and their pin width from
                                     TrackPinColumnWidth, so there is exactly one number behind each
                                     edge and the heading cannot drift away from the column it names.
                                     The 2px left margin matches the ListBox's own Padding="2".
                                     ══════════════════════════════════════════════════════════════ -->
                                <!-- ══════════════════════════════════════════════════════════════
                                     LIST_05 — THE CLOSED TABLE FRAME.

                                     Rows 2 and 3 used to be two unrelated controls with hairlines
                                     only UNDER each row and DOWN one column, so the table had no
                                     top rule over its own headings and no left or right edge at
                                     all — every line started and stopped in mid-air.

                                     They now live inside ONE 1px-bordered Border. Its width is
                                     TrackTableWidth (measured in RecalculateTrackTableWidth from
                                     the same three column widths the header and rows bind to), so
                                     the right edge lands exactly where the Length column ends
                                     instead of a hand-span past it — which is the reason LIST_04
                                     left-packs the rows in the first place.

                                     ⚠️ The frame is HorizontalAlignment="Left" and the ListBox
                                     inside it stretches. Do not move the border onto the ListBox
                                     alone: the headings would fall outside the box again.
                                     ══════════════════════════════════════════════════════════════ -->
                                <!-- LIST_06: MaxWidth, NOT Width.
                                     Width made the frame's size a FUNCTION of TrackNameColumnWidth,
                                     while RecalculateTrackNameColumnWidth measured the ListBox INSIDE
                                     that frame to decide TrackNameColumnWidth. A closed loop: every
                                     layout pass fed its own output back in, the columns pulsed, and the
                                     scrollbar thumb was re-laid-out under the pointer on every frame,
                                     which is why dragging it jumped instead of scrolling.

                                     MaxWidth breaks it. The frame still refuses to run past the end of
                                     its last column (the whole point of LIST_05), but its width is now a
                                     CONSTRAINT satisfied during layout rather than an input the
                                     measurement reads back. The measurement itself now clamps against
                                     Step1Panel, which is sized by the window and never by these
                                     columns — see RecalculateTrackNameColumnWidth. -->
                                <Border Grid.Row="2" Grid.RowSpan="2" HorizontalAlignment="Left"
                                        MaxWidth="{Binding $parent[local:MusicWizardWindow].TrackTableWidth}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="4"
                                        Background="{DynamicResource AppSurfaceBrush}">
                                    <Grid RowDefinitions="Auto,*">

                                        <!-- The heading strip. Its own bottom hairline is what closes
                                             the table UNDER the titles; the 7px left inset keeps the
                                             headings over their columns (row Border Padding 5 +
                                             ListBox Padding 2). -->
                                        <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="0,0,0,1" Padding="7,4,0,4">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" HorizontalAlignment="Left">
                                                <TextBlock Grid.Column="0" Text="" Width="{Binding $parent[local:MusicWizardWindow].TrackPinColumnWidth}"/>
                                                <TextBlock Grid.Column="1" Text="Song Name" Width="{Binding $parent[local:MusicWizardWindow].TrackNameColumnWidth}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border Grid.Column="2" Width="1" Background="{DynamicResource AppBorderBrush}" Margin="10,0,10,0"/>
                                                <TextBlock Grid.Column="3" Text="Length" Width="{Binding $parent[local:MusicWizardWindow].TrackLengthColumnWidth}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                <Grid Grid.Row="1" Grid.Column="0">
                                    <!-- LIST_06: BACK TO "Visible", AND IT MUST STAY THERE. On "Auto" the scrollbar
                                             appears and disappears as the content height crosses the viewport,
                                             and each toggle changes the list's usable width, which re-entered
                                             RecalculateTrackNameColumnWidth and re-sized every column. That is
                                             the stutter. A permanently reserved scrollbar gutter is one fewer
                                             thing that can change width underneath a width measurement. -->
                                    <ListBox Name="MusicListBox" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="2" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.AllowAutoHide="False">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="MinHeight" Value="24"/>
                                                <Setter Property="Margin" Value="0"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <!-- ══════════════════════════════════════════════════════════════
                                             LIST_01 — READING A LENGTH OFF THE RIGHT-HAND EDGE.

                                             This row used to be [PIN][name .......][12.4 MB][3:41], with the
                                             two numbers pushed to the far right by a "*" name column. On a
                                             wide window that leaves a hand-span of blank space between a song
                                             and its own length, and the eye slides onto the wrong row on the
                                             way across. Two changes:

                                               1. THE FILE SIZE IS GONE. Nobody picks a backing track by how
                                                  many megabytes it is, and it was the column doing most of
                                                  the separating.
                                               2. HAIRLINE RULES. A 1px bottom border per row and a 1px rule
                                                  down the left of the length column give the eye a track to
                                                  follow. Deliberately drawn at ~10% alpha: enough to guide,
                                                  not enough to read as a table.

                                             The length column is a fixed 64px so every length starts at the
                                             same x — a ragged right edge is what makes a list feel unaligned
                                             even when every row is technically right-aligned.
                                             ══════════════════════════════════════════════════════════════ -->
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:MusicTrackItem">
                                                <!-- LIST_04: HorizontalAlignment="Left" is what stops the table
                                                     running off to the right. This Border carries the hairline
                                                     rule under each row, and while it stretched the rule ran the
                                                     whole width of the list — a table edge hundreds of pixels
                                                     past the last thing in it. Left-aligned, the rule ends just
                                                     after the length. Selection and hover still cover the full
                                                     row: those come from the ListBoxItem behind this Border, not
                                                     from the Border itself. -->
                                                <!-- LIST_05: was HorizontalAlignment="Left", which ended the
                                                     row's hairline just after the length and left the table's
                                                     right side open. The frame added in LIST_05 is itself only
                                                     as wide as the columns, so the row can now stretch to it
                                                     and every rule meets the box on both sides. LIST_04's
                                                     concern — a rule running hundreds of pixels past the last
                                                     column — is handled by the frame's width, not by the row. -->
                                                <!-- LIST_07: the 14px right margin is the SCROLLBAR GUTTER.
                                                     Rows stretch to the full list width, so the length column
                                                     and the row's own hairline ran straight into the vertical
                                                     scrollbar — the thumb sat ON the table content instead of
                                                     beside it, and the last column had nowhere to breathe.
                                                     This margin ends the table content (and every rule in it)
                                                     BEFORE the gutter; the scrollbar then occupies that gutter
                                                     alone, between the last column and the frame's border.
                                                     ⚠️ Keep in step with TrackRowFurnitureWidthPx, which
                                                     reserves this gap PLUS the scrollbar width so the frame is
                                                     wide enough to hold both. -->
                                                <Border Padding="5,3" CornerRadius="0" Cursor="Hand" HorizontalAlignment="Stretch"
                                                        Margin="0,0,14,0"
                                                        ToolTip.Tip="Click to select this track — it starts playing straight away"
                                                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppTableHairlineBrush}">
                                                    <!-- LIST_02: every column is Auto and the NAME cell carries an explicit
                                                         width, so the row packs to the left instead of stretching the name
                                                         across the whole list and flinging the length at the far edge. The
                                                         width is measured at runtime from the longest song title in the
                                                         folder plus a 50px gap (TrackNameColumnWidth) — see
                                                         RecalculateTrackNameColumnWidth. 72px for the length, up from 64:
                                                         the old cell plus its right margin could not hold "1:04:07" at the
                                                         larger font scales and clipped the last character. -->
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto">
                                                        <!-- LIST_03: a FIXED (measured) width, not Auto. On Auto this cell was
                                                             0px wide on ordinary rows and ~40px on RECENT ones, so the name
                                                             column started at a different x on every row — the list only
                                                             LOOKED aligned because most rows happened to be empty here. -->
                                                        <TextBlock Grid.Column="0" Text="{CompiledBinding PinText}" Width="{Binding $parent[local:MusicWizardWindow].TrackPinColumnWidth}" Foreground="{DynamicResource AppAccentBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{CompiledBinding Name}" Width="{Binding $parent[local:MusicWizardWindow].TrackNameColumnWidth}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="2" Width="1" Background="{DynamicResource AppTableHairlineBrush}" VerticalAlignment="Stretch" Margin="10,1,10,1"/>
                                                        <TextBlock Grid.Column="3" Text="{CompiledBinding DurationText}" Width="{Binding $parent[local:MusicWizardWindow].TrackLengthColumnWidth}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Name="EmptyMusicListText" Text="No music files found. Change folder or drop an audio file here." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False" IsVisible="False"/>
                                </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- STEP 2: Waveform + Song Start -->
                            <ScrollViewer Name="Step2Panel" IsVisible="False" VerticalScrollBarVisibility="Auto">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                                    <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Selected:" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" VerticalAlignment="Center"/>
                                            <TextBlock Name="SelectedTrackLabel" Text="-" TextTrimming="CharacterEllipsis" MaxWidth="420" Foreground="{DynamicResource AppTextPrimaryBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize11}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="CHOOSE WHERE THE SONG BEGINS" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,0,5"/>

                                    <!-- ISSUE_5: MinHeight (was a fixed Height="120") per the suite Font-Scale
                                         Sizing Rule, so the waveform strip grows with the Settings font scale
                                         instead of staying small while the labels around it get bigger. -->
                                    <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" BorderBrush="{DynamicResource AppPanelBrush}" BorderThickness="1" Margin="0,5" MinHeight="120">
                                        <Panel>
                                            <Image Name="WaveformImage" Stretch="Fill"/>
                                            <Canvas Name="WaveformCanvas" Classes="TimelineSeekSurface" ClipToBounds="True" Cursor="Hand" Focusable="True" AutomationProperties.Name="Song start waveform seek area" ToolTip.Tip="Click the point in the song where the video should begin" KeyboardNavigation.IsTabStop="True" />
                                            <TextBlock Name="WaveformLoadingText" Text="Generating Waveform..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Row="3" Spacing="0">
                                        <Grid VerticalAlignment="Center" MinHeight="66" RowDefinitions="20,14,32" ClipToBounds="False">
                                            <Canvas Name="TimelineScaleCanvas" Grid.Row="1" IsHitTestVisible="False" ClipToBounds="False" HorizontalAlignment="Stretch" Height="14" ZIndex="10000" />
                                            <Grid Grid.Row="2" Grid.Column="0" Height="32" ClipToBounds="False" ZIndex="10001">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AppPanelBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                            </Grid>
                                            <Canvas Name="TimelineMarkersCanvas" Classes="TimelineSeekSurface" Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="True" ClipToBounds="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ZIndex="10003" Cursor="Hand" Focusable="True" AutomationProperties.Name="Song start timeline seek area" ToolTip.Tip="Click the point in the song where the video should begin" KeyboardNavigation.IsTabStop="True" />
                                        </Grid>
                                        <TextBlock Name="OffsetLabel" Text="Song begins at 0.0s" Foreground="{DynamicResource AppInfoBrush}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="{DynamicResource AppFontSize11}" Margin="0,5,0,5" IsVisible="True"/>
                                        <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,Auto,Auto,*">
                                            <!-- FITEND_01: works backwards from the song's real ending instead of
                                                 forwards from a start point, so the last frame of the video lands on
                                                 the last musical moment of the song. See FindFitByEndStart. -->
                                            <Button Grid.Column="0" Name="FitByEndBtn" Content="Fit By End Of Video" Classes="Secondary" MinWidth="140" FontSize="{DynamicResource AppFontSize10}" HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="Line the END of the song up with the END of your video.&#x0a;&#x0a;It finds where the song really finishes — the last moment there is still something to hear, not the silence after it — and works backwards from there by the length of your video.&#x0a;&#x0a;Your video then finishes on the song's last note instead of cutting off mid-verse."/>
                                            <Button Grid.Column="1" Name="BeatSnapBtn" Content="Snap To Beat" Classes="Secondary" MinWidth="110" FontSize="{DynamicResource AppFontSize10}" HorizontalContentAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="Move the song start to the nearest strong beat."/>
                                            <Button Grid.Column="2" Name="SmartFitBtn" Content="Smart Fit" Classes="Primary" MinWidth="100" FontSize="{DynamicResource AppFontSize10}" HorizontalContentAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="Pick a strong song section that fits the video length."/>
                                            <TextBlock Grid.Column="3" Name="SmartFitStatusText" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,0,0"/>
                                        </Grid>

                                        <StackPanel Spacing="10" Margin="0,10,0,0">
                                            <!-- DUCKNAME_01: both of these change the FINISHED video, not this preview
                                                 (the smooth blend is previewed; the volume drop is not). The old wording
                                                 described the machinery — "auto-lower music during loud game sounds" —
                                                 instead of the thing the user wants, which is to still hear their game.
                                                 Tooltips now say plainly what happens and when. -->
                                            <CheckBox Name="DuckingCheckBox" Content="Protect the main video sound from music" MinHeight="44" IsChecked="True" Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                      ToolTip.Tip="Leave this ON.&#x0a;&#x0a;Whenever something loud happens in your gameplay — a gunshot, a shout, an explosion — the music steps back for a moment so you can still hear it. Then it comes back up.&#x0a;&#x0a;Turn it OFF and the music stays at the same level the whole way through, on top of everything.&#x0a;&#x0a;This is applied when your video is saved. You will not hear it change in this preview; the main preview plays the saved sound once this wizard closes."/>
                                            <CheckBox Name="CarvingCheckBox" Content="Smooth blend between music and game audio" MinHeight="44" IsChecked="True" Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                      ToolTip.Tip="Leave this ON.&#x0a;&#x0a;Music and game sound often fight over the same pitches, which makes both sound muddy. This scoops a little out of the music exactly where voices and game sounds live, so the two sit together instead of clashing.&#x0a;&#x0a;This is applied when your video is saved. You will not hear it change in this preview; the main preview plays the saved sound once this wizard closes."/>
                                        </StackPanel>

                                        <!-- MULTI SONG HELPER (Video Merger Mode) -->
                                        <StackPanel Name="MultiSongHelperPanel" IsVisible="False" Margin="0,15,0,0">
                                            <Border Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                <StackPanel Spacing="10">
                                                    <!-- Coverage Bar -->
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="MUSIC COVERAGE" Foreground="{DynamicResource AppAccentBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize10}"/>
                                                            <TextBlock Grid.Column="1" Name="CoveragePercentText" Text="0%" Foreground="{DynamicResource AppWarningBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize10}"/>
                                                        </Grid>
                                                        <Border Height="20" CornerRadius="4" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                                            <Grid>
                                                                <Border Name="CoverageBarFill" Background="{DynamicResource AppSuccessBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="0" MinWidth="0"/>
                                                                <TextBlock Name="CoverageBarText" Text="" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Warning Banner -->
                                                    <Border Name="CoverageWarningBanner" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" IsVisible="False">
                                                        <TextBlock Name="CoverageWarningText" Text="" Foreground="{DynamicResource AppWarningBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize10}" TextWrapping="Wrap"/>
                                                    </Border>

                                                    <!-- Loop Toggle -->
                                                    <CheckBox Name="LoopMusicCheckBox" Content="Loop music until video ends" MinHeight="44" IsChecked="False" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" ToolTip.Tip="Repeat the song from the beginning when it ends so music covers the entire video"/>

                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Button Grid.Column="0" Name="AutoFillSongsBtn" Classes="Primary" Content="Auto-Fill Remaining Time" HorizontalAlignment="Left" FontSize="{DynamicResource AppFontSize10}" ToolTip.Tip="Automatically add songs from your music folder to cover remaining silence in the video."/>
                                                        <CheckBox Grid.Column="1" Name="AutoFillVisibleOnlyCheckBox" Content="Use visible search results for Auto-Fill" MinHeight="44" IsChecked="True" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" VerticalAlignment="Center" ToolTip.Tip="When enabled, Auto-Fill uses the current search and sort results."/>
                                                    </Grid>

                                                    <Grid Name="AutoFillQueuePanel" RowDefinitions="Auto,Auto,Auto" IsVisible="False">
                                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
                                                            <TextBlock Grid.Column="0" Name="AutoFillQueueSummaryText" Text="QUEUE" Foreground="{DynamicResource AppAccentBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize10}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Name="QueueMoveUpBtn" Classes="Secondary" Content="Up" MinWidth="54" FontSize="{DynamicResource AppFontSize10}" HorizontalContentAlignment="Center" ToolTip.Tip="Move the selected track up in the queue."/>
                                                            <Button Grid.Column="2" Name="QueueMoveDownBtn" Classes="Secondary" Content="Down" MinWidth="64" FontSize="{DynamicResource AppFontSize10}" HorizontalContentAlignment="Center" Margin="6,0,0,0" ToolTip.Tip="Move the selected track down in the queue."/>
                                                            <Button Grid.Column="3" Name="QueueRemoveBtn" Classes="Secondary" Content="Remove" MinWidth="74" FontSize="{DynamicResource AppFontSize10}" HorizontalContentAlignment="Center" Margin="6,0,0,0" ToolTip.Tip="Remove the selected track from the queue."/>
                                                        </Grid>
                                                        <ListBox Grid.Row="1" Name="AutoFillQueueList" MinHeight="96" MaxHeight="200" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="local:MusicQueueItem">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,2">
                                                                        <!-- ISSUE_11 (audit round 4): MinWidth (was fixed Width) per the Font-Scale Sizing Rule -->
                                                                        <TextBlock Grid.Column="0" Text="{CompiledBinding OrderText}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" MinWidth="32"/>
                                                                        <TextBlock Grid.Column="1" Text="{CompiledBinding Name}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="2" Text="{CompiledBinding DurationText}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" Margin="10,0,0,0"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <TextBlock Grid.Row="2" Name="AutoFillRemainingText" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" Margin="0,5,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <!-- STEP 3: Final Review Summary -->
                            <!-- LAYOUT_02: two columns now. Column 0 is the existing vertical stack (header,
                                 video, lanes); column 1 is the vertical MIX strip, sized to content so it takes
                                 only the width it needs. Row 3 is left in place but is now EMPTY — it collapses
                                 to zero height, which is exactly the space handed back to the video in row 1. -->
                            <Grid Name="Step3Panel" IsVisible="False" RowDefinitions="Auto, *, Auto, Auto" ColumnDefinitions="*, Auto" ClipToBounds="False">
                                <!-- ═══════════════════════════════════════════════════════════════════════
                                     LAYOUT_01 — THREE STACKED TEXT LINES COLLAPSED INTO ONE ROW.
                                     Phase 3's row heights are `Auto, *, Auto, Auto`, so the video is the ONLY
                                     elastic row — every pixel any other row takes comes straight out of the
                                     picture. This header used to be a 4-item StackPanel: a title, a permanent
                                     explanatory sentence, and a status line that is EMPTY almost always but
                                     still reserved its line height.
                                     Now one row: title + an ⓘ carrying the explanation on hover, and the status
                                     text only occupies space when it actually has something to say (its
                                     IsVisible is driven by the text being non-empty in code-behind).
                                     ⚠️ Phase3StatusLabel and ProblemFlagsPanel are still here and still found by
                                     name — only their arrangement changed. Do not remove them.
                                     ═══════════════════════════════════════════════════════════════════════ -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="CONFIRM MUSIC" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Name="FinalPlacementLabel" Text="ⓘ" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" VerticalAlignment="Center" Cursor="Help"
                                                   ToolTip.Tip="The video and music preview will end together at the video end."/>
                                        <TextBlock Name="Phase3StatusLabel" Text="" IsVisible="False" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize10}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Name="ProblemFlagsPanel" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" IsVisible="False">
                                        <TextBlock Name="ProblemFlagsText" Text="" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                    <Border Name="VideoHostBorder" Background="{DynamicResource AppVideoSurfaceBrush}" CornerRadius="6" ClipToBounds="True">
                                    </Border>

                                    <!-- DETACH_01: shared pop-out preview. The MpvVideoView is created in
                                         code-behind as VideoHostBorder's child, so the controller reparents
                                         it out of the Border and back into it. Own geometry key:
                                         MusicWizardPreviewMonitorBounds. -->
                                    <Border Name="WizardPreviewDetachedWatermark" IsVisible="False" ZIndex="65" Background="{DynamicResource AppVideoSurfaceBrush}" CornerRadius="6">
                                        <TextBlock Text="Preview Detached" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize36}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Name="WizardDetachPreviewBtn" Classes="Secondary" Content="◳ Detach Monitor"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Padding="8,4"
                                            FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold"
                                            Background="{DynamicResource AppOverlayBrush}" ZIndex="9999"
                                            ToolTip.Tip="Pop the preview out into its own floating window. It remembers its size, position and which screen you left it on."/>
                                    <Border Name="Phase3VideoLoadingOverlay" Background="{DynamicResource AppOverlayBrush}" CornerRadius="6" IsHitTestVisible="False" IsVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                            <!-- ISSUE_5: Min sizes (were fixed Width/Height) so the loading bar
                                                 scales with the font setting like the text beside it. -->
                                            <ProgressBar IsIndeterminate="True" MinWidth="100" MinHeight="4" Foreground="{DynamicResource AppAccentBrush}" Background="{DynamicResource AppPanelBrush}"/>
                                            <TextBlock Text="Initializing Video Preview..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- MEME_07: the preview plays each meme where it will actually
                                         appear by swapping the file in the one mpv host. That costs
                                         a black moment at each end, so it is announced. -->
                                    <Border Name="MemeSwapOverlay" IsVisible="False" ZIndex="900" Background="{DynamicResource AppScrimBrush}" CornerRadius="6">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                            <TextBlock Text="&#x1F921;" FontSize="{DynamicResource AppFontSize36}" HorizontalAlignment="Center"/>
                                            <ProgressBar IsIndeterminate="True" MinWidth="180" MinHeight="6" Foreground="{DynamicResource AppMemeBrush}" Background="{DynamicResource AppPanelBrush}"/>
                                            <TextBlock Name="MemeSwapOverlayText" Text="Loading the meme..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Please wait a moment." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- LANES_04 - phase 3 now uses the SAME shared TimelineLanesControl as the Granular
                                     editor, so it finally gets the numbered ruler, the gridlines, the grabbable
                                     caret with its time badge, and the elapsed/remaining clocks it never had.
                                     Its own 20px ruler drew 4px grey hairlines with `m\:ss` labels that could not
                                     show hours - see LANES_03.

                                     LANE ORDER IS INTENTIONALLY OPPOSITE TO GRANULAR: here LANE A (upper) is the
                                     film frames and LANE B (lower) is the waveform.

                                     The lane CONTENT below is still declared in XAML and merely REPARENTED into the
                                     shared control at construction. That keeps every existing FindControl in the
                                     code-behind working untouched - recreating 13 named controls in code would have
                                     been far more churn for no benefit. -->
                                <!-- ══════════════════════════════════════════════════════════════
                                     LAYOUT_03 — THE LANES REACH THE RIGHT EDGE OF THE WINDOW.

                                     The MIX slider column (Grid.Column="1") used to carry
                                     Grid.RowSpan="4", so it occupied this row as well and the ruler
                                     plus both 60px lanes stopped ~90px short of the window edge,
                                     jammed against a panel that has nothing to do with the
                                     timeline. The sliders are now confined to the video row
                                     (see the note on that Border) and this row spans both columns.
                                     ══════════════════════════════════════════════════════════════ -->
                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ZIndex="10" Margin="0,0,0,15" ClipToBounds="False">
                                    <controls:TimelineLanesControl Name="Phase3Lanes" ClipToBounds="False"/>

                                    <Panel Name="Phase3LaneContentHolder" IsVisible="False">
                                        <Panel Name="Phase3ThumbLaneContent">
                                            <Grid Name="ThumbnailLaneGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True"/>
                                            <Canvas Name="ThumbnailOverlayCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True"/>
                                            <Border Name="Phase3ThumbLoadingOverlay" Background="{DynamicResource AppOverlayBrush}" IsHitTestVisible="False" IsVisible="False">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <!-- ISSUE_5: Min sizes, see the loading bar above. -->
                                            <ProgressBar IsIndeterminate="True" MinWidth="60" MinHeight="3" Foreground="{DynamicResource AppWarningBrush}" Background="{DynamicResource AppPanelBrush}"/>
                                            <TextBlock Text="Generating Frames..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            </Border>
                                        </Panel>
                                        <Panel Name="Phase3WaveLaneContent">
                                            <Canvas Name="Phase3WaveformClip" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Image Name="WaveformLaneImage" Stretch="Fill" MinHeight="60" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <Canvas Name="WaveformOverlayCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True"/>
                                            </Canvas>
                                            <Border Name="Phase3WaveLoadingOverlay" Background="{DynamicResource AppOverlayBrush}" IsHitTestVisible="False" IsVisible="False">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                            <!-- ISSUE_5: Min sizes, see the loading bar above. -->
                                            <ProgressBar IsIndeterminate="True" MinWidth="60" MinHeight="3" Foreground="{DynamicResource AppSuccessBrush}" Background="{DynamicResource AppPanelBrush}"/>
                                            <TextBlock Text="Generating Waveform..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            </Border>
                                        </Panel>
                                    </Panel>
                                </Grid>

                                <!-- SLIDER_01 - ZIndex MUST STAY ABOVE THE LANES ROW.
                                     The knobs grow to scale(2.0) while held: a 44px thumb RENDERS 88px and
                                     overflows by 22px in every direction. This row was ZIndex="5" while the
                                     lanes Grid above it is ZIndex="10", so the lanes painted over the overflow
                                     and the knob looked sliced off. Do not lower it below the lanes row.

                                     SLIDER_02 - both sliders live in one framed "MIX LEVELS" card. The frame's
                                     horizontal Padding is what stops the knob being clipped at 0% and 100%: the
                                     dot centre sits 22px inside the slider, and at scale(2.0) the 52px dot reaches
                                     4px PAST the slider edge, so it needs real clearance to paint into. Do not
                                     reduce that padding below ~16.

                                     SLIDER_03 - they sit SIDE BY SIDE inside that card, not stacked. See the note
                                     on the inner Grid: this screen is short of vertical space and has horizontal
                                     space to spare. -->
                                <!-- SLIDER_01 - ZIndex MUST STAY ABOVE THE LANES ROW.
                                     The knobs grow to scale(2.0) while held and overflow their row vertically.
                                     This was ZIndex="5" while the lanes Grid above is ZIndex="10", so the lanes
                                     painted over the overflow and the knob looked sliced off at the top.

                                     SLIDER_05 - ONE ROW, NOT THREE. This screen is the tightest in the suite for
                                     vertical space (video preview + ruler + two 60px lanes + transport + nav all
                                     compete), so MIX LEVELS is now a SINGLE row: the frame caption sits inline on
                                     the left and each label sits inline beside its own slider. That removed the
                                     separate caption row and the separate label row - roughly 45px back.
                                     The labels are also short ("Video 100%" not "Video Volume: 100%") so they steal
                                     as little width as possible from the sliders. -->
                                <!-- ═══════════════════════════════════════════════════════════════════════
                                     LAYOUT_02 — THE MIX LEVELS ROW IS GONE. THE SLIDERS ARE NOW VERTICAL,
                                     IN A COLUMN TO THE RIGHT OF THE WHOLE PHASE.

                                     Phase 3 is starved of HEIGHT and has plenty of WIDTH. Two horizontal
                                     sliders in a framed card cost a full bottom row (~60px) purely to move
                                     two values that only need one dimension. Rotated 270 degrees they cost
                                     ~90px of width — which was going spare — and give that height back to
                                     the video, the only elastic row in the panel.

                                     ⚠️ THE SLIDERS ARE THE SAME CONTROLS WITH THE SAME NAMES. VideoVolSlider
                                     and MusicVolSlider are still found by FindControl, still 0-100, still
                                     wired to the same handlers. ONLY the orientation and position changed.
                                     ⚠️ ClipToBounds="False" IS LOAD-BEARING (SLIDER_02/04). The 52px thumb
                                     paints outside its own track at 0% and 100%; a clipping parent shears the
                                     knob off at the extremes. Do not "tidy" it away.
                                     ⚠️ The ducking toggle that used to sit beside these is now in Settings —
                                     see AUDIO_09.
                                     ═══════════════════════════════════════════════════════════════════════ -->
                                <!-- ══════════════════════════════════════════════════════════════
                                     LAYOUT_03 — ANCHORED TO THE VIDEO BOX, TOP AND BOTTOM.

                                     This was Grid.Row="0" Grid.RowSpan="4": it started level with
                                     the CONFIRM MUSIC heading (visibly taller than the picture it
                                     sits beside) and ran down through the lanes row, pushing the
                                     timeline off the right-hand side of the window.

                                     It is now Grid.Row="1" ONLY — the video preview's own row — so
                                     VerticalAlignment="Stretch" makes its top and bottom edges land
                                     exactly on the top and bottom of VideoHostBorder. The bottom
                                     margin matches that row's own Margin="0,0,0,10" so the two
                                     boxes end on the same line rather than the slider frame hanging
                                     10px lower.

                                     ⚠️ Do NOT restore a RowSpan here. The lanes row now spans both
                                     columns (LAYOUT_03) and would render underneath this panel.
                                     ══════════════════════════════════════════════════════════════ -->
                                <!-- ══════════════════════════════════════════════════════════════
                                     SLIDER_06 — TWO TRAYS IN ONE RACK, AND NARROW.

                                     The two faders shared a single open panel with 14px of air
                                     between them and nothing to say where one channel ended and the
                                     next began. Each now sits in its OWN inset compartment — a
                                     darker AppSurfaceBrush well inside the lighter AppPanelBrush
                                     rack — so the pair still reads as one MIX control while each
                                     channel is unmistakably its own slot.

                                     WIDTH. This column is pure overhead: every pixel it takes comes
                                     off the video preview beside it (LAYOUT_02). The old width was
                                     driven by the LABELS, not the sliders — "Video 100%" measures
                                     wider than the 44px fader it sat under, so the text set the
                                     column width and the fader wasted the rest. Split in two, the
                                     channel name moves to a caption ABOVE the fader and the value
                                     below is just the number, so nothing in the tray is wider than
                                     the fader itself. With the gap at 5px and the rack padding at
                                     5px the whole rack is roughly a quarter narrower than before.

                                     ⚠️ ClipToBounds="False" IS STILL LOAD-BEARING, on the trays as
                                     well as the rack (SLIDER_02/04). The thumb grows to scale(2.0)
                                     while held and paints outside its own track; a clipping tray
                                     would shear the knob off at the sides. Do not "tidy" it away,
                                     and do not give the trays ClipToBounds="True" to stop the
                                     overflow — the overflow is the press feedback.
                                     ══════════════════════════════════════════════════════════════ -->
                                <Border Grid.Row="1" Grid.Column="1" ZIndex="20"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                        Margin="6,0,0,10" Padding="3,5,3,5"
                                        Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="7" ClipToBounds="False">
                                    <!-- SLIDER_08: the spacer column is gone — the two trays now SHARE an
                                         edge. Their own 1px borders are what separates them, which is a
                                         cleaner read than a border, a gap and another border, and it is the
                                         last horizontal pixel available without touching the faders. -->
                                    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,Auto" ClipToBounds="False">

                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="MIX" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                                   FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold" Margin="0,0,0,5"/>

                                        <!-- VIDEO tray -->
                                        <Border Grid.Row="1" Grid.Column="0" VerticalAlignment="Stretch"
                                                Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="0,4,0,4" ClipToBounds="False" ZIndex="10"
                                                ToolTip.Tip="Volume of the original video audio">
                                            <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="False">
                                                <!-- SLIDER_08: the caption is spelled out again. It was abbreviated
                                                     under SLIDER_07 to keep it narrower than a 30px fader; the
                                                     fader is a CompactSlider now (~44px), so "VIDEO" fits inside
                                                     the width the slider already costs and abbreviating it buys
                                                     nothing. It is NOT clipped — it never was; it was short on
                                                     purpose, which read as clipping, which is its own kind of bug. -->
                                                <TextBlock Grid.Row="0" Text="VIDEO" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                                           FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold"
                                                           Margin="0,0,0,2" ClipToBounds="False" IsHitTestVisible="False"/>
                                                <TextBlock Grid.Row="2" Name="VideoVolLabel" Text="100%"
                                                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                           FontSize="{DynamicResource AppFontSize9}" IsHitTestVisible="False"/>

                                                <!-- ══════════════════════════════════════════════════════
                                                     SLIDER_09 — PAINT ORDER IS DECLARATION ORDER. ZIndex WAS
                                                     THE WRONG LEVER.
                                                     The knob grows past the ends of its own track at 0% and
                                                     100%, into the rows the caption and the value occupy. A
                                                     high ZIndex on the Slider did NOT lift it above them: it
                                                     stayed declared BETWEEN the two TextBlocks, and the one
                                                     after it kept painting over the overflow.
                                                     The reliable rule among siblings of one panel is the
                                                     order they are WRITTEN, so the Slider is now the LAST
                                                     child of this Grid while keeping Grid.Row="1" — its
                                                     LAYOUT slot is unchanged, only its place in the paint
                                                     sequence moved. ZIndex stays as agreement, not as the
                                                     mechanism.
                                                     The labels are also IsHitTestVisible="False": their
                                                     layout slots are real rectangles that would otherwise
                                                     swallow a press aimed at the knob where it overlaps them.
                                                     ⚠️ KEEP THE SLIDER LAST. Moving it back above either
                                                     TextBlock re-breaks this, silently and invisibly in code.
                                                     ══════════════════════════════════════════════════════ -->
                                                <!-- SLIDER_07: NO Width, NO MinWidth. A vertical Slider must be
                                                     left to size itself to its own track — anything wider puts
                                                     the rail against one edge and slices the knob in half (the
                                                     fault this replaced). CompactSlider is the suite's narrow
                                                     thumb and its own note names vertical volume as its case. -->
                                                <Slider Grid.Row="1" Name="VideoVolSlider" Classes="CompactSlider" Orientation="Vertical"
                                                        Minimum="0" Maximum="100" Value="100"
                                                        VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                                        MinHeight="110" ZIndex="9999"
                                                        ClipToBounds="False" IsSnapToTickEnabled="False" TickFrequency="1"
                                                        ToolTip.Tip="Volume of the original video audio"/>
                                            </Grid>
                                        </Border>

                                        <!-- MUSIC tray -->
                                        <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Stretch"
                                                Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="0,4,0,4" ClipToBounds="False" ZIndex="10"
                                                ToolTip.Tip="Volume of the background music">
                                            <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="False">
                                                <!-- SLIDER_08: the caption is spelled out again. It was abbreviated
                                                     under SLIDER_07 to keep it narrower than a 30px fader; the
                                                     fader is a CompactSlider now (~44px), so "MUSIC" fits inside
                                                     the width the slider already costs and abbreviating it buys
                                                     nothing. It is NOT clipped — it never was; it was short on
                                                     purpose, which read as clipping, which is its own kind of bug. -->
                                                <TextBlock Grid.Row="0" Text="MUSIC" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                                           FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold"
                                                           Margin="0,0,0,2" ClipToBounds="False" IsHitTestVisible="False"/>
                                                <TextBlock Grid.Row="2" Name="MusicVolLabel" Text="100%"
                                                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                           FontSize="{DynamicResource AppFontSize9}" IsHitTestVisible="False"/>

                                                <!-- ══════════════════════════════════════════════════════
                                                     SLIDER_09 — PAINT ORDER IS DECLARATION ORDER. ZIndex WAS
                                                     THE WRONG LEVER.
                                                     The knob grows past the ends of its own track at 0% and
                                                     100%, into the rows the caption and the value occupy. A
                                                     high ZIndex on the Slider did NOT lift it above them: it
                                                     stayed declared BETWEEN the two TextBlocks, and the one
                                                     after it kept painting over the overflow.
                                                     The reliable rule among siblings of one panel is the
                                                     order they are WRITTEN, so the Slider is now the LAST
                                                     child of this Grid while keeping Grid.Row="1" — its
                                                     LAYOUT slot is unchanged, only its place in the paint
                                                     sequence moved. ZIndex stays as agreement, not as the
                                                     mechanism.
                                                     The labels are also IsHitTestVisible="False": their
                                                     layout slots are real rectangles that would otherwise
                                                     swallow a press aimed at the knob where it overlaps them.
                                                     ⚠️ KEEP THE SLIDER LAST. Moving it back above either
                                                     TextBlock re-breaks this, silently and invisibly in code.
                                                     ══════════════════════════════════════════════════════ -->
                                                <!-- SLIDER_07: NO Width, NO MinWidth. A vertical Slider must be
                                                     left to size itself to its own track — anything wider puts
                                                     the rail against one edge and slices the knob in half (the
                                                     fault this replaced). CompactSlider is the suite's narrow
                                                     thumb and its own note names vertical volume as its case. -->
                                                <Slider Grid.Row="1" Name="MusicVolSlider" Classes="CompactSlider" Orientation="Vertical"
                                                        Minimum="0" Maximum="100" Value="100"
                                                        VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                                        MinHeight="110" ZIndex="9999"
                                                        ClipToBounds="False" IsSnapToTickEnabled="False" TickFrequency="1"
                                                        ToolTip.Tip="Volume of the background music"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                        </Panel>
                    </Border>

                    <!-- Navigation -->
                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- ISSUE_05: MinWidth (not Width) so scaled fonts never clip nav button labels -->
                        <!-- ISSUE_03 (audit round 5): the previous comment here claimed "CANCEL is
                             Secondary suite-wide" while the button below is Danger — a copy-paste of
                             SettingsWindow's note that never matched this file. The suite actually has
                             TWO cancel tiers and this button is correctly in the second one:
                               TIER 1 — Secondary (grey): CANCEL closes a screen and destroys nothing.
                                        SettingsWindow.axaml CancelBtn, VoiceOverWindow.axaml CancelButton.
                                        No confirm flyout.
                               TIER 2 — Danger (red) + confirm Flyout: CANCEL discards unsaved session
                                        work. MainWindow CancelButton (kills a running export),
                                        GranularSpeedEditorWindow CancelGranularBtn (discards segments),
                                        and THIS button (discards the whole music selection/mix).
                             Red therefore still means "data loss", which is the rule the old comment was
                             reaching for. Do not demote this to Secondary without also removing the
                             flyout — that would make it inconsistent with its real peer, Granular. -->
                        <Button Grid.Column="0" Name="CancelBtn" Content="CANCEL" Classes="Danger" MinWidth="90" HorizontalContentAlignment="Center" ToolTip.Tip="Cancel and close the wizard without saving">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Spacing="8" Margin="8">
                                        <TextBlock Text="⚠️ Cannot be undone" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" />
                                        <Button Name="ConfirmCancelBtn" Classes="Danger" Content="CONFIRM CANCEL" HorizontalAlignment="Stretch" ToolTip.Tip="Permanently cancel and close the wizard." />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button Name="SkipBackBtn" Classes="Secondary" MinWidth="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Skip back 30 seconds" AutomationProperties.Name="Skip back 30 seconds">
                                <TextBlock Text="-30s" FontWeight="Bold" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            </Button>
                            <!-- ISSUE_08: transport Play is Primary (blue) so it reads distinctly from the
                                 green "NEXT" progression button sharing this nav pane. -->
                            <Button Name="PlayBtn" Classes="Primary" MinWidth="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Preview how the music sounds">
                                <Panel Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}">
                                    <Path Name="PlayIcon" Data="{DynamicResource AppPlayIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform"/>
                                    <Path Name="PauseIcon" IsVisible="False" Data="{DynamicResource AppPauseIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform"/>
                                </Panel>
                            </Button>
                            <Button Name="SkipForwardBtn" Classes="Secondary" MinWidth="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Skip forward 30 seconds" AutomationProperties.Name="Skip forward 30 seconds">
                                <TextBlock Text="+30s" FontWeight="Bold" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="2" Name="BackBtn" Content="BACK" Classes="Secondary" MinWidth="90" HorizontalContentAlignment="Center" Margin="0,0,10,0" IsEnabled="False" IsVisible="True" ToolTip.Tip="Go back to the previous step"/>
                        <Button Grid.Column="3" Name="NextBtn" Content="NEXT" Classes="Success" MinWidth="90" HorizontalContentAlignment="Center" ToolTip.Tip="Proceed to the next step"/>
                    </Grid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
