<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FreeVideoStudio.App"
        xmlns:controls="clr-namespace:FreeVideoStudio.App.Controls"
        xmlns:vm="clr-namespace:FreeVideoStudio.App.ViewModels"
        x:Class="FreeVideoStudio.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Free Video Studio"
        Background="{DynamicResource AppSurfaceBrush}"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        DragDrop.AllowDrop="True">

    <!-- IDEA_01: gentle pulse for the hero drop icon (finite-cost, opacity-only) -->
    <Window.Styles>
        <Style Selector="Border.DropIconPulse">
            <Style.Animations>
                <Animation Duration="0:0:2.4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.6"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.6"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, Auto, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" TextTrimming="CharacterEllipsis" />
                </Border>
                <Menu Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextMutedBrush}" Padding="10,0" FontSize="{DynamicResource AppFontSize12}">
                    <MenuItem Header="_File">
                        <MenuItem Name="MenuUploadVideo" Header="Upload Video..." ToolTip.Tip="Upload an MP4 or MKV video file from your computer to start editing." />
                        <Separator />
                        <!-- FILEBACKUP_01 — both open Settings › General and run its Backup / Import. -->
                        <MenuItem Name="MenuExportConfig" Header="Backup Settings..." ToolTip.Tip="Save all your settings to one file, for example to move them to a new computer. Your AI keys are left out on purpose." />
                        <MenuItem Name="MenuImportConfig" Header="Restore Settings..." ToolTip.Tip="Load your settings from a backup file. You can look them over first: nothing changes until you press SAVE." />
                        <Separator />
                        <MenuItem Name="MenuSettingsBtn" Header="_Settings" ToolTip.Tip="Open the settings menu to tweak how the application works." />
                        <MenuItem Name="MenuAboutBtn" Header="_About" ToolTip.Tip="View application version, system details, and check for updates." />
                        <Separator />
                        <MenuItem Name="MenuExit" Header="E_xit" ToolTip.Tip="Close the application." />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Name="MenuCropSettings" Header="Crop Settings" ToolTip.Tip="Choose how you want to crop or resize your videos. This opens in place of the editor, so this window closes — your edits are saved first and come straight back." />
                        <MenuItem Name="MenuVideoMerger" Header="Video Merger" ToolTip.Tip="Open a tool that lets you combine multiple videos into one. This opens in place of the editor, so this window closes — your edits are saved first and come straight back." />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Name="MenuTogglePreviewMonitor" Header="Detach Preview Monitor" ToolTip.Tip="Pop out the video player into its own separate floating window so you can move it around." />
                        <Separator />
                        <!-- ISSUE_05: the "?" key alone was not a discoverable way in, and on keyboard
                             layouts where ? is not on the OemQuestion key it does not fire at all.
                             This menu item is the guaranteed route. Do not remove it in favour of the
                             shortcut. -->
                        <!-- ⚠️ NO `InputGesture` HERE, EVER. Avalonia parses that attribute with
                             `KeyGesture.Parse`, which resolves the key name through `Enum.Parse<Key>`.
                             "?" is not a member of the Key enum, so `InputGesture="?"` throws
                             `ArgumentException: Requested value '?' was not found.` at XAML load —
                             AFTER a clean build, so it presents as the app exiting with code 1 on
                             startup rather than as a compile error. The hint lives in the header
                             text instead. If you ever do want a real gesture here it must be a
                             parseable name such as "OemQuestion" or "Ctrl+K". -->
                        <MenuItem Name="MenuShowShortcuts" Header="Keyboard Shortcuts    ?" ToolTip.Tip="Show every keyboard shortcut, using your own key choices. Shortcut: press ?" />
                        <MenuItem Name="MenuShowHelp" Header="Show Me Around" ToolTip.Tip="Replay the short walkthrough that points out what everything on this screen does." />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Name="MenuHelpShortcuts" Header="Keyboard Shortcuts    ?" ToolTip.Tip="Show every keyboard shortcut, using your own key choices. Shortcut: press ?" />
                        <MenuItem Name="MenuHelpTour" Header="Show Me Around" ToolTip.Tip="Replay the short walkthrough that points out what everything on this screen does." />
                        <Separator />
                        <MenuItem Name="MenuCheckUpdates" Header="Check for Updates..." ToolTip.Tip="Check GitHub for newer versions of Free Video Studio." />
                        <MenuItem Name="MenuHelpAbout" Header="_About Free Video Studio" ToolTip.Tip="View application version, system runtime, GPU acceleration and update settings." />
                    </MenuItem>
                </Menu>
                <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
        <!-- Ambient live-wallpaper bubbles (very gentle, non-interactive, behind all content).
             Echoes the FluidVolumeSlider bubble aesthetic across the theme background. -->
        <controls:AmbientBubblesBackground Grid.ColumnSpan="2" IsHitTestVisible="False" ZIndex="-1" />
        <!-- LEFT COLUMN: Player & Editing Controls -->
        <Grid Grid.Column="0" RowDefinitions="*, Auto" ColumnDefinitions="*,Auto" ClipToBounds="False">

            <!-- Video Player Area with overlaid timeline.
                 Right margin removed so the volume frame sits flush against the right pane (no gap). -->
                <Grid Name="MainVideoGrid" Grid.Column="0" Background="{DynamicResource AppVideoSurfaceBrush}" ClipToBounds="True" Cursor="Hand" Margin="10,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- IDEA_03: duplicate PlaceholderBubbles layer removed — the window-wide
                         AmbientBubblesBackground already animates behind this area; two overlapping
                         densities read as a rendering glitch. -->
                    <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Name="MainContainerGrid" Width="1920" Height="1080">
                            <Grid Width="1920" Height="1080" VerticalAlignment="Center">
                                <local:MpvVideoView Name="VideoHost" IsVisible="False" controls:Tactile.IsParallaxTiltEnabled="True" />
                            </Grid>
                            <controls:PhoneFrameMockup Name="PhoneFrame" IsVisible="False" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>

                    <TextBlock Name="RdpWarningOverlay" Text="RDP SESSION" Foreground="{DynamicResource AppDangerBrush}" Opacity="0.5" FontSize="{DynamicResource AppFontSize60}" FontWeight="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" IsHitTestVisible="False" IsVisible="False" ZIndex="1" />

                    <Border Name="PreviewFallbackBadge" IsVisible="False"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                            Background="{DynamicResource AppOverlayBrush}" CornerRadius="4" Padding="6"
                            ToolTip.Tip="Live preview could not initialize on this graphics session.">
                        <TextBlock Text="⚠️" FontSize="{DynamicResource AppFontSize16}" Foreground="{DynamicResource AppWarningBrush}" />
                    </Border>

                    <Border Name="PreviewDetachedWatermark" IsVisible="False" Background="{DynamicResource AppVideoSurfaceBrush}" Grid.Row="0">
                        <TextBlock Text="Preview Detached" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize36}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- MEME_07: the preview plays each meme where it will actually appear by
                         swapping the file in the one mpv host. That costs a black moment at each
                         end of the meme, so it is announced instead of looking like a stutter. -->
                    <Border Name="MemeSwapOverlay" IsVisible="False" Grid.RowSpan="2" ZIndex="900" Background="{DynamicResource AppScrimBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <TextBlock Text="&#x1F921;" FontSize="{DynamicResource AppFontSize36}" HorizontalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" MinWidth="180" MinHeight="6" Foreground="{DynamicResource AppMemeBrush}" Background="{DynamicResource AppPanelBrush}"/>
                            <TextBlock Name="MemeSwapOverlayText" Text="Loading the meme..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Please wait a moment." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- IDEA_01: single consolidated hero empty-state (BlankStateOverlay merged in).
                         IDEA_04: Opacity transition lets the card fade while the drag-over dropzone speaks.
                         IDEA_05: supported-formats hint. IDEA_07: unified "UPLOAD VIDEO" verb. -->
                    <Border Name="UploadOverlay" Background="{DynamicResource AppPanelBrush}" Opacity="0.95" CornerRadius="6" Grid.RowSpan="2">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                            </Transitions>
                        </Border.Transitions>
                        <Grid Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="2" StrokeDashArray="6,4" RadiusX="8" RadiusY="8" Fill="{DynamicResource AppSurfaceBrush}" Opacity="0.8" IsHitTestVisible="False" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="60,36">
                                <Border Classes="DropIconPulse" MinWidth="88" MinHeight="88" CornerRadius="44"
                                        Background="{DynamicResource AppAccentAlpha20Brush}"
                                        BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2"
                                        HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="⬇" FontSize="{DynamicResource AppFontSize36}" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Drag &amp; drop your gameplay video here" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize18}" FontWeight="SemiBold" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                <TextBlock Text="or" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                <Button Name="CenterUploadButton" Classes="Primary" Content="UPLOAD VIDEO" HorizontalAlignment="Center" ToolTip.Tip="Click here to browse your computer and upload a video file to start editing." Padding="20,10" />
                                <TextBlock Text="MP4 · MKV · AVI · MOV" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,10,0,0" IsHitTestVisible="False">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="✂️" FontSize="{DynamicResource AppFontSize24}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Trim" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="⚡" FontSize="{DynamicResource AppFontSize24}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Speed" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="🎵" FontSize="{DynamicResource AppFontSize24}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Music" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="📱" FontSize="{DynamicResource AppFontSize24}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Portrait" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Name="TimelineOverlay" IsVisible="False" Grid.Row="1" Background="{DynamicResource AppOverlayBrush}" Padding="8,4,8,3" ZIndex="9999" Cursor="Hand" ClipToBounds="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ClipToBounds="False">
                            <!-- ISSUE_05: MinWidth (not Width) so scaled fonts never clip the clock.
                                 ISSUE_06: slider row is 44 (was 32) so the 44px CompactSlider fits without bleeding into the tick ruler. -->
                            <TextBlock Name="TimeElapsed" Text="00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" MinWidth="64" FontSize="{DynamicResource AppFontSize10}" Margin="0,0,8,0" />
                            <Grid Grid.Column="1" VerticalAlignment="Center" RowDefinitions="Auto, Auto" ClipToBounds="False">
                                <Canvas Grid.Row="0" Name="TimelineScaleCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" MinHeight="14" />
                                <Slider Grid.Row="1" Name="TimelineSlider" Classes="CompactSlider" Minimum="0" Maximum="100" MinHeight="44" VerticalAlignment="Center" ClipToBounds="False" ToolTip.Tip="Drag this left or right to quickly skip through different parts of the video." AutomationProperties.Name="Main video timeline scrub slider" />
                                <!-- ISSUE_05: IsTabStop was False, so this Focusable canvas could never be
                                     reached by Tab and its TimelineSeekSurface :focus / :focus-visible styles
                                     could never fire — the Main App was the ONLY app in the suite whose
                                     timeline was unreachable by keyboard (Merger, CropTool and Granular all
                                     ship IsTabStop="True" on the same control). -->
                                <Canvas Grid.Row="1" Name="TimelineMarkersCanvas" Classes="TimelineSeekSurface" Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabNavigation="Continue" IsHitTestVisible="True" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" MinHeight="32" Cursor="Hand" AutomationProperties.Name="Main video timeline seek area">
                                    <Border Name="PlayheadBadge" Background="{DynamicResource AppOverlayBrush}" CornerRadius="4" Padding="4,2" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" Canvas.Bottom="32">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <TextBlock Name="PlayheadBadgeText" Text="00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                            <TextBlock Grid.Column="2" Name="TimeRemaining" Text="-00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" MinWidth="64" TextAlignment="Right" FontSize="{DynamicResource AppFontSize10}" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                    <!-- ══════════════════════════════════════════════════════════════════════
                         ISSUE_09 — THE FEEDBACK POPUP LIVED HERE AND HAS BEEN REMOVED.
                         It was a Popup + Border + TextBlock trio driven by FloatingFeedback.Show,
                         and it was the ONLY nice notification in the whole suite precisely because
                         it took three named XAML controls and an OS-level popup window to build —
                         no other screen could reuse it, so five other screens each invented their
                         own status line or hand-rolled toast instead.
                         The same visual now comes from Controls/FloatingNotice.cs, which draws into
                         OverlayCanvas further down this file and works in every window with no XAML.
                         ⚠️ DO NOT re-add a per-window feedback Popup. That duplication is the bug.
                         ══════════════════════════════════════════════════════════════════════ -->

                    <!-- IDEA_02: hidden until a video loads (pre-upload it silently no-ops and floats over the hero card) -->
                    <Button Name="DetachOverlayButton"
                            IsVisible="False"
                            Classes="Secondary"
                            Content="◳ Detach Monitor"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10,10,0,0"
                            Padding="8,4"
                            FontSize="{DynamicResource AppFontSize12}"
                            FontWeight="Bold"
                            Background="{DynamicResource AppOverlayBrush}"
                            ZIndex="9999" ToolTip.Tip="Pop out the video player into its own separate floating window so you can move it around." />
                </Grid>

                <Border Grid.Column="1" CornerRadius="4" Background="{DynamicResource AppVideoRailBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="0,8" VerticalAlignment="Stretch" Margin="2,10,2,10" ClipToBounds="False" ZIndex="9999">
                    <Grid RowDefinitions="Auto, *, Auto" ClipToBounds="False" HorizontalAlignment="Center" Margin="0">
                        <!-- The numeric readout now appears on hover/drag and fades out again. It was previously
                             IsVisible="False" and never switched on, so the code-behind was updating the text of a
                             permanently invisible control and the only way to read the level was to eyeball the
                             fluid height. Bound to the slider's own IsInteracting so both windows share one
                             source of truth instead of duplicating hover bookkeeping in two code-behinds. -->
                        <TextBlock Grid.Row="0" Name="VolumeBadgeText" Text="100%" Foreground="{DynamicResource AppInfoBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" IsHitTestVisible="False" Opacity="{Binding #VolumeSlider.IsInteracting, Converter={x:Static local:BoolToOpacityConverter.Instance}}">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                                </Transitions>
                            </TextBlock.Transitions>
                        </TextBlock>
                        <!-- Custom fluid "test tube" volume slider (see Controls/FluidVolumeSlider.cs).
                             Rollback: swap for a standard vertical Slider with the same Name/bindings (rollback folder no longer exists). -->
                        <controls:FluidVolumeSlider Grid.Row="1" Name="VolumeSlider" Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding MainVolume, Mode=TwoWay}" MinWidth="57" HorizontalAlignment="Center" VerticalAlignment="Stretch" MinHeight="140" Background="Transparent" Margin="0,0,0,0" ToolTip.Tip="Slide up or down to make the video louder or quieter." Cursor="Hand" ClipToBounds="False" ZIndex="10000" Foreground="{DynamicResource AppInfoBrush}" />
                        <Button Grid.Row="2" Name="SpeakerHitBox" Classes="Secondary" MinWidth="44" MinHeight="44" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" ZIndex="10001" Focusable="True" ToolTip.Tip="Click here to quickly mute or unmute the video." AutomationProperties.Name="Mute or restore volume" ClipToBounds="False">
                            <Path Name="VolumeSpeakerIcon" Fill="Transparent" Stroke="{DynamicResource AppInfoBrush}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="{DynamicResource AppFontSize20}" Height="{DynamicResource AppFontSize20}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Data="{DynamicResource AppSpeakerIconGeometry}" />
                        </Button>
                    </Grid>
                </Border>

            <!-- Combined Trim and Process Controls Grid -->
            <Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto" Margin="10,8,10,8">
                <!-- Upper Row -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Button Name="SetThumbnailButton" Classes="Secondary" Padding="16,8" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False" ToolTip.Tip="Save the exact frame you are looking at right now to be the cover image for your video.">
                        <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize18}" Height="{DynamicResource AppFontSize18}" Stretch="Uniform" VerticalAlignment="Center" Data="{DynamicResource AppImageIconGeometry}" />
                            <TextBlock Name="SetThumbnailText" Text=" SET THUMBNAIL " FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center" Margin="6,0,6,0" />
                            <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize18}" Height="{DynamicResource AppFontSize18}" Stretch="Uniform" VerticalAlignment="Center" Data="{DynamicResource AppImageIconGeometry}" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Name="MarkStartButton" Classes="Secondary" Focusable="True" Content="MARK START" Padding="16,8" Margin="0,0,30,0" IsEnabled="False" ToolTip.Tip="Cut out everything before this point. The final video will start exactly here."/>
                        <Button Name="PlayPauseButton" Classes="Primary" Padding="16,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="False" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Play or pause the video." Margin="0,0,30,0">
                            <Panel Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}">
                                <Path Name="PlayIcon" Data="{DynamicResource AppPlayIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform" />
                                <Path Name="PauseIcon" IsVisible="False" Data="{DynamicResource AppPauseIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform" />
                            </Panel>
                        </Button>
                        <Button Name="MarkEndButton" Classes="Secondary" Focusable="True" Content="MARK END" Padding="16,8" IsEnabled="False" ToolTip.Tip="Cut out everything after this point. The final video will end exactly here."/>
                    </StackPanel>

                    <!-- CUT_02: cuts moved into the Granular Speed Editor (DELETE PARTS, under
                         ZOOM-IN). This screen still DISPLAYS them as markers on the timeline and
                         still carries them through save/recovery and export — it just no longer
                         creates them. -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Name="GranularButton" Classes="Secondary" Content="GRANULAR SPEED" Padding="16,8" IsEnabled="False" ToolTip.Tip="Change the speed of specific parts of your video."/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Button Name="VoiceOverButton" Classes="VoiceOverEntry" Padding="16,8" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False" ToolTip.Tip="Record your own voice over the video.">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="{DynamicResource AppOnAccentTextBrush}" Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}" Stretch="Uniform" VerticalAlignment="Center" Data="{DynamicResource AppVoiceOverIconGeometry}"/>
                            <TextBlock Name="VoiceOverText" Text="VOICE OVER" FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- SIZEESTIMATE_01 — estimated output file size to the left of VIDEO QUALITY -->
                        <StackPanel Name="EstimatedSizePanel" IsVisible="{Binding IsVisible, ElementName=QualityPanel}" Orientation="Vertical" Spacing="2" Margin="0,0,20,8" MinWidth="130" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding Export.EstimatedFileSizeDescription}">
                            <TextBlock Text="ESTIMATED FILE SIZE" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False" />
                            <TextBlock Name="QualityLabel" Text="{Binding Export.EstimatedFileSizeText}" Foreground="{DynamicResource AppInfoBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" HorizontalAlignment="Center" IsHitTestVisible="False" />
                        </StackPanel>

                        <StackPanel Name="QualityPanel" IsVisible="False" Orientation="Vertical" Spacing="2" Margin="0,0,20,8" VerticalAlignment="Center">
                            <!-- QUALITY_01: the heading names what the dial ASKS FOR. It said "OUTPUT FILE SIZE"
                                 because the dial used to be a size; it is a quality choice now, and the
                                 size appears to the left as the consequence. -->
                            <TextBlock Text="VIDEO QUALITY" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"
                                       ToolTip.Tip="How good you want the finished video to look. Pick it once and leave it — the app works out the file size for you." />
                            <controls:SpinningWheelSlider Name="QualitySlider" Value="{Binding QualitySliderValue, Mode=TwoWay}" Width="160" MinHeight="44" Cursor="Hand" ToolTip.Tip="Pick how good the finished video should look. The estimated file size appears to the left." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,20,8">
                            <!-- Issue #13: Normalize to 42px standard -->
                            <!-- ISSUE_35: CANCEL and PROCESS were the same size and shape, separated only by hue, which
                         leaves colour-blind users nothing to go on at the moment a wrong click throws away
                         a long encode. CANCEL is now visibly the narrower, squarer, secondary shape. -->
                    <Button Name="CancelButton" Classes="Danger" Content="CANCEL" CornerRadius="4" IsVisible="False" ToolTip.Tip="Stop what you are doing right now and cancel it." Padding="20,10">
                                <!-- ISSUE_12: matched to the Speed Editor's dialog — larger, plain English,
                                     an explicit escape button, and skippable via Settings > Confirmation
                                     Dialogs (ConfirmMainAppCancel). The outer CANCEL button acts ONLY when
                                     that setting is off; otherwise this flyout is the only path out. -->
                                <Button.Flyout>
                                    <Flyout Placement="Top" FlyoutPresenterClasses="CustomFlyout">
                                        <StackPanel Spacing="14" Margin="22" MinWidth="380" MaxWidth="440">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="✖" FontSize="{DynamicResource AppFontSize28}" VerticalAlignment="Center" Foreground="{DynamicResource AppDangerBrush}"/>
                                                <TextBlock Text="Close the app?" FontSize="{DynamicResource AppFontSize18}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="This stops what you are doing and closes the whole application." FontSize="{DynamicResource AppFontSize13}" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>
                                            <Border Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <TextBlock Text="⚠️ Your edits are saved and restored next time you open the editor — but anything still running right now is stopped." Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </Border>
                                            <Grid ColumnDefinitions="*,12,*">
                                                <Button Grid.Column="0" Name="KeepWorkingButton" Classes="Secondary" Content="KEEP WORKING" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Close this box and carry on."/>
                                                <Button Grid.Column="2" Name="ConfirmCancelButton" Classes="Danger" Content="CLOSE APP" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Permanently stop what you are doing right now." />
                                            </Grid>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Name="ProcessButton" Classes="Success" Content="PROCESS" CornerRadius="10" IsEnabled="False" ToolTip.Tip="Save and export your final edited video." Padding="20,10"/>
                        </StackPanel>

                        <Grid Name="SpeedPanel" IsVisible="False" VerticalAlignment="Center" Margin="0,0,0,8" ColumnDefinitions="Auto,8,Auto">
                            <!-- Slider Column -->
                            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="SPEED" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,2" />
                                <controls:SpinningWheelSlider Name="MainSpeedSlider" Value="{Binding MainSpeedSliderValue, Mode=TwoWay}" Width="160" MinHeight="44" Cursor="Hand" ToolTip.Tip="Slide left to make the video slow motion, or right to speed it up." />
                                <TextBlock Name="MainSpeedLabel" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            
                            <!-- Presets Column -->
                            <Grid Grid.Column="2" Name="MainSpeedPresetsPanel" RowDefinitions="Auto,8,Auto" ColumnDefinitions="Auto,8,Auto,8,Auto" VerticalAlignment="Center">
                                <Button Grid.Row="0" Grid.Column="0" Name="SpeedPreset01" Classes="SpeedPreset" Content="0.1x" ToolTip.Tip="Set speed to 0.1x"/>
                                <Button Grid.Row="0" Grid.Column="2" Name="SpeedPreset10" Classes="SpeedPreset" Content="1.0x" ToolTip.Tip="Set speed to normal (1.0x)"/>
                                <Button Grid.Row="0" Grid.Column="4" Name="SpeedPresetBase" Classes="SpeedPreset BaseSpeedPreset" Content="1.1x" ToolTip.Tip="Set speed to 1.1x"/>
                                
                                <Button Grid.Row="2" Grid.Column="0" Name="SpeedPreset20" Classes="SpeedPreset" Content="2.0x" ToolTip.Tip="Set speed to 2.0x"/>
                                <Button Grid.Row="2" Grid.Column="2" Name="SpeedPreset30" Classes="SpeedPreset" Content="3.0x" ToolTip.Tip="Set speed to 3.0x"/>
                                <Button Grid.Row="2" Grid.Column="4" Name="SpeedPreset40" Classes="SpeedPreset" Content="4.0x" ToolTip.Tip="Set speed to 4.0x"/>
                            </Grid>
                        </Grid>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- RIGHT PANEL: Utility & Plugins -->
        <Border Grid.Column="1" MinWidth="170" MaxWidth="300" Background="Transparent" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0" Padding="15">
            <Grid RowDefinitions="*, Auto">
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <Grid RowDefinitions="Auto, Auto">
                    <!-- Row 0: File Ops -->
                    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,15">
                        <TextBlock Text="FILE OPERATIONS" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold"/>
                        <Button Name="UploadButton" Classes="Primary" Content="UPLOAD VIDEO" HorizontalAlignment="Stretch" ToolTip.Tip="Click here to browse your computer and upload a video file to start editing."/>
                        <Button Name="AddMusicButton" Classes="Secondary" HorizontalAlignment="Stretch" IsEnabled="False" ToolTip.Tip="Add a background song to play over your video.">
                            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- ISSUE_06 (audit round 4): icons sized by AppFontSize14 token (were fixed 14px) so they scale with the label -->
                                <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize14}" Height="{DynamicResource AppFontSize14}" Stretch="Uniform" VerticalAlignment="Center" Data="{DynamicResource AppMusicNoteIconGeometry}" />
                                <TextBlock Name="AddMusicText" Text=" ADD MUSIC " FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,6,0" />
                                <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize14}" Height="{DynamicResource AppFontSize14}" Stretch="Uniform" VerticalAlignment="Center" Data="{DynamicResource AppMusicNoteIconGeometry}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                            <TextBlock Name="HardwareStatusLabel" Text="HW: Scanning..." Foreground="{DynamicResource AppSuccessBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button Name="RdpWarningButton" IsVisible="False" Background="Transparent" Padding="4" MinWidth="44" MinHeight="44" Cursor="Hand" ToolTip.Tip="Click for details" AutomationProperties.Name="RDP Session Warning">
                                <Path Fill="{DynamicResource AppDangerBrush}" Width="{DynamicResource AppFontSize14}" Height="{DynamicResource AppFontSize14}" Stretch="Uniform" VerticalAlignment="Center" Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"/>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel Spacing="10" MaxWidth="300">
                                            <TextBlock Text="RDP SESSION DETECTED: YOUR GRAPHICS CARD IS ASLEEP!" FontWeight="Bold" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="You are connected via Remote Desktop. Windows turns off your GPU during Remote Desktop to save data, making this app extremely slow." TextWrapping="Wrap"/>
                                            <TextBlock Text="HOW TO FIX THIS (On the HOST machine):" FontWeight="Bold"/>
                                            <TextBlock Text="1. Click Start, type 'gpedit.msc' and hit Enter.&#x0a;2. Go to: Computer Configuration -> Administrative Templates -> Windows Components -> Remote Desktop Services -> Remote Desktop Session Host -> Remote Session Environment.&#x0a;3. Double-click 'Use hardware graphics adapters for all Remote Desktop Services sessions'. Set to 'Enabled'.&#x0a;4. Double-click 'Prioritize H.264/AVC 444 Graphics mode for Remote Desktop connections'. Set to 'Enabled'.&#x0a;5. Restart the computer." TextWrapping="Wrap"/>
                                            <Button Name="RdpFixButton" Classes="Danger" Content="Auto-Fix: Enable GPU Policy (Requires Admin)" HorizontalAlignment="Stretch" FontWeight="Bold" ToolTip.Tip="Requires Administrator privileges to modify registry" Click="RdpFixButton_Click" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Row 1: Overlays -->
                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,0">
                        <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,0,0,5"/>
                        
                            <!-- SPACING_01: (A) the OUTER stack separates the three bands, so its
                                 Spacing is what puts air around each gentle separator line — raised
                                 10 -> 18. (B) each band's INNER Spacing is lowered separately below
                                 (4 -> 2), so rows like Teammate HP / Spectating Eye sit
                                 tighter together while the groups themselves breathe more.
                                 These two numbers pull in opposite directions on purpose; changing
                                 only one of them undoes the effect. -->
                            <StackPanel Spacing="18" Margin="0,8,0,0">
                                
                                <StackPanel Spacing="2">
                                    <TextBlock Text="LAYOUTS" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3"/>   <!-- SPACING_01: centred + bold -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="Portrait (9:16)" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ToggleSwitch Name="PortraitModeCheckbox" IsChecked="{Binding IsPortraitMode, Mode=TwoWay}" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="36" MinHeight="36" Grid.Column="1" AutomationProperties.Name="Portrait mode (9:16)" ToolTip.Tip="Turn this on to make the video tall for mobile phones like TikTok or YouTube Shorts." />
                                    </Grid>
                                    <TextBox Name="PortraitTextInput" Text="{Binding OverlayText, Mode=TwoWay}" Watermark="Overlay Text" HorizontalAlignment="Stretch" MinHeight="36" MaxHeight="80" FontSize="{DynamicResource AppFontSize12}" ToolTip.Tip="Type text here to show it at the very top of your mobile-friendly video." TextWrapping="Wrap" AcceptsReturn="True" IsVisible="{Binding #PortraitModeCheckbox.IsChecked}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </StackPanel>

                                <Separator Name="InGameOverlaysSeparator" Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,6,0,6"/>

                                <!-- NOMASK_01: this whole block (and the separator above it) is collapsed by
                                     MainWindow.ApplyMaskProfileToOverlayUi when the reserved "No Mask Profile"
                                     is active, because that profile composites no HUD layers at all. -->
                                <StackPanel Name="InGameOverlaysPanel" Spacing="2">
                                    <TextBlock Text="IN-GAME OVERLAYS" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3"/>   <!-- SPACING_01: centred + bold -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="Teammate HP" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ToggleSwitch Name="TeammatesCheckbox" IsChecked="{Binding IsTeammates, Mode=TwoWay}" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="36" MinHeight="36" Grid.Column="1" AutomationProperties.Name="Teammate HP overlay" ToolTip.Tip="Turn this on to show your teammates' health in the video." />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="Spectating Eye" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ToggleSwitch Name="SpectatingCheckbox" IsChecked="{Binding IsSpectating, Mode=TwoWay}" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="36" MinHeight="36" Grid.Column="1" AutomationProperties.Name="Spectating eye overlay" ToolTip.Tip="Turn this on to show the spectator eye counter in the video." />
                                    </Grid>
                                </StackPanel>

                                <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,6,0,6"/>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="EFFECTS &amp; MEMES" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3"/>   <!-- SPACING_01: centred + bold -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="Enable Fade" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ToggleSwitch Name="EnableFadeCheckbox" IsChecked="{Binding IsEnableFade, Mode=TwoWay}" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="36" MinHeight="36" Grid.Column="1" AutomationProperties.Name="Enable fade" ToolTip.Tip="Turn this on to make the video slowly fade in at the start and fade out at the end." />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="Add MEME" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ToggleSwitch Name="AddMemeCheckbox" IsChecked="{Binding IsAddMeme, Mode=TwoWay}" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="36" MinHeight="36" Grid.Column="1" AutomationProperties.Name="Add MEME" ToolTip.Tip="Turn this on to add funny meme popups over your video." />
                                    </Grid>
                                    <ComboBox Name="MemeComboBox" HorizontalAlignment="Stretch" IsVisible="{Binding #AddMemeCheckbox.IsChecked}" PlaceholderText="Select MEME" ToolTip.Tip="Choose which meme effect to display over your video." MinHeight="32" FontSize="{DynamicResource AppFontSize11}" />

                                    <!-- MEME_02: where the meme plays. Hidden until a meme is actually
                                         chosen, so it never clutters the panel for people who do not use
                                         memes. The value is remembered PER FILE, so a meme you set to
                                         Start once comes back as Start for ever. -->
                                    <Grid Name="MemePlacementRow" IsVisible="False" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                                        <TextBlock Grid.Column="0" Text="Plays" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}"/>
                                        <ComboBox Grid.Column="1" Name="MemePlacementCombo" HorizontalAlignment="Stretch"
                                                  MinHeight="32" FontSize="{DynamicResource AppFontSize11}"
                                                  ToolTip.Tip="Choose whether this meme plays before your gameplay or after it. Your choice is remembered for this meme.">
                                            <ComboBoxItem Content="at the END — after my video"/>
                                            <ComboBoxItem Content="at the START — before my video"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                            </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            
            <!-- Advanced Tools (Pinned to Bottom) -->
            <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Bottom">
                <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,0,0,5"/>
                <TextBlock Text="ADVANCED TOOLS" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold"/>
                <Button Name="VideoMergerButton" Classes="Secondary" Content="VIDEO MERGER" HorizontalAlignment="Stretch" ToolTip.Tip="Open a tool that lets you combine multiple videos into one. This opens in place of the editor, so this window closes — your edits are saved first and come straight back."/>
                <Button Name="CropSettingsButton" Classes="Secondary" Content="CROP SETTINGS" HorizontalAlignment="Stretch" ToolTip.Tip="Choose how you want to crop or resize your videos. This opens in place of the editor, so this window closes — your edits are saved first and come straight back."/>
            </StackPanel>
            </Grid>
        </Border>

                </Grid>
                <!-- Phase Overlay for export progress -->
                <controls:PhaseOverlayControl x:Name="OverlayLayer" Grid.RowSpan="3" IsVisible="False" />

                <!-- Contextual Radial Menu (IDEA 2) -->
                <controls:RadialMenuControl x:Name="RadialMenu" Grid.RowSpan="3" ZIndex="999"/>

                <!-- Ambient Pulsing Dropzone (IDEA 4) -->
                <controls:AmbientDropzoneControl x:Name="AmbientDropzone" Grid.RowSpan="3" ZIndex="998"/>

                <!-- IDEA_01: BlankStateOverlay removed — merged into the single UploadOverlay hero card -->

                <!-- Particle Burst Feedback (IDEA 011) -->
                <controls:ParticleBurstCanvas x:Name="ParticleLayer" Grid.RowSpan="3" ZIndex="1000"/>

                <!-- MEMEWALL_01 — the Meme Wall (IDEA 008) was removed: nothing ever made it visible.
                     The meme picker (Controls/MemePickerWindow) now carries its thumbnails and search. -->

                <!-- ══════════════════════════════════════════════════════════════════════════
                     ISSUE_14 — THIS ELEMENT WAS A GHOST FOR ITS ENTIRE LIFE. IT HAS A JOB NOW.
                     Its comment promised "Pop-up Badges and Custom Floating Animations", and a
                     search of the whole source tree found ZERO code that ever added a child to it.
                     It is now the host surface for Controls/FloatingNotice.cs — the float-up-and-
                     fade message that used to require a per-window Popup (ISSUE_09).
                     ⚠️ KEEP IsHitTestVisible="False": notices float over the timeline and the
                        transport buttons and must never swallow a click.
                     ⚠️ ZIndex raised to int.MaxValue-1000 by FloatingNotice at run time so a notice
                        sits above every overlay but BELOW the CoachOverlay walkthrough. The 999
                        here is only the design-time value.
                     ══════════════════════════════════════════════════════════════════════════ -->
                <Canvas Name="OverlayCanvas" Grid.RowSpan="3" IsHitTestVisible="False" ZIndex="999"/>

                <!-- IDEA_10: keyboard cheat sheet. Opens with "?" and closes with "?" or Escape.
                     The rows are built in code from SettingsManager.Instance.KeyBinds so it always
                     shows the user's OWN rebound keys, never the factory defaults. Sits above every
                     other overlay so it is reachable even while the export overlay is up. -->
                <Grid Name="ShortcutSheetOverlay" Grid.RowSpan="3" IsVisible="False" ZIndex="10001"
                      Background="{DynamicResource AppOverlayBrush}">
                    <Border Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2"
                            CornerRadius="14" MaxWidth="620" MaxHeight="620"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Row="0" Text="Keyboard Shortcuts"
                                       FontSize="{DynamicResource AppFontSize20}" FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="ShortcutSheetRows" Spacing="8"/>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Spacing="12" Margin="0,16,0,0">
                                <TextBlock Text="Press ? or Esc to close. Change any key in Settings › Key Binds."
                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                           FontSize="{DynamicResource AppFontSize11}" FontStyle="Italic"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                <!-- ISSUE_05: a keyboard-only escape from a panel a mouse user opened
                                     from the View menu is not an escape. -->
                                <Button Name="ShortcutSheetCloseButton" Classes="Primary" Content="GOT IT"
                                        HorizontalAlignment="Center" MinWidth="160"
                                        ToolTip.Tip="Close the shortcut list."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <!-- Drag & Drop Airspace Override Popup Removed -->
    </Grid>
</Window>
