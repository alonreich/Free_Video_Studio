<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FreeVideoStudio.App"
        x:Class="FreeVideoStudio.App.VideoMergerWindow"
        xmlns:controls="clr-namespace:FreeVideoStudio.App.Controls"
        Title="Free Video Studio - Video Merger"
        Background="{DynamicResource AppSurfaceBrush}"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="Manual"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <!-- Video Queue: selection marching ants, hover glow, hand cursor -->
    <Window.Styles>
        <Style Selector="ListBoxItem:selected Rectangle.MarchingAnts">
            <Setter Property="IsVisible" Value="True"/>
            <Style.Animations>
                <Animation Duration="0:0:0.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="StrokeDashOffset" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="StrokeDashOffset" Value="6"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ListBoxItem Rectangle.MarchingAnts">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- MERGERPLAYHEAD_01: on the Merger timeline the playhead is the red line drawn by VideoMergerWindow.Playhead.cs,
             so the scrub slider's resting dot is hidden (the slider still carries the value, keyboard and automation). -->
        <Style Selector="Slider#TimelineSlider /template/ Thumb">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <!-- ANTS_01 (P5.3, D14): the SAME yellow marching ants on the selected clip's block of the merged timeline.
             MERGERPLAYHEAD_01 (user 2026-09-28): thinner (AntsThickness 1.25, was 2) so they read gentler. -->
        <Style Selector="Rectangle.TimelineAnts">
            <Style.Animations>
                <Animation Duration="0:0:0.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="StrokeDashOffset" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="StrokeDashOffset" Value="6"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ListBoxItem Border.ItemGlow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.ItemGlow">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha10Brush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource AppItemGlowHoverShadow}"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.ItemGlow">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha20Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BoxShadow" Value="{DynamicResource AppItemGlowSelectedShadow}"/>
        </Style>
        <Style Selector="#VideoList ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha20Brush}"/>
        </Style>
        <Style Selector="#VideoList ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, Auto, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" TextTrimming="CharacterEllipsis" />
                </Border>

                <Menu Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextMutedBrush}" Padding="10,0" FontSize="{DynamicResource AppFontSize12}">
                    <MenuItem Header="_File">
                        <MenuItem Name="MenuAddVideo" Header="Add Video..." ToolTip.Tip="Browse your computer to select a new video file and add it to the merger list." />
                        <Separator />
                        <MenuItem Name="MenuOutputFolder" Header="Output Folder..." ToolTip.Tip="Choose the folder on your computer where the final merged video will be saved." />
                        <Separator />
                        <MenuItem Name="MenuSettings" Header="_Settings" ToolTip.Tip="Open advanced settings for video merging." />
                        <MenuItem Name="MenuAbout" Header="_About" ToolTip.Tip="View application version, system details, and check for updates." />
                        <Separator />
                        <MenuItem Name="MenuReturnToApp" Header="Return to Main App" ToolTip.Tip="Close the merger and go back to the main editing studio." />
                        <MenuItem Name="MenuExit" Header="Exit" ToolTip.Tip="Close the application entirely." />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Name="MenuRemoveSelected" Classes="Danger" ToolTip.Tip="Delete the currently highlighted videos from the list. They will not be included in the final merged video.">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚠️" />
                                    <TextBlock Text="Remove Selected" />
                                    <TextBlock Text="(WARNING: Cannot be undone)" FontSize="{DynamicResource AppFontSize9}" Foreground="{DynamicResource AppWarningBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Name="MenuClearAll" Classes="Danger" ToolTip.Tip="Completely empty the list of videos and start over fresh.">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚠️" />
                                    <TextBlock Text="Clear All" />
                                    <TextBlock Text="(WARNING: Cannot be undone)" FontSize="{DynamicResource AppFontSize9}" Foreground="{DynamicResource AppWarningBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <!-- MERGERMAIN_01 — THE COLUMNS ARE THE MAIN APP'S WAY ROUND NOW.
                     This grid used to be ColumnDefinitions="Auto, *" with the queue pinned to the
                     LEFT (the "FLIPPED" comment that used to sit here). Nothing else in the suite is
                     laid out that way: the Main App puts the player and its transport on the left in
                     the star column and a narrow utility rail on the right, and a user moving
                     between the two screens had to relearn which side their tools were on. Star
                     first, Auto second, exactly as MainWindow.axaml row 2 does it. -->
                <Grid Grid.Row="2" ColumnDefinitions="*, Auto">

                    <!-- Ambient live-wallpaper bubbles (very gentle, non-interactive, behind all content).
                         Echoes the FluidVolumeSlider bubble aesthetic across the theme background. -->
                    <controls:AmbientBubblesBackground Grid.ColumnSpan="2" IsHitTestVisible="False" ZIndex="-1" />

                    <!-- LEFT COLUMN (star): Player & Editing Controls. Was Grid.Column="1". -->
                    <Grid Grid.Column="0" RowDefinitions="*, Auto" ClipToBounds="False">

                        <!-- Video Player Area + Volume Slider -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,10,10,10" ClipToBounds="False">

                            <!-- ISSUE_09 (audit round 5): this Border is Focusable AND a tab stop, but had no
                                 focus visual — while AvaloniaApp.axaml shipped a Border.InteractiveFocus
                                 :focus / :focus-visible style that NO element in the suite ever wore, so the
                                 rule was dead code. Wired up here. BorderThickness/BorderBrush are declared at
                                 rest (2px, transparent) so gaining focus only recolours the stroke and causes
                                 zero layout shift in the video surface. -->
                            <Border Name="VideoAreaBorder" Classes="InteractiveFocus" Grid.Column="0" Background="{DynamicResource AppVideoSurfaceBrush}" CornerRadius="6" ClipToBounds="True" Padding="2" BorderThickness="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="True" KeyboardNavigation.IsTabStop="True">
                                <Grid ClipToBounds="False" Name="MainVideoGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <local:MpvVideoView Name="VideoHost" Grid.Row="0" />

                                    <!-- MERGEPREVIEW_01 (P8.2) / MEME_07: the veil over the two file swaps of a meme cut-away (MemeSwapOverlay). -->
                                    <Border Name="MemeSwapOverlay" Grid.Row="0" IsVisible="False" ZIndex="900" Background="{DynamicResource AppScrimBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                            <TextBlock Text="&#x1F921;" FontSize="{DynamicResource AppFontSize36}" HorizontalAlignment="Center"/>
                                            <ProgressBar IsIndeterminate="True" MinWidth="180" MinHeight="6" Foreground="{DynamicResource AppMemeBrush}" Background="{DynamicResource AppPanelBrush}"/>
                                            <TextBlock Name="MemeSwapOverlayText" Text="Loading the meme..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Please wait a moment." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- DETACH_01: shared pop-out preview. Own geometry key:
                                         MergerPreviewMonitorBounds. -->
                                    <Border Name="MergerPreviewDetachedWatermark" Grid.Row="0" IsVisible="False" ZIndex="65" Background="{DynamicResource AppVideoSurfaceBrush}" CornerRadius="4">
                                        <TextBlock Text="Preview Detached" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize36}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- UXQA_04: only exists once there is something to preview. At
                                         ZIndex 9999 with no visibility gate it used to float ON TOP of
                                         NoVideoOverlay (ZIndex 500), so an empty queue showed a
                                         "Detach Monitor" button sitting over the "add some videos"
                                         message — offering an action that could not work, covering the
                                         instruction for what to actually do. ZIndex is now 600: above
                                         the empty state it no longer collides with, below nothing that
                                         needs to block input. -->
                                    <Button Name="MergerDetachPreviewBtn" Grid.Row="0" Classes="Secondary" Content="◳ Detach Monitor"
                                            IsVisible="{Binding $parent[local:VideoMergerWindow].HasVideos}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Padding="8,4"
                                            FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold"
                                            Background="{DynamicResource AppOverlayBrush}" ZIndex="600"
                                            ToolTip.Tip="Pop the preview out into its own floating window. It remembers its size, position and which screen you left it on."/>

                                    <!-- PREVIEWFAULT_01 — the explicit preview-unavailable state. Shown when MPV
                                         startup failed and was contained: the merger stays fully usable. -->
                                    <Border Name="MergerPreviewUnavailableOverlay" Grid.Row="0" IsVisible="False" ZIndex="700" Background="{DynamicResource AppOverlayBrush}" CornerRadius="4">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="16">
                                            <TextBlock Text="🎬" FontSize="{DynamicResource AppFontSize36}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Preview unavailable" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Text="Video preview could not start. You can continue using the merger, but preview is unavailable." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
                                        </StackPanel>
                                    </Border>

                                    <Border IsVisible="{Binding #VideoHost.IsSoftwareFallbackActive}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Background="{DynamicResource AppOverlayBrush}" CornerRadius="4" Padding="6" ToolTip.Tip="Live preview could not initialize on this graphics session.">
                                        <TextBlock Text="⚠️" FontSize="{DynamicResource AppFontSize16}" Foreground="{DynamicResource AppWarningBrush}" />
                                    </Border>



                                    <Border Name="NoVideoOverlay" Grid.Row="0" Background="{DynamicResource AppOverlayBrush}" CornerRadius="4" IsVisible="{Binding !$parent[local:VideoMergerWindow].HasVideos}" ZIndex="500">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                            <TextBlock Text="🎬" FontSize="{DynamicResource AppFontSize48}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="No video loaded" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Select a video from the queue to preview" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Name="TimelineOverlay" Grid.Row="1" VerticalAlignment="Bottom" Background="Transparent" ZIndex="9999" Cursor="Hand" ClipToBounds="False" IsVisible="False">
                                        <Border VerticalAlignment="Bottom" Background="{DynamicResource AppOverlayBrush}" Padding="8,4,8,4" ClipToBounds="False">
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ClipToBounds="False">
                                                <TextBlock Name="TimeElapsed" Text="00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" MinWidth="64" FontSize="{DynamicResource AppFontSize10}" Margin="0,0,8,0" />
                                                <Grid Grid.Column="1" VerticalAlignment="Center" RowDefinitions="Auto, Auto, Auto, Auto" ClipToBounds="False">
                                                    <Canvas Grid.Row="0" Name="TimelineScaleCanvas" IsHitTestVisible="False" ClipToBounds="False" HorizontalAlignment="Stretch" MinHeight="14" />
                                                    <Slider Grid.Row="1" Name="TimelineSlider" Classes="CompactSlider" Minimum="0" Maximum="100" MinHeight="44" VerticalAlignment="Center" ClipToBounds="False" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="Video merger timeline scrub slider" ToolTip.Tip="Drag this left or right to quickly skip through different parts of the video." />
                                                    <Canvas Grid.Row="1" Name="TimelineMarkersCanvas" Classes="TimelineSeekSurface" Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Video merger timeline seek area" IsHitTestVisible="True" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" MinHeight="32" Cursor="Hand" />
                                                    <!-- LANES_01 (P5.1/P5.2): filmstrip and waveform under the merged timeline. Filled left→right in the
                                                         background by VideoMergerWindow.Lanes.cs; hidden until the merged timeline exists. Not hit-testable.
                                                         P10 (item 4): the scrub row is 44 px because the shared CompactSlider thumb is 44 px (one permitted
                                                         thumb style, docs/04 UI-THEME), but the resting knob is a 21 px dot on the centre line, so the lower
                                                         ~11 px of that band were dead space. The lanes now start 8 px INTO it (Margin -8): still below the
                                                         resting knob (centre 22 + 10.5 = 32.5 < 36), and being later in the grid they are on top, so the
                                                         overlap strip is unambiguously the blocks' (drag), never the slider's (seek). -->
                                                    <Canvas Grid.Row="2" Name="MergerFilmstripLane" IsHitTestVisible="False" ClipToBounds="True" HorizontalAlignment="Stretch" Height="34" Margin="0,-8,0,0" IsVisible="False" />
                                                    <!-- D20 (P5.4): clip BLOCKS over the filmstrip — click selects, drag reorders, right-click menu. Built by VideoMergerWindow.TimelineSelect.cs. -->
                                                    <Canvas Grid.Row="2" Name="MergerClipBlocksLane" Background="Transparent" IsHitTestVisible="True" ClipToBounds="False" HorizontalAlignment="Stretch" Height="34" Margin="0,-8,0,0" IsVisible="False" />
                                                    <Canvas Grid.Row="3" Name="MergerWaveformLane" IsHitTestVisible="False" ClipToBounds="True" HorizontalAlignment="Stretch" Height="18" Margin="0,1,0,0" IsVisible="False" />
                                                </Grid>
                                                <TextBlock Grid.Column="2" Name="TimeRemaining" Text="-00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" MinWidth="64" TextAlignment="Right" FontSize="{DynamicResource AppFontSize10}" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" CornerRadius="4" Background="{DynamicResource AppVideoRailBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="4,8" MinWidth="48" VerticalAlignment="Stretch" Margin="2,0,2,0" ClipToBounds="False" ZIndex="9999">
                                <Grid RowDefinitions="Auto, *, Auto" ClipToBounds="False" HorizontalAlignment="Stretch" Margin="0">
                                    <!-- Numeric readout appears on hover/drag and fades out again (see MainWindow for the
                                         full rationale). Bound to the slider's own IsInteracting flag. -->
                                    <TextBlock Grid.Row="0" Name="VolumeBadgeText" Text="100%" Foreground="{DynamicResource AppInfoBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" IsHitTestVisible="False" Opacity="{Binding #VolumeSlider.IsInteracting, Converter={x:Static local:BoolToOpacityConverter.Instance}}">
                                        <TextBlock.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                                            </Transitions>
                                        </TextBlock.Transitions>
                                    </TextBlock>
                                    <!-- Custom fluid "test tube" volume slider (see Controls/FluidVolumeSlider.cs).
                                         Rollback: swap for a standard vertical Slider with the same Name/bindings (rollback folder no longer exists). -->
                                    <controls:FluidVolumeSlider Grid.Row="1" Name="VolumeSlider" Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding $parent[local:VideoMergerWindow].MergerVolume, Mode=TwoWay}" MinWidth="57" HorizontalAlignment="Center" VerticalAlignment="Stretch" MinHeight="140" Background="Transparent" Margin="0,0,0,0" ToolTip.Tip="Slide up or down to make the video louder or quieter." Cursor="Hand" ClipToBounds="False" ZIndex="10000" Foreground="{DynamicResource AppInfoBrush}" />
                                    <!-- ISSUE_08: real Button (was a Border) so mute has identical semantics, focus visuals,
                                         pressed feedback and screen-reader role as the Main App's mute control. -->
                                    <Button Grid.Row="2" Name="SpeakerHitBox" Classes="Secondary" MinWidth="44" MinHeight="44" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" ZIndex="10001" Focusable="True" ToolTip.Tip="Click here to quickly mute or unmute the video." AutomationProperties.Name="Mute or restore volume" ClipToBounds="False">
                                        <Path Name="VolumeSpeakerIcon" Fill="Transparent" Stroke="{DynamicResource AppInfoBrush}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="{DynamicResource AppFontSize20}" Height="{DynamicResource AppFontSize20}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Data="{DynamicResource AppSpeakerIconGeometry}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ══════════════════════════════════════════════════════════════════
                             MERGERBOTTOM_01 — THE BOTTOM BAR IS THE MAIN APP'S BOTTOM BAR NOW.
                             This was a WrapPanel of FOUR bordered "cards", each with its own
                             AppSurfaceAlpha80Brush fill, 1px border, 8px corner radius and 12x10
                             padding. The Main App's bottom bar has no cards at all: it is plain rows
                             on the window background, with grouping done by position and spacing.
                             Four framed boxes side by side read as four separate tools rather than
                             one control strip, and every frame cost ~26px of width and height that
                             the controls inside then had to fight for.
                             All four Borders are gone. Same controls, same order, no chrome.

                             ALSO GONE: SET IN / SET OUT / FULL CLIP and the ClipTrimStatusText line
                             they wrote to. Per-clip trimming is not part of this screen any more;
                             the trim MODEL survives in the code-behind (BuildClipTrimList still
                             feeds MergerWorker, and every clip now reports a full-length trim), so
                             nothing downstream changed shape.
                             ══════════════════════════════════════════════════════════════════ -->
                        <Grid Grid.Row="1" RowDefinitions="Auto, Auto" Margin="10,8,10,8">

                            <!-- ══════════════════════════════════════════════════════════════
                                 MERGERROWS_01 — TWO ROWS, AND BOTH OF THEM FULL.
                                 MERGERBOTTOM_01 removed the four bordered cards but kept their
                                 stacking: transport on its own row, then a column with the quality
                                 dial, the two big estimate figures, the output path and the
                                 normalisation line all underneath each other, with MERGE and SPEED
                                 beside it. That column alone was ~230px tall, and the transport row
                                 above it spent its entire width on three buttons in the middle and
                                 empty space either side.
                                 P10 (2026-09-27): Row 0 mirrors the Main App's upper row — SET
                                 THUMBNAIL left, transport centre, GRANULAR SPEED right; the size and
                                 length figures sit at the left of row 1. Row 1 is one line: OUTPUT QUALITY, MERGE
                                 VIDEOS and SPEED side by side, which is the Main App's lower row
                                 exactly (MainWindow.axaml Grid.Row="2": left action, centred
                                 WrapPanel of quality / process / speed).
                                 Net: roughly 150px of vertical space returned to the video.
                                 ══════════════════════════════════════════════════════════════ -->

                            <Grid Grid.Row="0" Margin="0,0,0,6">

                                <!-- MERGERESTIMATE_02 / P10 (2026-09-27): the upper row is now the Main App's upper row —
                                     SET THUMBNAIL on the left, the transport in the centre, GRANULAR SPEED on the right (with the
                                     advisory output path beside it). TOTAL SIZE / TOTAL LENGTH moved to row 1, left of the quality
                                     dial, where the Main App shows its estimated size. -->


                                <!-- MERGERUX_01 P10 (item 2) — SCRAPER_04 / SET THUMBNAIL: IDENTICAL to the Main App's SetThumbnailButton
                                     (same class, padding, icon · text · icon, font size, left of the transport). -->
                                <Button Name="SetMergerThumbnailButton" Classes="Secondary" Padding="16,8" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False" AutomationProperties.Name="Set thumbnail"
                                        ToolTip.Tip="Save the exact frame you are looking at right now to be the cover image for your video.">
                                    <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize18}" Height="{DynamicResource AppFontSize18}" Stretch="Uniform" VerticalAlignment="Center" Data="{DynamicResource AppImageIconGeometry}" />
                                        <TextBlock Name="SetMergerThumbnailText" Text=" SET THUMBNAIL " FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center" Margin="6,0,6,0" />
                                        <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize18}" Height="{DynamicResource AppFontSize18}" Stretch="Uniform" VerticalAlignment="Center" Data="{DynamicResource AppImageIconGeometry}" />
                                    </StackPanel>
                                </Button>

                                <!-- P10 (item 3) — MERGEEDIT_02: the Granular Speed Editor button where the Main App has it
                                     (right of the transport, same class and padding, same GRANULAR SPEED / EDIT SPEEDS states). -->
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Where the file lands, and whether the audio will be levelled (advisory; trims, never pushes the transport). -->
                                    <StackPanel VerticalAlignment="Center" MaxWidth="220" Spacing="1">
                                        <TextBlock Name="OutputPathText" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <!-- ISSUE_005: Normalization info -->
                                        <TextBlock Name="NormalizeInfoText" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Name="MergerGranularButton" Classes="Secondary" Content="GRANULAR SPEED" Padding="16,8" IsEnabled="False" AutomationProperties.Name="Granular edit the merge"
                                            ToolTip.Tip="Open the Granular Speed Editor on the whole merge: speed ramps, freeze frames, zoom, delete parts and memes. Effects stay inside the clip they are placed on."/>
                                </StackPanel>

                                <!-- Transport, centred on the player above it — the Main App's upper row. -->
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- ISSUE_007: Fast backward uses LEFT-pointing triangles -->
                                    <!-- ISSUE_02 (audit round 4): theme-aware icon fill on Secondary buttons -->
                                    <Button Name="FastBackwardButton" Classes="Secondary" MinWidth="50" Padding="16,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Skip backward 10 seconds in the video. Doing this also turns the sound on." IsEnabled="False" AutomationProperties.Name="Fast Backward 10 Seconds">
                                        <Path Data="{DynamicResource AppFastBackwardIconGeometry}" Fill="{Binding $parent[Button].Foreground}" Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}" Stretch="Uniform"/>
                                    </Button>
                                    <Button Name="PlayPauseButton" Classes="Primary" MinWidth="70" Padding="16,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Play or pause the video. Previews start silent while you browse the list; pressing this turns the sound on." IsEnabled="False">
                                        <Panel Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}">
                                            <Path Name="PlayIcon" Data="{DynamicResource AppPlayIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform"/>
                                            <Path Name="PauseIcon" IsVisible="False" Data="{DynamicResource AppPauseIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform"/>
                                        </Panel>
                                    </Button>
                                    <!-- Fast forward uses RIGHT-pointing triangles -->
                                    <Button Name="FastForwardButton" Classes="Secondary" MinWidth="50" Padding="16,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Skip forward 10 seconds in the video. Doing this also turns the sound on." IsEnabled="False" AutomationProperties.Name="Fast Forward 10 Seconds">
                                        <Path Data="{DynamicResource AppFastForwardIconGeometry}" Fill="{Binding $parent[Button].Foreground}" Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}" Stretch="Uniform"/>
                                    </Button>

                                </StackPanel>


                            </Grid>

                            <!-- SCRAPER_05 — small, bottom left. Same flag as Settings > Defaults > Video Merger. -->
                            <CheckBox Grid.Row="1" Name="ThumbnailScraperCheckBox" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,6,0,0" MinHeight="0" Padding="4,0,0,0"
                                      AutomationProperties.Name="Skip cover pictures"
                                      ToolTip.Tip="Removes the tiny cover picture added to the start of some clips, so it does not flash between videos. Eligible cover pictures are cut from the 2nd clip onward. The first clip keeps its cover picture unless you set a custom thumbnail.">
                                <TextBlock Text="Skip cover pictures" FontSize="{DynamicResource AppFontSize10}" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap" MaxWidth="70" VerticalAlignment="Center"/>
                            </CheckBox>



                            <!-- Row 1: OUTPUT QUALITY, MERGE VIDEOS and SPEED on ONE line, in the
                                 Main App's order — the dial that decides the output, the button that
                                 makes it, the dial that decides how fast it runs. -->
                            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0" ColumnDefinitions="Auto,28,Auto,28,Auto,28,Auto">

                                <!-- P10 — TOTAL SIZE / TOTAL LENGTH moved here (left of the quality dial, the Main App's place for the size) so the upper row is the Main App's: SET THUMBNAIL · transport · GRANULAR SPEED. -->
                                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4" MinWidth="130" VerticalAlignment="Center">
                                    <StackPanel Orientation="Vertical" Spacing="0">
                                        <TextBlock Text="TOTAL SIZE" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Name="EstimatedSizeText" Text="—" Foreground="{DynamicResource AppInfoBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" HorizontalAlignment="Center"
                                                   ToolTip.Tip="Roughly how big the finished file will be, with the music included. It updates whenever you add or remove a clip, or move either dial." />
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Spacing="0">
                                        <TextBlock Text="TOTAL LENGTH" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Name="EstimatedLengthText" Text="—" Foreground="{DynamicResource AppInfoBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" HorizontalAlignment="Center"
                                                   ToolTip.Tip="How long the finished video will run once every clip in the list is joined end to end, at the speed you have chosen." />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="OUTPUT QUALITY" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"
                                               ToolTip.Tip="How good you want the finished video to look. Pick it once and leave it — the size it works out to is shown to its left." />
                                    <controls:SpinningWheelSlider Name="QualitySlider" Value="19" HorizontalAlignment="Center" Width="160" MinHeight="44" Cursor="Hand" ToolTip.Tip="Slide left for a smaller file size, or right for higher video quality." />
                                    <TextBlock Name="QualityLabel" Text="100% — Lossless" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="4" Name="MergeButton" Classes="Success" Content="MERGE VIDEOS" CornerRadius="10" IsEnabled="False" VerticalAlignment="Center" ToolTip.Tip="Combine all the videos in your list into one single final video." Padding="20,12"/>

                                <Grid Grid.Column="6" VerticalAlignment="Center" ColumnDefinitions="Auto,8,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="SPEED" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                        <controls:SpinningWheelSlider Name="MainSpeedSlider" Value="10" HorizontalAlignment="Center" Width="160" MinHeight="44" Cursor="Hand" ToolTip.Tip="Slide left to make the video slow motion, or right to speed it up." />
                                        <TextBlock Name="MainSpeedLabel" Text="1.0x — Normal" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- Preset grid geometry copied from MainWindow's MainSpeedPresetsPanel so the
                                         two screens' speed blocks are the same object in two places. -->
                                    <Grid Grid.Column="2" Name="MainSpeedPresetsPanel" RowDefinitions="Auto,8,Auto" ColumnDefinitions="Auto,8,Auto,8,Auto" VerticalAlignment="Center">
                                        <Button Grid.Row="0" Grid.Column="0" Name="SpeedPreset01" Classes="SpeedPreset" Content="0.1x" ToolTip.Tip="Set speed to 0.1x"/>
                                        <Button Grid.Row="0" Grid.Column="2" Name="SpeedPreset05" Classes="SpeedPreset" Content="0.5x" ToolTip.Tip="Set speed to 0.5x"/>
                                        <Button Grid.Row="0" Grid.Column="4" Name="SpeedPreset10" Classes="SpeedPreset BaseSpeedPreset" Content="1.0x" ToolTip.Tip="Set speed to normal (1.0x)"/>
                                        <Button Grid.Row="2" Grid.Column="0" Name="SpeedPreset20" Classes="SpeedPreset" Content="2.0x" ToolTip.Tip="Set speed to 2.0x"/>
                                        <Button Grid.Row="2" Grid.Column="2" Name="SpeedPreset30" Classes="SpeedPreset" Content="3.0x" ToolTip.Tip="Set speed to 3.0x"/>
                                        <Button Grid.Row="2" Grid.Column="4" Name="SpeedPreset40" Classes="SpeedPreset" Content="4.0x" ToolTip.Tip="Set speed to 4.0x"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════════════════════════════
                         MERGERQUEUE_01 — THE QUEUE IS A RIGHT-HAND UTILITY RAIL, LIKE THE MAIN APP'S.
                         Same shell as MainWindow.axaml's right panel: transparent background, a
                         single 1px left border, 15px padding, a bounded width, and a
                         RowDefinitions="Auto, *, Auto" that pins a block to the bottom.
                         Order inside it is deliberately the Main App's FILE OPERATIONS order —
                         the "get something in" button first, ADD MUSIC directly under it — so the
                         two screens' rails start the same way and a user's hand goes to the same
                         place on both.
                         ══════════════════════════════════════════════════════════════════════════ -->
                    <Border Grid.Column="1" MinWidth="260" MaxWidth="380" Background="Transparent" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0" Padding="15">
                        <Grid RowDefinitions="Auto, *, Auto">

                            <!-- Row 0: the two "add something" buttons, in the Main App's order. -->
                            <!-- MERGERQUEUE_02 — the "FILE OPERATIONS" heading is gone.
                                 It was carried over from the Main App's rail, where it separates two
                                 labelled groups. Here there is only one group and its first control
                                 says ADD VIDEO in capitals, so the heading named nothing the button
                                 below it did not already say — while costing a text line plus the
                                 10px stack gap out of the top of the tallest control in the window.
                                 That space belongs to the list. -->
                            <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,12">
                                <Button Name="AddVideoButton" Classes="Primary" Content="ADD VIDEO" HorizontalAlignment="Stretch" MinHeight="{DynamicResource AppButtonMinHeight}" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="Add video to queue" ToolTip.Tip="Browse your computer and add another video to your list."/>
                                <Button Name="AddMusicButton" Classes="Secondary" HorizontalAlignment="Stretch" MinHeight="{DynamicResource AppButtonMinHeight}" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="Add background music" IsEnabled="False" ToolTip.Tip="Add a background song to play over your combined videos.">
                                    <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize14}" Height="{DynamicResource AppFontSize14}" Stretch="Uniform" VerticalAlignment="Center" Data="{DynamicResource AppMusicNoteIconGeometry}" />
                                        <TextBlock Name="AddMusicText" Text=" ADD MUSIC " FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,6,0" />
                                        <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize14}" Height="{DynamicResource AppFontSize14}" Stretch="Uniform" VerticalAlignment="Center" Data="{DynamicResource AppMusicNoteIconGeometry}" />
                                    </StackPanel>
                                </Button>

                            </StackPanel>

                            <!-- ══════════════════════════════════════════════════════════════════
                                 QUEUEFRAME_01 — ONE CONTAINER, ONE CONTROL.
                                 The list, the reorder arrows and REMOVE SELECTED used to be three
                                 separate things in three separate places: the list in a framed box,
                                 the arrows in a floating strip to its right OUTSIDE the frame, and
                                 REMOVE two rows further down under ADD MUSIC, next to a bare warning
                                 glyph. Nothing said they belonged together, and the arrows in
                                 particular looked like they applied to the panel rather than to the
                                 selected row.
                                 They are all inside this one frame now: list on top, a footer welded
                                 to the bottom edge of the same box holding the arrows and then
                                 REMOVE under them. The 1px top rule on the footer is the only thing
                                 separating them, so the whole box reads as a single list control
                                 with its own toolbar — which is what it is.

                                 The "VIDEOS LIST" heading that used to sit above this box is gone.
                                 A box full of video file names, in a pane whose top button says ADD
                                 VIDEO, does not need a label telling the user it contains videos —
                                 and the heading cost a full text row plus 10px of margin out of the
                                 narrowest pane in the window.
                                 ══════════════════════════════════════════════════════════════════ -->
                            <Border Grid.Row="1" Name="VideoListFrame" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid RowDefinitions="*, Auto">

                                    <Grid Grid.Row="0">
                                        <ListBox Name="VideoList" Background="Transparent" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" DragDrop.AllowDrop="True" SelectionMode="Multiple">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid MinHeight="30" ClipToBounds="False" ToolTip.Tip="{Binding}">
                                                        <Border Classes="ItemGlow" CornerRadius="3" Background="Transparent" BorderThickness="1"/>
                                                        <Rectangle Classes="MarchingAnts" Stroke="{DynamicResource AppWarningBrush}" StrokeThickness="1" StrokeDashArray="4,2" IsVisible="False" IsHitTestVisible="False" RadiusX="3" RadiusY="3"/>
                                                        <!-- Long titles ellipsize (TextTrimming); full path shows via the item ToolTip -->
                                                        <Grid Margin="8,0" VerticalAlignment="Center" ColumnDefinitions="Auto, *">
                                                            <TextBlock Grid.Column="0" Text="🎬" FontSize="{DynamicResource AppFontSize10}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Converter={x:Static local:FileNameConverter.Instance}}" Cursor="Hand" FontSize="{DynamicResource AppFontSize12}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                            <!-- ══════════════════════════════════════════════════
                                                 QUEUEMENU_01 — RIGHT-CLICK A CLIP.
                                                 Deliberately a Flyout carrying a hand-built Border,
                                                 NOT a MenuFlyout: this is the same object as the Crop
                                                 Tool's RolePopup (CropToolWindow.axaml, ROLEPOPUP_01)
                                                 — accent-bordered surface, 8px radius, a small bold
                                                 muted caption over a stack of real Buttons — so the
                                                 two screens' pop-up choosers are recognisably the
                                                 same control. A MenuFlyout would have inherited
                                                 Fluent's own menu chrome instead and looked like it
                                                 came from a different program.
                                                 Flyout, not a bare Border, because a context menu
                                                 genuinely does need to escape the pane's bounds and
                                                 genuinely does want light dismiss — the two reasons
                                                 ROLEPOPUP_01 gives for NOT using one do not apply to a
                                                 240px menu on a 260px rail.
                                                 The buttons bind nothing: VideoList_ContextAction in
                                                 the code-behind reads them by name, and the selection
                                                 they act on is set by the right-press itself.
                                                 ══════════════════════════════════════════════════ -->
                                            <ListBox.ContextFlyout>
                                                <Flyout Placement="Pointer" ShowMode="Standard">
                                                    <Border Name="QueueContextPopup"
                                                            MinWidth="210"
                                                            MaxWidth="300"
                                                            Background="{DynamicResource AppSurfaceBrush}"
                                                            BorderBrush="{DynamicResource AppAccentBrush}"
                                                            BorderThickness="2"
                                                            CornerRadius="8"
                                                            Padding="6">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="THIS CLIP"
                                                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                                                       FontSize="{DynamicResource AppFontSize11}"
                                                                       FontWeight="Bold"
                                                                       Margin="4,2,4,4"
                                                                       IsHitTestVisible="False" />
                                                            <Button Name="CtxMoveUpButton" Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" ToolTip.Tip="Move this clip one place earlier in the list.">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Polygon Points="6,0 12,8 0,8" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" Width="12" Height="10" Stretch="Uniform"/>
                                                                    <TextBlock Text="Move up" VerticalAlignment="Center" FontSize="{DynamicResource AppFontSize12}"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Name="CtxMoveDownButton" Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" ToolTip.Tip="Move this clip one place later in the list.">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Polygon Points="0,0 12,0 6,8" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" Width="12" Height="10" Stretch="Uniform"/>
                                                                    <TextBlock Text="Move down" VerticalAlignment="Center" FontSize="{DynamicResource AppFontSize12}"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="2,4" />
                                                            <Button Name="CtxRemoveButton" Classes="Danger" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" ToolTip.Tip="Take this clip out of the list. The file on your computer is not touched.">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <TextBlock Text="&#x26A0;" VerticalAlignment="Center" FontSize="{DynamicResource AppFontSize12}"/>
                                                                    <TextBlock Text="Remove from list" VerticalAlignment="Center" FontSize="{DynamicResource AppFontSize12}"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </ListBox.ContextFlyout>
                                        </ListBox>

                                        <TextBlock Name="EmptyQueueText" Text="Add at least one video to build a merge queue." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18" IsHitTestVisible="False"/>
                                        <Border Name="DropIndicator" Height="3" Background="{DynamicResource AppInfoBrush}" CornerRadius="1.5" IsVisible="False" VerticalAlignment="Top" Margin="4,0,4,0" BoxShadow="{DynamicResource AppDropIndicatorShadow}" ZIndex="100" IsHitTestVisible="False"/>
                                        <Canvas Name="VideoListRubberbandCanvas" IsHitTestVisible="False" ZIndex="200">
                                            <Rectangle Name="VideoListRubberband"
                                                       Fill="{DynamicResource AppAccentAlpha20Brush}"
                                                       Stroke="{DynamicResource AppAccentBrush}"
                                                       StrokeThickness="1.5"
                                                       StrokeDashArray="3,2"
                                                       IsVisible="False" />
                                        </Canvas>
                                    </Grid>

                                    <!-- The list's own toolbar, welded to the bottom of the same frame. -->
                                    <Border Grid.Row="1" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="8,8">
                                        <StackPanel Spacing="8">
                                            <!-- QUEUEFRAME_01 — the arrows are BIG now. They were 12x12
                                                 polygons in a Padding="12,12" Secondary button, which
                                                 made the glyph itself smaller than the 44px target it
                                                 sat in and left the button reading as decorative. Half
                                                 the footer each, a real minimum height, and a glyph
                                                 sized off the font tokens so it scales with everything
                                                 else. -->
                                            <Grid ColumnDefinitions="*,8,*">
                                                <Button Grid.Column="0" Name="MoveUpButton" Classes="Secondary" MinHeight="44" Padding="8,10" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Move selected video up" ToolTip.Tip="Move the highlighted video higher up in the list so it plays earlier.">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Polygon Points="6,0 12,8 0,8" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize14}" Stretch="Uniform"/>
                                                        <TextBlock Text="UP" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Name="MoveDownButton" Classes="Secondary" MinHeight="44" Padding="8,10" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Move selected video down" ToolTip.Tip="Move the highlighted video lower down in the list so it plays later.">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Polygon Points="0,0 12,0 6,8" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize14}" Stretch="Uniform"/>
                                                        <TextBlock Text="DOWN" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <Button Name="RemoveVideoButton" Classes="Danger" HorizontalAlignment="Stretch" MinHeight="{DynamicResource AppButtonMinHeight}" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="Remove selected video" IsEnabled="False" ToolTip.Tip="Delete the currently highlighted video from your list. The file on your computer is not touched.">
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#x26A0;" FontSize="{DynamicResource AppFontSize12}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="REMOVE SELECTED" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <Flyout Placement="Top">
                                                        <StackPanel Spacing="8" Margin="8">
                                                            <TextBlock Text="⚠️ Cannot be undone" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" />
                                                            <Button Name="ConfirmRemoveVideoButton" Classes="Danger" Content="CONFIRM REMOVE" HorizontalAlignment="Stretch" ToolTip.Tip="Permanently remove the selected video from the queue." />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Row 2: queue status, then the way out — pinned to the bottom of the rail,
                                 exactly where MainWindow.axaml pins its ADVANCED TOOLS block. -->
                            <StackPanel Grid.Row="2" Spacing="8" VerticalAlignment="Bottom" Margin="0,12,0,0">
                                <TextBlock Name="QueueStatusText" Text="Waiting for videos." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap" TextAlignment="Center"/>
                                <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,4,0,1"/>
                                <!-- MERGERRETURN_01 — the way back lives where the way in lives.
                                     RETURN TO MAIN APP is now the mirror image of the Main App's
                                     VIDEO MERGER button: same Secondary class, same stretched width,
                                     same bottom-right corner of the right-hand rail. Going there and
                                     coming back are now the same gesture in the same place.
                                     SHOW ME AROUND sits directly above it in the HelpHint class —
                                     the suite's information hue — so the permanent walkthrough entry
                                     is unmistakably a help affordance and not another navigation
                                     button competing with RETURN for the same click. -->
                                <Button Name="MergerHelpButton" Classes="HelpHint" Content="? SHOW ME AROUND" HorizontalAlignment="Stretch" FontSize="{DynamicResource AppFontSize11}" MinHeight="{DynamicResource AppButtonMinHeight}" AutomationProperties.Name="Show me around the video merger" ToolTip.Tip="New here? Play the short walkthrough that points out what everything on this screen does."/>
                                <Button Name="ReturnToMainAppButton" Classes="Secondary" Content="← RETURN TO MAIN APP" HorizontalAlignment="Stretch" FontSize="{DynamicResource AppFontSize11}" MinHeight="{DynamicResource AppButtonMinHeight}" ToolTip.Tip="Close the merger and go back to the main editing studio."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Modal Scrim for Flyout Confirmations -->
                <Border Name="FlyoutScrim" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{DynamicResource AppScrimSoftBrush}" IsVisible="False" ZIndex="98"/>

                <!-- Processing Overlay -->
                <controls:PhaseOverlayControl x:Name="OverlayLayer" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
