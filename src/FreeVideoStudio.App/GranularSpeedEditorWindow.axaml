<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FreeVideoStudio.App"
        xmlns:controls="clr-namespace:FreeVideoStudio.App.Controls"
        x:Class="FreeVideoStudio.App.GranularSpeedEditorWindow"
        Title="Free Video Studio - Speed Editor"
        Background="{DynamicResource AppSurfaceBrush}"
        MinWidth="900" MinHeight="600"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowStartupLocation="Manual">

    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" TextTrimming="CharacterEllipsis" />
                </Border>
                <!-- LAYOUT_02: ONE row now. The second row held the full-width bottom navigation bar
                     (status line + CANCEL/APPLY); both moved into the right-hand inspector pane so
                     the whole window gets that height back. -->
                <Grid Grid.Row="1" RowDefinitions="*">

        <!-- MAIN BODY -->
        <!-- ISSUE_07: was ColumnDefinitions="*, 280" — a hardcoded absolute width in violation of
             the suite Font-Scale Sizing Rule. At the ExtraLarge scale (1.25x) the segments panel's
             legend rows and the full-width CLEAR ALL SEGMENTS button had no room to grow. Now Auto
             with Min/Max bounds on the Border itself, matching MainWindow (170/300),
             VoiceOverWindow (260/340) and CropToolWindow (180/300). -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">

            <!-- LEFT: Video preview + timeline
                 LAYOUT_01 — WAS FIVE ROWS. The old ROW 1 was a full-width "action ribbon" holding
                 nothing but the freeze cluster on the left and one ZOOM-IN button on the right —
                 a whole band of vertical space for two controls, taken straight off the video
                 preview, which is the one thing in this window that actually needs the height.
                 Both clusters moved into the transport row (now row 2), which had a centred group
                 of three buttons and two empty flanks doing nothing. Same controls, one fewer
                 band. Do not reintroduce a dedicated toolbar row here. -->
            <Grid Grid.Column="0" RowDefinitions="*, Auto, Auto, Auto" Margin="12,10,12,8">

                <!-- Video preview -->
                <Border Name="GranularVideoAreaBorder" Grid.Row="0" Background="{DynamicResource AppVideoSurfaceBrush}" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <!-- DETACH_01: named so the detach controller can move this WHOLE Viewbox —
                             video + zoom overlay + phone frame — as one piece. Moving only the
                             MpvVideoView would leave the zoom rectangle drawn over an empty box. -->
                        <Viewbox Name="GranularPreviewViewbox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="0">
                            <Grid Name="ZoomContainerGrid" Width="1920" Height="1080">
                                <Grid Width="1920" Height="1080" VerticalAlignment="Center">
                                    <local:MpvVideoView Name="GranularVideoHost" ZIndex="0"/>
                                    <!-- §4 Zoom draw surface. Dimmer + spotlight cutout + handles + tutorial are built
                                         in code-behind and added here. Background is near-transparent so the whole
                                         area receives pointer events while zoom mode is active. -->
                                    <Canvas Name="ZoomOverlayCanvas" ZIndex="40" IsVisible="False" Background="{DynamicResource AppHoverOverlayBrush}" Cursor="Cross" ClipToBounds="True"/>
                                </Grid>
                                
                                <!-- #1 Fake mobile phone frame: shows the 9:16 portrait crop area (visible only when Portrait mode is on) -->
                                <Grid Name="GranularPortraitDimmingGrid" ZIndex="5" IsVisible="False" IsHitTestVisible="False">
                                    <controls:PhoneFrameMockup Name="GranularPhoneFrame" />
                                </Grid>
                            </Grid>
                        </Viewbox>

                        <!-- DETACH_01: the Viewbox above is what travels to the floating window, so the
                             zoom overlay and the phone frame stay in register with the picture. These two
                             stay behind: the placeholder fills the hole, the button brings it back. -->
                        <Border Name="GranularPreviewDetachedWatermark" IsVisible="False" ZIndex="65" Background="{DynamicResource AppVideoSurfaceBrush}">
                            <TextBlock Text="Preview Detached" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize36}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- UXQA_02/03: TOP-RIGHT and ZIndex 66 — BOTH DELIBERATE, DO NOT "TIDY".
                             Top-LEFT put it exactly where users start dragging a zoom box, and the
                             button (being on top) swallowed the drag, silently blocking zoom in that
                             corner. ZIndex 9999 also floated it ABOVE ZoomApplyBusyOverlay (70) and
                             the freeze dimmer, so it stayed clickable while those overlays existed
                             precisely to block input. 66 keeps it above the detached watermark (65)
                             and under every blocking overlay. It is also hidden outright while zoom
                             mode is active — see UpdateDetachButtonForZoomMode(). -->
                        <Button Name="GranularDetachPreviewBtn" Classes="Secondary" Content="◳ Detach Monitor"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Padding="8,4"
                                FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold"
                                Background="{DynamicResource AppOverlayBrush}" ZIndex="66"
                                ToolTip.Tip="Pop the preview out into its own floating window. It remembers its size, position and which screen you left it on."/>

                        <!-- #10 Live drag readout: shows exact start / end / length while dragging a block.
                             ⚠️ ISSUE_06 — ZINDEX AND ANCHOR ARE BOTH LOAD-BEARING. DO NOT "TIDY".
                             This badge used to be ZIndex 60 and permanently bottom-anchored, which put it
                             underneath AND behind `ZoomStylePanel` (ZIndex 65, also bottom-centred, Margin
                             0,0,0,14). Whenever zoom mode was on, dragging a segment showed the numbers
                             into a completely invisible box. It is now 68 — above ZoomStylePanel (65) and
                             the detached watermark (65), still BELOW ZoomApplyBusyOverlay (70), which must
                             cover everything while a zoom is being applied. `UpdateDragReadout` also flips
                             the anchor to TOP while ZoomStylePanel is visible, so the two never share
                             screen space even at large font scale. -->
                        <Border Name="DragReadoutBadge" IsVisible="False" ZIndex="68" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" IsHitTestVisible="False">
                            <TextBlock Name="DragReadoutText" Text="" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold"/>
                        </Border>

                        <!-- AI Tracking Live Loop Preview Verification Bar (Requirement 9.a) -->
                        <Border Name="AiTrackingPreviewBar" IsVisible="False" ZIndex="69"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                Background="{DynamicResource AppScrimStrongBrush}" BorderBrush="{DynamicResource AppAccentBrush}"
                                BorderThickness="2" CornerRadius="8" Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AppSuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="AI TRACKING PREVIEW (LOOPING)" Foreground="{DynamicResource AppAccentBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize12}"/>
                                    </StackPanel>
                                    <TextBlock Text="Review camera tracking motion before applying." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}"/>
                                    <!-- AIUSAGE_01 — what this AI task used and the allowance before → after (docs/05 §7.5). -->
                                    <TextBlock Name="AiTrackingUsageText" IsVisible="False" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap" MaxWidth="560" Margin="0,4,0,0"/>
                                    <TextBlock Name="AiTrackingAllowanceText" IsVisible="False" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" TextWrapping="Wrap" MaxWidth="560"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Name="AiTrackingDiscardBtn" Classes="Danger" Content="DISCARD" MinWidth="90" MinHeight="36" Cursor="Hand" ToolTip.Tip="Discard this tracking trajectory and revert"/>
                                    <Button Name="AiTrackingAcceptBtn" Classes="Success" Content="ACCEPT &amp; APPLY" MinWidth="130" MinHeight="36" Cursor="Hand" ToolTip.Tip="Accept and lock this tracking zoom onto the segment"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- AI Commentary Live Preview Verification Bar -->
                        <Border Name="AiCommentaryPreviewBar" IsVisible="False" ZIndex="69"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                Background="{DynamicResource AppScrimStrongBrush}" BorderBrush="{DynamicResource AppAccentBrush}"
                                BorderThickness="2" CornerRadius="8" Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AppSuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="AI COMMENTARY PREVIEW" Foreground="{DynamicResource AppAccentBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize12}"/>
                                    </StackPanel>
                                    <TextBlock Text="Review commentary subtitles before applying." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}"/>
                                    <!-- AIUSAGE_01 — what this AI task used and the allowance before → after (docs/05 §7.5). -->
                                    <TextBlock Name="AiCommentaryUsageText" IsVisible="False" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap" MaxWidth="560" Margin="0,4,0,0"/>
                                    <TextBlock Name="AiCommentaryAllowanceText" IsVisible="False" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" TextWrapping="Wrap" MaxWidth="560"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Name="AiCommentaryDiscardBtn" Classes="Danger" Content="DISCARD" MinWidth="90" MinHeight="36" Cursor="Hand" ToolTip.Tip="Discard generated commentary captions and revert"/>
                                    <Button Name="AiCommentaryAcceptBtn" Classes="Success" Content="ACCEPT &amp; APPLY" MinWidth="130" MinHeight="36" Cursor="Hand" ToolTip.Tip="Accept and lock commentary captions onto the video"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <Grid Name="FreezeDimmer" Background="{DynamicResource AppOverlayBrush}" IsVisible="{Binding #FreezeValidationPopup.IsOpen}" ZIndex="10" />
                        <Popup Name="FreezeValidationPopup" IsOpen="False" Placement="Center" IsHitTestVisible="False" ZIndex="11" IsLightDismissEnabled="False">
                            <Border Name="FreezeValidationBorder" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="2" CornerRadius="6" Padding="16,10">
                                <TextBlock Name="FreezeValidationText" Text="SELECT FREEZE DURATION" FontSize="{DynamicResource AppFontSize16}" Foreground="{DynamicResource AppWarningBrush}" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>
                        </Popup>
                        <!-- ISSUE_09: the GranularFeedbackPopup trio lived here. It is gone — this window
                             now raises the SAME notice as every other screen through
                             Controls/FloatingNotice.cs, which needs no XAML at all. Do not add a
                             per-window feedback Popup back; that duplication is what made six screens
                             speak in five different voices. -->
                        <!-- ══════════════════════════════════════════════════════════════════
                             IDEA_6 — ZOOM STYLE PICKER, SHOWN WHERE THE ZOOM IS BEING DRAWN.
                             This used to be two radio buttons labelled "ANIMATION: Slow | Instant"
                             parked at the far right of the toolbar row, a long way from the video,
                             visible only when a block happened to be selected. Nothing about it
                             said what it changed, so it read as decoration.
                             It now appears ONLY while the zoom box is being drawn, directly under
                             the video, in plain words, with a little shape showing the difference.
                             ⚠️ The two RadioButtons keep their EXACT original Names, type and
                             GroupName ("SlowZoomCheck"/"InstantZoomCheck", GroupName="ZoomRamp").
                             Seven typed FindControl<RadioButton> lookups depend on that, and per
                             the R3 rule in project_structure.txt a stale type there is a
                             process-killing throw, not a silent null. Do not rename or retype.
                             ══════════════════════════════════════════════════════════════════ -->
                        <Border Name="ZoomStylePanel" IsVisible="False" ZIndex="65"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                                Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppZoomBrush}"
                                BorderThickness="2" CornerRadius="8" Padding="14,10">
                            <Border.Styles>
                                <Style Selector="RadioButton">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Background" Value="{DynamicResource AppZoomCardBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="Template">
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border Name="CardBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                    <Panel Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Ellipse Name="OuterBullet" Width="18" Height="18"
                                                                 Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="2"
                                                                 Fill="{DynamicResource AppZoomCardWellBrush}" />
                                                        <Ellipse Name="InnerBullet" Width="8" Height="8"
                                                                 Fill="{DynamicResource AppZoomBrush}" IsVisible="False" />
                                                    </Panel>
                                                    <ContentPresenter Grid.Column="1"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                                <Style Selector="RadioButton:pointerover /template/ Border#CardBorder">
                                    <Setter Property="Background" Value="{DynamicResource AppZoomCardHoverBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppZoomBrush}" />
                                </Style>
                                <Style Selector="RadioButton:checked /template/ Border#CardBorder">
                                    <Setter Property="Background" Value="{DynamicResource AppZoomCardCheckedBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppZoomBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </Style>
                                <Style Selector="RadioButton:checked /template/ Ellipse#OuterBullet">
                                    <Setter Property="Stroke" Value="{DynamicResource AppZoomBrush}" />
                                </Style>
                                <Style Selector="RadioButton:checked /template/ Ellipse#InnerBullet">
                                    <Setter Property="IsVisible" Value="True" />
                                </Style>
                            </Border.Styles>
                            <StackPanel Spacing="8">
                                <TextBlock Text="HOW SHOULD THE ZOOM ARRIVE?" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold"
                                           Foreground="{DynamicResource AppZoomBrush}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                                    <RadioButton Name="InstantZoomCheck" GroupName="ZoomRamp" IsChecked="True"
                                                 MinHeight="{DynamicResource AppButtonMinHeight}" VerticalContentAlignment="Center"
                                                 ToolTip.Tip="The picture cuts straight to the zoomed view with no movement.">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Step shape = an instant jump -->
                                            <Path Data="M 0,16 L 12,16 L 12,2 L 26,2" Stroke="{DynamicResource AppZoomBrush}" StrokeThickness="2.5" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="Snap straight in" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <TextBlock Text="Jumps instantly" FontSize="{DynamicResource AppFontSize9}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Name="SlowZoomCheck" GroupName="ZoomRamp"
                                                 MinHeight="{DynamicResource AppButtonMinHeight}" VerticalContentAlignment="Center"
                                                 ToolTip.Tip="The camera glides into the zoom over half a second, then glides back out. Needs at least half a second of spare video on that side, otherwise that side snaps.">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Ramp shape = a gradual glide -->
                                            <Path Data="M 0,16 L 6,16 C 14,16 12,2 26,2" Stroke="{DynamicResource AppZoomBrush}" StrokeThickness="2.5" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="Glide in over half a second" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <TextBlock Text="Eases in, then eases out" FontSize="{DynamicResource AppFontSize9}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- GPU live zoom preview: blocking busy overlay shown while APPLY ZOOM-IN
                             primes the simulated crop in mpv (GPU render path only). -->
                        <Border Name="ZoomApplyBusyOverlay" IsVisible="False" ZIndex="70" Background="{DynamicResource AppOverlayBrush}" CornerRadius="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <ProgressBar IsIndeterminate="True" Width="140" Height="4" Foreground="{DynamicResource AppAccentBrush}" Background="{DynamicResource AppPanelBrush}"/>
                                <TextBlock Text="Applying changes..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- MEME_07: the meme cutaway swaps the file in the ONE mpv host, so the
                             picture goes black for a few hundred milliseconds at each end of the
                             meme. Unannounced that reads as a stutter or a crash, so it is said out
                             loud. ZIndex 72 sits above the zoom busy overlay (70). -->
                        <Border Name="MemeSwapOverlay" IsVisible="False" ZIndex="72" Background="{DynamicResource AppScrimBrush}" CornerRadius="6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <TextBlock Text="&#x1F921;" FontSize="{DynamicResource AppFontSize36}" HorizontalAlignment="Center"/>
                                <ProgressBar IsIndeterminate="True" MinWidth="180" MinHeight="6" Foreground="{DynamicResource AppMemeBrush}" Background="{DynamicResource AppPanelBrush}"/>
                                <TextBlock Name="MemeSwapOverlayText" Text="Loading the meme..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Please wait a moment." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ROW 1: Timeline — now the SHARED TimelineLanesControl (LANES_03).
                     The ruler, gridlines, caret, both clocks and every click-to-seek surface
                     live in that control and are shared with Music Wizard phase 3. This window
                     supplies only its two lane CONTENTS from code-behind:
                       LaneAHost -> the speed/freeze/zoom drawing canvas + empty-state label
                       LaneBHost -> the film-frame strip
                     ⚠️ LaneASeekable stays FALSE: the upper lane runs its own pointer pipeline
                     (block move, edge resize, drag-to-create) and a seek surface over it would
                     swallow all of that.
                     ZOOM_01 — MarkerHeadroomPx reserves, INSIDE the scroll content, the 52px band
                     the floating freeze/zoom/meme markers already paint into above the ruler
                     (FreezeMarkerOverlayTop = -52; a ScrollViewer clips, so that band must be
                     real content space or the marker heads disappear the moment zoom is used).
                     The -56 top margin cancels the extra height AND the border padding, so the
                     ruler, lanes and markers sit at EXACTLY the on-screen position they had
                     before zoom existed; only the headroom band (empty except for markers) rides
                     up over the video, as the markers always did. -->
                <Border Grid.Row="1" Background="{DynamicResource AppOverlayBrush}" CornerRadius="6" Padding="8,4" Margin="10,4,10,4" ClipToBounds="False">
                    <controls:TimelineLanesControl Name="GranularLanes" ClipToBounds="False"
                                                   MarkerHeadroomPx="56" Margin="0,-56,0,0"/>
                </Border>

                <!-- ROW 2: Transport, with the freeze cluster on the left and ZOOM-IN on the right.
                     LAYOUT_01 — the three transport buttons used to sit alone in a centred group
                     with wide empty flanks on both sides, while the freeze and zoom controls had a
                     whole band of their own above the timeline. The flanks now carry them.

                     ⚠️ THE COLUMNS ARE `*, Auto, *` AND NOT `Auto, *, Auto`. With Auto flanks the
                     centre column absorbs the slack, so MARK START / PLAY / MARK END would drift
                     off true centre by half the difference between the freeze cluster's width and
                     the zoom button's — and the freeze cluster is far the wider of the two. Two
                     equal star flanks pin the transport to the real centre of the window whatever
                     the side clusters measure. -->
                <Grid Grid.Row="2" Margin="10,2,10,2" ColumnDefinitions="*, Auto, *">

                    <!-- LEFT FLANK: freeze -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Name="FreezeImageToggle" Classes="Primary" MinWidth="120" ToolTip.Tip="Freeze frame at current playhead" AutomationProperties.Name="Toggle Freeze Frame">
                            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- ISSUE_06 (audit round 4): token-sized icon (was fixed 16px) and no more
                                     translateY(5px) alignment hack — VerticalAlignment=Center does the job at every font scale -->
                                <Path Fill="{DynamicResource AppOnAccentTextBrush}" Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}" Stretch="Uniform" VerticalAlignment="Center" Data="M 2,6 L 4,6 L 5,4 L 11,4 L 12,6 L 14,6 Q 15,6 15,7 L 15,12 Q 15,13 14,13 L 2,13 Q 1,13 1,12 L 1,7 Q 1,6 2,6 Z M 8,7.5 A 2.5,2.5 0 1,0 8,12.5 A 2.5,2.5 0 1,0 8,7.5" />
                                <TextBlock Name="FreezeImageToggleText" Text=" FREEZE IMAGE " FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center" Margin="4,0,4,0" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Background="{DynamicResource AppBorderBrush}" Margin="0,4" Opacity="0.5" />
                        <!-- LAYOUT_01: six presets in ONE row was the widest thing in the old ribbon.
                             Folded into two rows of three, same shape and same `SpeedPresetRows`
                             spacing as the speed presets on the row below, so the two blocks read as
                             siblings instead of two unrelated widgets. -->
                        <StackPanel Name="FreezePresetsPanel" Classes="SpeedPresetRows" Orientation="Vertical" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Name="FreezePreset05" Classes="SpeedPreset" Content="0.5s" ToolTip.Tip="Freeze for 0.5s" Cursor="Hand"/>
                                <Button Name="FreezePreset10" Classes="SpeedPreset" Content="1.0s" ToolTip.Tip="Freeze for 1.0s" Cursor="Hand"/>
                                <Button Name="FreezePreset15" Classes="SpeedPreset" Content="1.5s" ToolTip.Tip="Freeze for 1.5s" Cursor="Hand"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Name="FreezePreset20" Classes="SpeedPreset" Content="2.0s" ToolTip.Tip="Freeze for 2.0s" Cursor="Hand"/>
                                <Button Name="FreezePreset25" Classes="SpeedPreset" Content="2.5s" ToolTip.Tip="Freeze for 2.5s" Cursor="Hand"/>
                                <Button Name="FreezePreset30" Classes="SpeedPreset" Content="3.0s" ToolTip.Tip="Freeze for 3.0s" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- CENTRE: transport -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Name="MarkStartBtn" Classes="Secondary" Content="MARK START" MinWidth="90" Margin="0,0,30,0" ToolTip.Tip="Mark the beginning of your clip"/>
                        <Button Name="GranularPlayPause" Classes="Primary" MinWidth="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Play or pause the video" Margin="0,0,30,0">
                            <Panel Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}">
                                <Path Name="PlayIcon" Data="{DynamicResource AppPlayIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform"/>
                                <Path Name="PauseIcon" IsVisible="False" Data="{DynamicResource AppPauseIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform"/>
                            </Panel>
                        </Button>
                        <Button Name="MarkEndBtn" Classes="Secondary" Content="MARK END" MinWidth="90" ToolTip.Tip="Mark the end of your clip"/>
                    </StackPanel>

                    <!-- RIGHT FLANK: zoom
                         IDEA_6: the "ANIMATION Slow|Instant" pair that used to sit beside this has
                         MOVED into `ZoomStylePanel`, under the video, where the zoom is actually
                         being drawn. It is no longer a permanent piece of toolbar the user must
                         decode before they know what it affects.
                         IDEA_3: ZOOM-IN is always visible (was IsVisible="False" until a block was
                         selected) — pressing it creates its own container block. -->
                    <!-- CUT_02: DELETE PARTS sits directly under ZOOM-IN. Cuts moved here from the
                         Main Screen because this editor already owns MARK START / MARK END and the
                         timeline that has to condense when footage is removed — the selection
                         gesture and the thing it acts on are now in the same place. -->
                    <!-- LAYOUT_03: this flank holds ZOOM-IN AND NOTHING ELSE, and that is the
                         point. It used to be a vertical stack of four buttons, which made row 2
                         four buttons tall while the left flank needed only two and the centre only
                         one — so the row's height was set by the tallest column and every other
                         column paid for it in blank space above the timeline. Vertical space is the
                         scarce axis in this editor.
                         With one button per flank, row 2 is ONE LINE: FREEZE IMAGE, MARK START /
                         PLAY / MARK END and ZOOM-IN all sit on the same baseline, and the gap
                         between the 60px thumbnail lane and the controls collapses.
                         DELETE PARTS and ADD MEME moved to row 3, where they flank the SPEED wheel
                         in the same two columns — DELETE PARTS stays under ZOOM-IN, ADD MEME sits
                         under FREEZE IMAGE. ⚠️ Do not add a second button back into this stack. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Name="AiCommentaryBtn" Classes="Primary" Content="🎙️ AI COMMENTARY" MinWidth="140"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Generate AI live commentary captions with synchronized karaoke highlights for this video."/>
                        <Button Name="AiSmartZoomBtn" Classes="Primary" Content="AI SMART ZOOM" MinWidth="140"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Automatically track and smoothly zoom in on a moving person, subject, or character using AI vision."/>
                        <Button Name="ZoomSegmentBtn" Classes="ZoomAction" Content="🔍 ZOOM-IN" MinWidth="140"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Draw a zoom (punch-in) box. If no speed block is selected, one is created for you at normal speed."/>
                    </StackPanel>
                </Grid>

                <!-- ROW 3: Speed presets + slider
                     LAYOUT_02: the margins in this column are deliberately tight. Every row here
                     is a fixed-height band, so any padding they carry is taken directly off the
                     video preview above — the only element that actually benefits from more
                     height. Do not restore generous margins "for breathing room"; the breathing
                     room comes from the preview being bigger. -->
                <Grid Grid.Row="3" Margin="10,2,10,0" ColumnDefinitions="*, Auto, *">

                    <!-- LAYOUT_03 / LEFT: ADD MEME, directly under the FREEZE IMAGE column and on
                         the SPEED wheel's line. REMOVE MEME sits beside it and only appears while a
                         meme is selected, so it costs no height when it is not needed. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- MEME_06: same gesture as ZOOM-IN and FREEZE IMAGE — park the playhead,
                             press the button, it lands exactly there. -->
                        <Button Name="AddMemeBtn" Classes="Secondary" MinWidth="140"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Drop a meme at the playhead. You then choose how it plays:&#x0a;• FULL SCREEN — the gameplay pauses, the meme plays, the gameplay carries on from the same frame. The video gets longer by the meme's length.&#x0a;• CORNER — the meme plays in a corner over the running gameplay. The video length stays the same.">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🤡" FontSize="{DynamicResource AppFontSize14}" VerticalAlignment="Center"/>
                                <TextBlock Text="ADD MEME" FontWeight="Bold"
                                           FontSize="{DynamicResource AppFontSize11}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- MEMELIST_01: every meme in one list — jump to, change or remove it. -->
                        <Button Name="MemeListBtn" Classes="Secondary" MinWidth="96" IsVisible="False"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="See every meme in this video: jump to one, change it or remove it.">
                            <TextBlock Name="MemeListBtnText" Text="MEMES ▾" FontWeight="Bold"
                                       FontSize="{DynamicResource AppFontSize11}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Name="RemoveMemeBtn" Classes="Danger" MinWidth="150" IsVisible="False"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Take this meme out of the video (or press Delete). Ctrl+Z brings it back.">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🤡" FontSize="{DynamicResource AppFontSize14}" VerticalAlignment="Center"/>
                                <TextBlock Text="REMOVE MEME" FontWeight="Bold"
                                           FontSize="{DynamicResource AppFontSize11}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Center: Speed presets + slider -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                        <StackPanel Orientation="Vertical" Spacing="2" Margin="0,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SPEED" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" />
                            <controls:SpinningWheelSlider Name="PendingSpeedSlider" Value="10" Width="160" MinHeight="{DynamicResource AppButtonMinHeight}" HorizontalAlignment="Center" ToolTip.Tip="Precise speed for the active segment" />
                            <TextBlock Name="PendingSpeedLabel" Text="1.1x" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        </StackPanel>
                        <!-- Speed preset buttons — two rows with vertical gap -->
                        <StackPanel Name="SpeedPresetsPanel" Classes="SpeedPresetRows" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,0,0">
                            <!-- Row 1: 0.1x – 1.0x -->
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Name="SpeedPreset01" Classes="SpeedPreset" Content="0.1x" ToolTip.Tip="Set speed to 0.1x"/>
                                <Button Name="SpeedPreset10" Classes="SpeedPreset" Content="1.0x" ToolTip.Tip="Set speed to normal (1.0x)"/>
                                <Button Name="SpeedPresetBase" Classes="SpeedPreset BaseSpeedPreset" Content="1.1x" ToolTip.Tip="Set speed to 1.1x"/>
                            </StackPanel>
                            <!-- Row 2: 2.0x – 4.0x -->
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Name="SpeedPreset20" Classes="SpeedPreset" Content="2.0x" ToolTip.Tip="Set speed to 2.0x"/>
                                <Button Name="SpeedPreset30" Classes="SpeedPreset" Content="3.0x" ToolTip.Tip="Set speed to 3.0x"/>
                                <Button Name="SpeedPreset40" Classes="SpeedPreset" Content="4.0x" ToolTip.Tip="Set speed to 4.0x"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- LAYOUT_03 / RIGHT: DELETE PARTS, directly under ZOOM-IN and on the SPEED
                         wheel's line. CUT_02's reason for it living in this editor is unchanged —
                         this screen owns MARK START / MARK END and the timeline that condenses when
                         footage is removed; only its position moved. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Name="DeletePartsBtn" Classes="Danger" MinWidth="140"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="DELETE ENTIRE SCENE FROM THE VIDEO">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- SCISSORS_01: solid-handled scissors. The old outline version
                                     lost both handles to sub-pixel walls on this red fill. -->
                                <Path Data="{DynamicResource AppScissorsIconGeometry}"
                                      Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform"
                                      Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="DELETE PARTS" FontWeight="Bold"
                                           FontSize="{DynamicResource AppFontSize11}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- RIGHT: Segments List -->
            <Border Grid.Column="1" MinWidth="280" MaxWidth="360" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0" Padding="12">
                <!-- LAYOUT_02: this pane is now a full INSPECTOR COLUMN — what is selected, what the
                     colours mean, the segment list, the live status line, and finally every action.
                     The full-width bottom navigation bar it replaced cost a whole horizontal band of
                     height across the entire window to show one line of text and two buttons, and
                     height is the scarce axis here while width is not. Rows: header / count /
                     legend / list (fills) / STATUS / actions. -->
                <!-- UNDO_01: row 5 added for the undo/redo pair; the action stack moved to row 6. -->
                <Grid RowDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto, Auto">
                    <!-- Header: title + Help button (#8) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                        <TextBlock Grid.Column="0" Text="SPEED SEGMENTS" Foreground="{DynamicResource AppAccentBrush}" FontSize="{DynamicResource AppFontSize13}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <!-- ISSUE_05 (audit round 5): was MinWidth/MinHeight 24 — a quarter of the
                             clickable area of every other button, on the one control aimed at a
                             first-time user. Now on the suite 44px hit-target tokens. -->
                        <Button Grid.Column="1" Name="HelpButton" Content="?" MinWidth="{DynamicResource AppSpeedPresetMinWidth}" MinHeight="{DynamicResource AppButtonMinHeight}" Padding="0" FontWeight="Bold" Classes="Secondary" AutomationProperties.Name="Open speed editor help" ToolTip.Tip="New here? Click for simple step-by-step help."/>
                    </Grid>
                    <TextBlock Grid.Row="1" Name="SegmentCountLabel" Text="No segments" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" Margin="0,0,0,8"/>
                    <!-- #6 Colour legend: what the block colours mean (matches GetSegmentOverlayColor) -->
                    <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="WHAT THE COLOURS MEAN" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border MinWidth="14" MinHeight="14" CornerRadius="3" Background="{DynamicResource AppSuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Green = faster than normal" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border MinWidth="14" MinHeight="14" CornerRadius="3" Background="{DynamicResource AppSpeedSlowBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Red = slower than normal" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border MinWidth="14" MinHeight="14" CornerRadius="3" Background="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Blue = frozen (still) frame" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Brighter colour = stronger effect." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" FontStyle="Italic" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <!-- The scrollable list of segments -->
                    <Border Grid.Row="3" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="3">
                        <ListBox Name="SegmentsPanel" Background="Transparent" BorderThickness="0" Margin="0,2,0,2">
                            <!-- COMPACT LIST: the default ListBoxItem chrome adds ~9px of padding
                                 above AND below every row plus a min-height, on top of the padding
                                 the row Border already draws. That was the single biggest consumer
                                 of vertical space in this pane. Scoped to THIS ListBox only — it
                                 does not touch any other list in the suite. -->
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                    <!-- LIVE STATUS. Moved here from the deleted bottom navigation bar.
                         TextWrapping is the whole point of the move: down here it has a narrow
                         column and unlimited vertical room to wrap into, instead of one clipped
                         line stretched across the window. MaxHeight + a scroller means an unusually
                         long message can never push the APPLY button off the bottom of the pane. -->
                    <Border Grid.Row="4" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4"
                            Padding="8,6" Margin="0,10,0,8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="STATUS" Foreground="{DynamicResource AppTextMutedBrush}"
                                       FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold"/>
                            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Name="BottomStatusLabel"
                                           Text="Set speed, then press MARK END to create a segment. Start is auto-inferred."
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           FontSize="{DynamicResource AppFontSize11}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- UNDO_01: undo/redo live at the BOTTOM of the segment pane, directly under the
                         stack of segments they act on. Icons only would be ambiguous next to the
                         destructive buttons below, so both carry their shortcut in the tooltip. -->
                    <!-- ⚠️ NO `ColumnSpacing` HERE — see the identical warning on the CANCEL/APPLY
                         row below. Avalonia's Grid has no such property and the compiler rejects the
                         WHOLE FILE with AVLN:0004. The 8px gutter is 4px of Margin on the facing
                         edge of each button, matching every other two-up button row in this suite. -->
                    <Grid Grid.Row="5" ColumnDefinitions="*,*" Margin="0,0,0,8">
                        <Button Name="UndoBtn" Grid.Column="0" Classes="Secondary" IsEnabled="False"
                                Margin="0,0,4,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="&#x21B6; UNDO" FontSize="{DynamicResource AppFontSize11}"
                                ToolTip.Tip="Undo the last change (Ctrl+Z)"/>
                        <Button Name="RedoBtn" Grid.Column="1" Classes="Secondary" IsEnabled="False"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="&#x21B7; REDO" FontSize="{DynamicResource AppFontSize11}"
                                ToolTip.Tip="Redo the change you just undid (Ctrl+Y)"/>
                    </Grid>

                    <!-- UNDOHINT_01: the shortcut hint lives HERE, immediately under the two buttons
                         it describes, so the key and the control it drives are read together. A
                         floating toast cannot do that — FloatingNotice is centred over the window by
                         design and shared by every screen. This label always names the EXACT action
                         Ctrl+Z would take back, so the user never has to guess what "undo" means
                         right now. RefreshUndoRedoButtons owns its text. -->
                    <Border Grid.Row="6" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4"
                            Padding="8,5" Margin="0,0,0,8">
                        <TextBlock Name="UndoHintText"
                                   Text="Every change can be taken back with Ctrl+Z"
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   FontSize="{DynamicResource AppFontSize10}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Row="7" Orientation="Vertical" Spacing="8" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                        <!-- ══════════════════════════════════════════════════════════════════════
                             ⚠️⚠️ ISSUE_01 — THESE TWO PROMPTS USED TO BE PURE DECORATION. ⚠️⚠️
                             A Button that owns a Flyout opens that Flyout by itself AND still raises
                             Click. Both buttons had a Click handler that destroyed the work outright,
                             so the sequence a user actually experienced was: segments gone -> "are you
                             sure?" -> a CONFIRM button wired to nothing at all. There is no undo in
                             this window.
                             THE RULE NOW (identical to Merger RemoveVideoButton and CropTool RESET):
                             the Click handler acts ONLY when the user has switched the confirmation
                             OFF in Settings > Confirmation Dialogs. Otherwise it does nothing and the
                             flyout asks; the CONFIRM button is the ONLY path that destroys anything.
                             ⚠️ NEVER put destructive work back into the outer button's Click handler.
                             The dialog is also deliberately LARGE (MinWidth 380, 48px buttons, plain
                             English, an explicit KEEP escape) — the old 8px-margin strip was easy to
                             click straight through without reading.
                             ══════════════════════════════════════════════════════════════════════ -->
                        <!-- ZOOM_04: the ONLY way to change a zoom. ZOOM-IN refuses to reopen a block
                             that already has one (owner's decision — a mis-drag on re-entry would
                             silently overwrite coordinates that were already right), so editing is
                             deliberately remove-then-redo. Visible only when the selected block
                             actually carries a zoom. -->
                        <Button Name="RemoveZoomBtn" Classes="ZoomAction" Content="🔍 REMOVE ZOOM" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="False" ToolTip.Tip="Take the zoom off this block. The block itself and its speed stay exactly as they are."/>
                        <Button Name="DeleteSegmentBtn" Classes="Danger" Content="DELETE SEGMENT" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="False" ToolTip.Tip="Delete the selected speed segment. Ctrl+Z brings it back." />
                        <Button Name="ClearAllSegmentsBtn" Classes="Danger" Content="CLEAR ALL SEGMENTS" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="False" ToolTip.Tip="Remove all speed segments">
                            <Button.Flyout>
                                <Flyout Placement="Top" FlyoutPresenterClasses="CustomFlyout">
                                    <StackPanel Spacing="14" Margin="22" MinWidth="380" MaxWidth="440">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="🧹" FontSize="{DynamicResource AppFontSize28}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Erase every segment?" FontSize="{DynamicResource AppFontSize18}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Name="ClearAllDetailText" Text="Every speed segment will be removed." FontSize="{DynamicResource AppFontSize13}" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>
                                        <Border Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <TextBlock Text="Every speed block and every zoom on the timeline is erased in one go. Changed your mind? Press Ctrl+Z to bring them all back." Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Border>
                                        <Grid ColumnDefinitions="*,12,*">
                                            <Button Grid.Column="0" Name="KeepAllSegmentsBtn" Classes="Secondary" Content="KEEP THEM" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Close this box and change nothing."/>
                                            <Button Grid.Column="2" Name="ConfirmClearAllSegmentsBtn" Classes="Danger" Content="ERASE ALL" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Remove every speed segment. Ctrl+Z brings them back." />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- The two window-level actions, moved off the deleted bottom bar. They sit
                             below a divider and below the destructive segment buttons, so the pane
                             reads top-to-bottom as "what is selected -> what I can do to it -> what
                             I do with the whole window" — which is the order the user thinks in. -->
                        <Border Height="1" Background="{DynamicResource AppBorderBrush}" Opacity="0.5" Margin="0,2,0,2"/>
                        <!-- ⚠️ NO `ColumnSpacing` HERE. That property is WinUI/WPF; Avalonia's Grid
                             does not have it and the compiler rejects the whole file (AVLN:0004).
                             The 8px gutter is split as 4px of Margin on the facing edge of each
                             button instead — which is also what every other two-up button row in
                             this suite does. -->
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0" Name="CancelGranularBtn" Classes="Danger" Content="CANCEL"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Margin="0,0,4,0"
                                    ToolTip.Tip="Discard changes and close">
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <StackPanel Spacing="8" Margin="8">
                                            <TextBlock Text="⚠️ Cannot be undone" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" />
                                            <Button Name="ConfirmCancelGranularBtn" Classes="Danger" Content="CONFIRM CANCEL" HorizontalAlignment="Stretch" ToolTip.Tip="Permanently discard changes and close." />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Grid.Column="1" Name="AcceptGranularBtn" Classes="Success" Content="APPLY"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Margin="4,0,0,0"
                                    ToolTip.Tip="Apply all speed segments and return"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

                </Grid>
            </Grid>
        </Border>

        <!-- #8 Help overlay: plain-English visual tutorial -->
        <Grid Name="HelpOverlay" IsVisible="False" ZIndex="10000" Background="{DynamicResource AppOverlayBrush}">
            <Border Name="HelpCard" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2" CornerRadius="14" MaxWidth="600" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                <StackPanel Spacing="15">
                    <TextBlock Text="How the Speed Editor Works" FontSize="{DynamicResource AppFontSize20}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                    
                    <!-- ISSUE_05 (audit round 4): real illustrative mini-timeline (replaces the shipped
                         "[ Interactive Timeline Tutorial Animation ]" developer placeholder).
                         Colors intentionally match the segment legend + timeline blocks. -->
                    <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="8" Padding="20" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10" VerticalAlignment="Center">
                            <Grid Height="28" ColumnDefinitions="14*,20*,10*,18*,8*,12*,18*">
                                <Border Grid.Column="0" Background="{DynamicResource AppControlTrackBrush}" CornerRadius="4,0,0,4"/>
                                <Border Grid.Column="1" Background="{DynamicResource AppSuccessBrush}" Opacity="0.85" CornerRadius="3"/>
                                <Border Grid.Column="2" Background="{DynamicResource AppControlTrackBrush}"/>
                                <Border Grid.Column="3" Background="{DynamicResource AppSpeedSlowBrush}" Opacity="0.85" CornerRadius="3"/>
                                <Border Grid.Column="4" Background="{DynamicResource AppControlTrackBrush}"/>
                                <Border Grid.Column="5" Background="{DynamicResource AppAccentBrush}" Opacity="0.85" CornerRadius="3"/>
                                <Border Grid.Column="6" Background="{DynamicResource AppControlTrackBrush}" CornerRadius="0,4,4,0"/>
                                <Border Grid.Column="1" Width="3" Background="{DynamicResource AppOnAccentTextBrush}" HorizontalAlignment="Left" Margin="0"/>
                                <Border Grid.Column="1" Width="3" Background="{DynamicResource AppOnAccentTextBrush}" HorizontalAlignment="Right" Margin="0"/>
                            </Grid>
                            <Grid ColumnDefinitions="14*,20*,10*,18*,8*,12*,18*">
                                <TextBlock Grid.Column="1" Text="faster" Foreground="{DynamicResource AppSuccessBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="slower" Foreground="{DynamicResource AppSpeedSlowBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="frozen" Foreground="{DynamicResource AppAccentBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Your timeline gets colored blocks like these. The white edge markers on a selected block can be dragged to resize it." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="1. MARK START and MARK END to select a piece of video." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize12}" />
                    <TextBlock Text="2. Drag the colored blocks on the timeline to adjust their edges." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize12}" />
                    <TextBlock Text="3. Select a block to change its speed, freeze it, or zoom in." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize12}" />

                    <!-- ISSUE_04: the static card is kept because it is a good at-a-glance reference,
                         but reading is not the same as being shown. SHOW ME hands off to the animated
                         walkthrough, which points at the real controls in this window. -->
                    <Grid ColumnDefinitions="*,12,*" Margin="0,20,0,0">
                        <Button Grid.Column="0" Name="HelpShowMeButton" Content="SHOW ME" Classes="Secondary" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Play the walkthrough that points at each control on this screen."/>
                        <Button Grid.Column="2" Name="HelpCloseButton" Content="GOT IT" Classes="Primary" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Close the help guide"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MEME_07: THE REBUILD STALL. Adding, moving or removing a meme changes the finished
             video's length and every frame position after the meme, so the output ruler, the film
             strip and the preview all have to be rebuilt before the timeline can be scrubbed
             truthfully. That takes a moment. This blocks the WHOLE window while it happens, on
             purpose: a half-rebuilt timeline that still accepts clicks is how a user ends up
             dragging a marker onto a position that no longer exists. It cannot be missed and it
             cannot be clicked through. -->
        <Border Name="MemeRebuildOverlay" IsVisible="False" ZIndex="9998" Background="{DynamicResource AppScrimStrongBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="520">
                <TextBlock Text="&#x1F921;" FontSize="{DynamicResource AppFontSize36}" HorizontalAlignment="Center"/>
                <TextBlock Text="PLEASE WAIT" Foreground="{DynamicResource AppMemeBrush}" FontSize="{DynamicResource AppFontSize24}" FontWeight="Bold" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" MinWidth="260" MinHeight="8" Foreground="{DynamicResource AppMemeBrush}" Background="{DynamicResource AppPanelBrush}"/>
                <TextBlock Name="MemeRebuildOverlayText" Text="Rebuilding your timeline around the meme..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="Your video is being re-timed so the preview matches the finished file exactly. This only takes a moment - the timeline will be ready to scrub as soon as it disappears." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- AI Smart Tracking Real-Time Thinking Overlay (Requirement 8.a: Modern semi-transparent HUD card ~850px+ wide) -->
        <Border Name="AiTrackingProgressOverlay" ZIndex="9997" IsVisible="False"
                Background="{DynamicResource AppScrimStrongBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}"
                    BorderThickness="2" CornerRadius="12" Padding="28" HorizontalAlignment="Center"
                    VerticalAlignment="Center" MinWidth="850" MaxWidth="960">
                <StackPanel Spacing="18">
                    <!-- Title & Spinner Row -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="26" Height="26" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                            <StackPanel Spacing="2">
                                <TextBlock Text="AI TARGET TRACKING &amp; DISCOVERY" FontSize="{DynamicResource AppFontSize18}"
                                           FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="Analyzing multi-angle frames and synthesizing smooth camera motion"
                                           FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Name="AiTrackingCancelBtn" Grid.Column="2" Classes="Danger" Content="CANCEL" MinWidth="100" MinHeight="36"
                                HorizontalAlignment="Right" Cursor="Hand" ToolTip.Tip="Cancel the active AI tracking operation"/>
                    </Grid>

                    <!-- Large Status Banner -->
                    <Border Background="{DynamicResource AppSurfaceSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <TextBlock Name="AiTrackingStatusLabel" Text="Phase 1: Slicing segment preview..." TextAlignment="Center"
                                   Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource AppFontSize14}"/>
                    </Border>

                    <!-- Indeterminate Progress Bar -->
                    <ProgressBar IsIndeterminate="True" Height="6" CornerRadius="3"
                                 Foreground="{DynamicResource AppAccentBrush}" Background="{DynamicResource AppPanelBrush}"/>

                    <!-- Expanded Console Log Output -->
                    <Border Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12" Height="170">
                        <ScrollViewer Name="AiTrackingConsoleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Name="AiTrackingConsoleText" Foreground="{DynamicResource AppTextMutedBrush}"
                                       FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Border>

        <!-- AI Commentary Progress Overlay -->
        <Border Name="AiCommentaryProgressOverlay" ZIndex="9997" IsVisible="False"
                Background="{DynamicResource AppScrimStrongBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}"
                    BorderThickness="2" CornerRadius="12" Padding="28" HorizontalAlignment="Center"
                    VerticalAlignment="Center" MinWidth="850" MaxWidth="960">
                <StackPanel Spacing="18">
                    <!-- Title & Spinner Row -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="26" Height="26" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                            <StackPanel Spacing="2">
                                <TextBlock Text="AI LIVE COMMENTARY SYNTHESIS" FontSize="{DynamicResource AppFontSize18}"
                                           FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="Analyzing gameplay events, audio cues, and synthesizing synchronized narration"
                                           FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Name="AiCommentaryCancelBtn" Grid.Column="2" Classes="Danger" Content="CANCEL" MinWidth="100" MinHeight="36"
                                HorizontalAlignment="Right" Cursor="Hand" ToolTip.Tip="Cancel the active AI commentary generation"/>
                    </Grid>

                    <!-- Large Status Banner -->
                    <Border Background="{DynamicResource AppSurfaceSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <TextBlock Name="AiCommentaryStatusLabel" Text="Preparing video clips and audio..." TextAlignment="Center"
                                   Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource AppFontSize14}"/>
                    </Border>

                    <!-- Progress Bar -->
                    <ProgressBar Name="AiCommentaryProgressBar" IsIndeterminate="True" Height="6" CornerRadius="3"
                                 Foreground="{DynamicResource AppAccentBrush}" Background="{DynamicResource AppPanelBrush}"/>

                    <!-- Expanded Console Log Output -->
                    <Border Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12" Height="170">
                        <ScrollViewer Name="AiCommentaryConsoleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Name="AiCommentaryConsoleText" Foreground="{DynamicResource AppTextMutedBrush}"
                                       FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Border>

        <!-- WINSEED_01 — same grip as the Voice Over Studio. Last child of the root Grid so it sits
             above MainBorder's 5px chrome; 24x24 transparent hit area with a drawn corner chevron. -->
        <Border Name="ResizeGrip" MinWidth="24" MinHeight="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" ToolTip.Tip="Drag to resize the Granular Speed Editor" AutomationProperties.Name="Resize Granular Speed Editor">
            <Path Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1.5" StrokeLineCap="Round" Data="M 8,20 L 20,8 M 13,20 L 20,13 M 18,20 L 20,18" />
        </Border>
    </Grid>

</Window>
