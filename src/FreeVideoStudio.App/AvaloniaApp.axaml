        <!-- MERGERRETURN_01 — the walkthrough / help affordance. Same recipe as every other class
             above (deep border, on-accent text, 3-stop ramp, hand cursor, hover ramp, disabled
             pair) so it inherits the whole shared Button style unchanged; only the hue differs. -->
        <Style Selector="Button.HelpHint">
            <Setter Property="BorderBrush" Value="{DynamicResource AppHelpBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppHelpButtonGradient}"/>
