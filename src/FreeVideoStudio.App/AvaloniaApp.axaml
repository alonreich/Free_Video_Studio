        </Style>
        <Style Selector="Button.HelpHint:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHelpButtonHoverGradient}"/>
        </Style>
        <Style Selector="Button.HelpHint:disabled">
