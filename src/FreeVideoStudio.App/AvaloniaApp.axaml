        <!-- IDEA_6: the ZOOM-IN button wears the zoom colour, so the button, the box you draw,
             the handles, the timeline bar and the style picker are all visibly one feature. -->
        <!-- BTNDEPTH_01: was a flat AppZoomBrush fill, the only action button in the Granular
             editor with no depth. Now the same 3-stop ramp as Primary/Success/Danger, still in the
             zoom colour so IDEA_6's "everything zoom is one colour" rule is untouched. -->
        <Style Selector="Button.ZoomAction">
