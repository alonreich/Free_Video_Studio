<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="True"
        x:Class="FreeVideoStudio.App.Controls.AiSetupWizardWindow"
        Title="Connect Your AI"
        Width="580" MinHeight="620" SizeToContent="Height"
        Background="{DynamicResource AppSurfaceBrush}"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <Grid>
        <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="3">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Text="Connect Your AI" Classes="WindowTitleText" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Name="WizardHeadline" Text="Connect your AI" FontSize="{DynamicResource AppFontSize18}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Name="WizardIntro" Text="AI features (Smart Zoom, Commentary, Magic Wand, Music Auto-Fit, Viral Post, Kill Tracker) use your own AI key. Paste it once here; it is stored encrypted for your Windows account only."
                                       Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Provider Selection Tabs -->
                        <Border Background="{DynamicResource AppSurfaceSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="1. Choose your AI provider (you can connect more than one):"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSize12}"/>
                                <Grid ColumnDefinitions="*, *, *">
                                    <Button Name="VendorGoogleBtn" Grid.Column="0" Classes="Secondary" Margin="2" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" Cursor="Hand" Content="Google Gemini ★"/>
                                    <Button Name="VendorAnthropicBtn" Grid.Column="1" Classes="Secondary" Margin="2" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" Cursor="Hand" Content="Anthropic Claude"/>
                                    <Button Name="VendorOpenAiBtn" Grid.Column="2" Classes="Secondary" Margin="2" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" Cursor="Hand" Content="OpenAI"/>
                                </Grid>
                                <TextBlock Name="VendorCapabilityHint"
                                           Text="★ Recommended — Google Gemini watches video + hears audio and has a free tier. Claude and OpenAI read sampled video stills (no audio)."
                                           Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- STEP 1: Get Your Key -->
                        <Border Background="{DynamicResource AppSurfaceSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="12" Width="24" Height="24">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                    <TextBlock Name="Step1Title" Text="Step 1: Get your key" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Name="Step1Lead" Text="Follow these quick steps:" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}"/>

                                <StackPanel Margin="10,0,0,0" Spacing="4">
                                    <TextBlock Name="Step1Line1" Text="1. Sign in with any Google account." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}"/>
                                    <TextBlock Name="Step1Line2" Text="2. Click the button to Create API Key." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}"/>
                                    <TextBlock Name="Step1Line3" Text="3. Select 'Create in new project'." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}"/>
                                    <TextBlock Name="Step1Line4" Text="4. Click the copy icon next to your generated key." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}"/>
                                </StackPanel>

                                <Button Name="OpenAiStudioBtn" Classes="Primary" Content="Get a Google Gemini key" Cursor="Hand" Margin="0,4,0,0"
                                        ToolTip.Tip="Opens the company's key page in your default web browser."/>
                            </StackPanel>
                        </Border>

                        <!-- STEP 2: Paste Key, Choose Model & Verify -->
                        <Border Background="{DynamicResource AppSurfaceSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="12" Width="24" Height="24">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="Step 2: Paste key, pick model, and verify" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4,0,0">
                                    <TextBox Name="ApiKeyInputBox" PasswordChar="•" Watermark="Paste your API key here..."
                                             AutomationProperties.Name="API Key"
                                             Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,6,0"/>
                                    <ToggleButton Name="WizardRevealKeyBtn" Grid.Column="1" Classes="Secondary" Content="Show" Cursor="Hand" Margin="0,0,8,0"
                                                  ToolTip.Tip="Show or hide your pasted API key"/>
                                    <Button Name="TestAndSaveBtn" Grid.Column="2" Classes="Success" Content="Test &amp; Save" Cursor="Hand"
                                            ToolTip.Tip="Checks the key with the AI provider, loads available models, then saves encrypted."/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Text="Model:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               FontWeight="SemiBold" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <ComboBox Name="WizardModelCombo" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,8,0"
                                              ToolTip.Tip="Model used by default with this provider (you can also customize per feature in Settings › AI)."/>
                                    <Button Name="WizardRefreshModelsBtn" Grid.Column="2" Classes="Secondary" Content="Refresh Models" Cursor="Hand"
                                            ToolTip.Tip="Ask this AI provider for the live list of models your key can use."/>
                                </Grid>
                                <TextBlock Name="WizardModelHintText"
                                           Text="Recommended model is pre-selected. You can switch models anytime here or in Settings › AI."
                                           Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap"/>

                                <ProgressBar Name="WizardProgressBar" IsIndeterminate="True" Height="4" IsVisible="False" Margin="0,2,0,0"/>
                                <TextBlock Name="WizardVerboseStepText" Text="" IsVisible="False"
                                           Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap"/>
                                <TextBlock Name="VerificationStatusLabel" Text="Paste your key and click Test &amp; Save."
                                           Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- STEP 3: Ready Action -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,10,0,0">
                            <Button Name="CancelWizardBtn" Classes="Secondary" Content="CANCEL" MinWidth="100" Cursor="Hand" IsCancel="True"/>
                            <Button Name="StartAiZoomBtn" Classes="Success" Content="CONTINUE" MinWidth="160" Cursor="Hand" IsEnabled="False" IsDefault="True"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>