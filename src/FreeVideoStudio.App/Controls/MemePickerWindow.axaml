<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FreeVideoStudio.App.Controls"
        xmlns:vm="clr-namespace:FreeVideoStudio.App.ViewModels"
        x:DataType="vm:MemeChoiceViewModel"
        x:Class="FreeVideoStudio.App.Controls.MemePickerWindow"
        Title="Choose a meme"
        MinWidth="860" MinHeight="560" Width="1060" Height="760"
        Background="{DynamicResource AppSurfaceBrush}"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <Window.Styles>
        <Style Selector="Button.MemeCard">
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.MemeCard.Selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
        <Style Selector="Button.MemeOption">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.MemeOption.Selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="ListBox#MemeList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox#MemeList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox#MemeList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.MemeTile">
            <Setter Property="Width" Value="168"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.MemeTile.Selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Background="{DynamicResource AppSurfaceBrush}" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="3">
            <Grid RowDefinitions="30, Auto, *, Auto">
                <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Choose a meme" Classes="WindowTitleText" Foreground="{DynamicResource TitleBarForeground}" />
                        <Button Grid.Column="1" Name="CancelBtn" Content="✕" IsCancel="True" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="12,0" VerticalAlignment="Stretch"
                                Foreground="{DynamicResource TitleBarForeground}" FontSize="{DynamicResource AppFontSize14}"
                                AutomationProperties.Name="Close" ToolTip.Tip="Close without adding a meme (Esc)."/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="15,10,15,8" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Name="SearchBox" Watermark="Type to search… (arrows to pick, Enter to add, Esc to close)" MinHeight="32"/>
                        <Button Grid.Column="1" Classes="Secondary" Content="⬇ Get more memes" Margin="8,0,0,0" Cursor="Hand"
                                Command="{CompiledBinding DownloadCommand}"
                                ToolTip.Tip="Downloads every meme from the free online library (videos and pictures). Memes you already have are kept as they are."/>
                    </Grid>
                    <TextBlock Name="EmptyText" IsVisible="False" TextWrapping="Wrap"
                               FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppWarningBrush}"
                               Text="No memes to show. Press ⬇ Get more memes to download the free meme library."/>
                    <TextBlock Name="StatusText" IsVisible="False" TextWrapping="Wrap"
                               FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                </StackPanel>

                <Grid Grid.Row="2" ColumnDefinitions="*,12,400" Margin="15,0,15,0">
                    <ListBox Grid.Column="0" Name="MemeList"
                             Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.DataTemplates>
                            <DataTemplate x:DataType="local:MemeGalleryHeader">
                                <TextBlock Text="{CompiledBinding Text}" FontWeight="Bold" Margin="2,10,0,6"
                                           FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            </DataTemplate>
                            <DataTemplate x:DataType="local:MemeGalleryTiles">
                                <ItemsControl ItemsSource="{CompiledBinding Tiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:MemePickerRow">
                                            <Button Classes="MemeTile" Classes.Selected="{CompiledBinding IsSelected}"
                                                    Command="{CompiledBinding SelectCommand}" ToolTip.Tip="{CompiledBinding Tip}">
                                                <StackPanel Spacing="4">
                                                    <Panel Height="90">
                                                        <Border CornerRadius="5" ClipToBounds="True" Background="{DynamicResource AppSurfaceBrush}">
                                                            <Panel>
                                                                <TextBlock Text="{CompiledBinding KindIcon}" FontSize="{DynamicResource AppFontSize16}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           IsVisible="{CompiledBinding !HasThumbnail}"/>
                                                                <Image Source="{CompiledBinding Thumbnail}" Stretch="UniformToFill"
                                                                       IsVisible="{CompiledBinding HasThumbnail}"/>
                                                            </Panel>
                                                        </Border>
                                                        <Border Background="{DynamicResource AppScrimStrongBrush}" CornerRadius="4" Padding="5,1" Margin="4"
                                                                HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock Text="{CompiledBinding BadgeText}" Foreground="{DynamicResource AppOnOverlayTextBrush}" FontWeight="Bold"
                                                                       FontSize="{DynamicResource AppFontSize10}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource AppScrimStrongBrush}" CornerRadius="4" Padding="4,0" Margin="4"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{CompiledBinding HasWarning}">
                                                            <TextBlock Text="⚠" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize11}"/>
                                                        </Border>
                                                        <Button Classes="Secondary" Padding="6,0" Margin="2" Cursor="Hand"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Content="{CompiledBinding StarText}" Command="{CompiledBinding ToggleFavoriteCommand}"
                                                                ToolTip.Tip="Favourite: favourites are listed first."/>
                                                    </Panel>
                                                    <TextBlock Text="{CompiledBinding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                               Height="34" Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                               FontSize="{DynamicResource AppFontSize11}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>

                    <TextBlock Grid.Column="2" IsVisible="{CompiledBinding !HasMeme}" Text="Pick a meme on the left to see where it will play."
                               TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                    <ScrollViewer Grid.Column="2" IsVisible="{CompiledBinding HasMeme}"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8" Margin="0,0,10,8">
                            <TextBlock Text="{CompiledBinding Summary}" TextWrapping="Wrap"/>
                            <TextBlock Text="The meme file is missing. You can still change how it plays, or pick another meme to replace it."
                                       IsVisible="{CompiledBinding FileMissing}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize11}"/>
                            <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="6" Padding="6" Height="230">
                                <local:MemePlacementPreview MemePath="{CompiledBinding MemePath}"
                                                            Portrait="{CompiledBinding PreviewPortrait}"
                                                            IsCorner="{CompiledBinding IsCorner}"
                                                            Corner="{CompiledBinding Corner, Mode=TwoWay}"
                                                            Size="{CompiledBinding Size}"
                                                            PosX="{CompiledBinding PosX, Mode=TwoWay}"
                                                            PosY="{CompiledBinding PosY, Mode=TwoWay}"
                                                            ClipInSec="{CompiledBinding ClipInSeconds}"
                                                            LengthSec="{CompiledBinding LengthSeconds}"
                                                            Animation="{CompiledBinding Animation}"
                                                            IsPlaying="{CompiledBinding IsPlaying}"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Button Classes="Secondary" Content="{CompiledBinding PlayButtonText}" Command="{CompiledBinding TogglePlayCommand}" Cursor="Hand"
                                        ToolTip.Tip="Play or pause the silent preview."/>
                                <Button Name="OpenWithSoundBtn" Classes="Secondary" Content="Preview result" Cursor="Hand"
                                        ToolTip.Tip="Preview your video with this meme, music, sound and effects."/>
                                <CheckBox VerticalAlignment="Center" Content="Play meme sound" IsVisible="{CompiledBinding IsVideo}"
                                          IsChecked="{CompiledBinding PlaySound}" Foreground="{DynamicResource AppTextPrimaryBrush}"
                                          ToolTip.Tip="Off = the meme plays silently. In a corner the game sound gets quieter while the meme's sound plays."/>
                            </StackPanel>
                            <TextBlock Text="{CompiledBinding PositionText}" IsVisible="{CompiledBinding IsCorner}" TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="{DynamicResource AppFontSize10}" Foreground="{DynamicResource AppTextMutedBrush}"/>

                            <Grid ColumnDefinitions="*,8,*" IsVisible="{CompiledBinding ShowModeCards}">
                                <Button Grid.Column="0" Classes="MemeCard" Classes.Selected="{CompiledBinding IsFullScreen}"
                                        Command="{CompiledBinding FullScreenCommand}"
                                        ToolTip.Tip="The gameplay pauses, the meme fills the screen, then the gameplay carries on from the exact frame it stopped on.">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="FULL SCREEN" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Pauses the game" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="{CompiledBinding FullScreenLengthText}" FontSize="{DynamicResource AppFontSize10}" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="MemeCard" Classes.Selected="{CompiledBinding IsCorner}"
                                        Command="{CompiledBinding CornerCommand}"
                                        ToolTip.Tip="The meme plays in a corner on top of the gameplay. Nothing pauses and nothing after it moves.">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="IN A CORNER" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Game keeps playing" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Same video length" FontSize="{DynamicResource AppFontSize10}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,8,*,8,*">
                                <Button Grid.Column="0" Classes="MemeCard" Classes.Selected="{CompiledBinding IsAtStart}"
                                        Command="{CompiledBinding AtStartCommand}"
                                        ToolTip.Tip="Place the meme at the beginning.">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="START" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="At the beginning" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="MemeCard" Classes.Selected="{CompiledBinding IsAtHere}" Command="{CompiledBinding AtHereCommand}" Content="HERE" ToolTip.Tip="At the video cursor."/>
                                <Button Grid.Column="4" Classes="MemeCard" Classes.Selected="{CompiledBinding IsAtEnd}"
                                        Command="{CompiledBinding AtEndCommand}"
                                        ToolTip.Tip="Full screen: after the gameplay. Corner: finishes with the gameplay.">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="END" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="{CompiledBinding EndPlacementText}" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,8,*" IsVisible="{CompiledBinding ShowMusicChoice}">
                                <Button Grid.Column="0" Classes="MemeOption" Classes.Selected="{CompiledBinding MusicContinues}"
                                        HorizontalAlignment="Stretch" Content="🎵 Music continues to play"
                                        Command="{CompiledBinding MusicContinueCommand}"
                                        ToolTip.Tip="Your background music keeps playing under this meme. Remembered for this meme."/>
                                <Button Grid.Column="2" Classes="MemeOption" Classes.Selected="{CompiledBinding MusicStops}"
                                        HorizontalAlignment="Stretch" Content="🔇 Music stops!"
                                        Command="{CompiledBinding MusicStopCommand}"
                                        ToolTip.Tip="Your background music goes quiet while this meme plays. Remembered for this meme."/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{CompiledBinding IsCorner}">
                                <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                <Button Classes="MemeOption" Classes.Selected="{CompiledBinding IsSmall}" Content="Small" Command="{CompiledBinding SmallCommand}"/>
                                <Button Classes="MemeOption" Classes.Selected="{CompiledBinding IsMedium}" Content="Medium" Command="{CompiledBinding MediumCommand}"/>
                                <Button Classes="MemeOption" Classes.Selected="{CompiledBinding IsLarge}" Content="Large" Command="{CompiledBinding LargeCommand}"/>
                            </StackPanel>
                            <Expander Header="{CompiledBinding MoreOptionsHeader}" HorizontalAlignment="Stretch" IsExpanded="False"
                                      IsVisible="{CompiledBinding ShowModeCards}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Drag the two handles to keep just the part you want." IsVisible="{CompiledBinding HasVideoLength}" TextWrapping="Wrap"/>
                                    <local:MemePartRange IsVisible="{CompiledBinding HasVideoLength}" AutomationProperties.Name="Meme part: Space switches handle, arrows adjust"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Shows for" VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{CompiledBinding IsImage}"
                                                   FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <TextBlock Text="Start at" VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{CompiledBinding HasVideoLength}"
                                                   FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <NumericUpDown Value="{CompiledBinding ClipInSec, Mode=TwoWay}" Minimum="0" Maximum="{CompiledBinding MaxClipInSec}"
                                                       Increment="0.1" FormatString="0.0" MinWidth="100" IsVisible="{CompiledBinding HasVideoLength}"
                                                       ToolTip.Tip="Seconds into the meme video where it starts playing."/>
                                        <TextBlock Text="s   Length" VerticalAlignment="Center" Margin="6,0" IsVisible="{CompiledBinding HasVideoLength}"
                                                   FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <NumericUpDown Value="{CompiledBinding LengthSec, Mode=TwoWay}" Minimum="{CompiledBinding MinLengthSec}" Maximum="{CompiledBinding MaxLengthSec}"
                                                       Increment="0.1" FormatString="0.0" MinWidth="100"
                                                       ToolTip.Tip="How long the meme plays. A picture can show for 1 to 10 seconds; a video for any part of itself."/>
                                        <TextBlock Text="s" VerticalAlignment="Center" Margin="6,0" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <Button Classes="Secondary" Content="Reset" Command="{CompiledBinding ResetPartCommand}" Cursor="Hand"
                                                ToolTip.Tip="Back to the whole video (or 4 seconds for a picture)."/>
                                    </WrapPanel>
                                    <TextBlock Text="{CompiledBinding PartText}" TextWrapping="Wrap"
                                               FontSize="{DynamicResource AppFontSize10}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{CompiledBinding IsFullScreen}">
                                        <TextBlock Text="In and out" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <Button Classes="MemeOption" Classes.Selected="{CompiledBinding IsTransCut}" Content="Cut" Command="{CompiledBinding TransCutCommand}" ToolTip.Tip="Straight cut to the meme and back."/>
                                        <Button Classes="MemeOption" Classes.Selected="{CompiledBinding IsTransFade}" Content="Fade" Command="{CompiledBinding TransFadeCommand}" ToolTip.Tip="A quick dip to black into and out of the meme."/>
                                        <Button Classes="MemeOption" Classes.Selected="{CompiledBinding IsTransZoom}" Content="Zoom punch" Command="{CompiledBinding TransZoomCommand}" ToolTip.Tip="The meme punches in slightly zoomed and settles."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{CompiledBinding IsCorner}">
                                        <TextBlock Text="Appears" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <Button Classes="MemeOption" Classes.Selected="{CompiledBinding IsAnimNone}" Content="Pop" Command="{CompiledBinding AnimNoneCommand}" ToolTip.Tip="Just appears and disappears."/>
                                        <Button Classes="MemeOption" Classes.Selected="{CompiledBinding IsAnimFade}" Content="Fade" Command="{CompiledBinding AnimFadeCommand}" ToolTip.Tip="Fades in and out."/>
                                        <Button Classes="MemeOption" Classes.Selected="{CompiledBinding IsAnimSlide}" Content="Slide" Command="{CompiledBinding AnimSlideCommand}" ToolTip.Tip="Slides in from the side and back out."/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,12,0,14">
                        <TextBlock Text="{CompiledBinding LandingText}" MaxWidth="360" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Name="UseBtn" Classes="Success" Content="{CompiledBinding AddButtonText}" MinWidth="200" Cursor="Hand" IsDefault="True" IsEnabled="False"
                                ToolTip.Tip="Put this meme in the video (Enter)."/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
