<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        x:Class="FreeVideoStudio.App.Controls.FinishedDialogWindow"
        Title="Done! Video Processed Successfully!"
        MinWidth="860" MinHeight="500" MaxWidth="1100" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        CanResize="True"
        Topmost="False"
        Background="{DynamicResource AppSurfaceBrush}">

    <!-- BTNDEPTH_01 — ONE BUTTON LOOK FOR THE WHOLE DIALOG.
         The NEXT STEPS row already read as raised and rounded; the SHARE DIRECTLY row did not,
         because each social button overrode CornerRadius to 6 (against the app-wide 10) and its
         brand style set a flat Background with no BorderBrush, so the shared 1,1,1,2 bottom-heavy
         border had nothing to darken against. These window-scoped styles give every button in the
         dialog the same corner radius, the same seated bottom edge and the same height.
         HEIGHT ONLY — no MinWidth is touched here, so the two rows keep their existing widths
         (150 for social, 180 for actions) exactly as they were. -->
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="1,1,1,3"/>
        </Style>
        <!-- The brand buttons carry no border of their own; without one the extra-thick bottom
             edge would be invisible and they would still look flat next to NEXT STEPS. -->
        <Style Selector="Button.WhatsApp, Button.Instagram, Button.YouTube, Button.TikTok">
            <Setter Property="BorderBrush" Value="{DynamicResource AppSecondaryDeepBorderBrush}"/>
        </Style>
        <!-- The close X stays its own small square control. -->
        <Style Selector="Button.CloseBtn">
            <Setter Property="MinHeight" Value="{DynamicResource AppCloseBtnSize}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>

    
    <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2" CornerRadius="14" Margin="20" Cursor="SizeAll" PointerPressed="OnRootPointerPressed">
        <Panel>
            <Grid Margin="28,18,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Button Grid.Row="0" HorizontalAlignment="Right"
                    Classes="CloseBtn" Content="✕"
                    AutomationProperties.Name="Close dialog"
                    ToolTip.Tip="Close dialog"
                    Click="OnCloseClicked" />
            
            <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="MessageText"
                           Text="File successfully saved to:&#x0a;..."
                           FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"
                           TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                <!-- Music Credit Reminder Card -->
                <Border Name="AttributionCard" IsVisible="False" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,10" MaxWidth="720" HorizontalAlignment="Center">
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚠️" FontSize="{DynamicResource AppFontSize14}" VerticalAlignment="Center"/>
                            <TextBlock Text="MUSIC CREDIT REQUIRED TO AVOID MUTE" FontWeight="Bold" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="To prevent YouTube or TikTok from muting your video: copy this credit and paste into your video Description / Caption." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" Margin="0,4,12,0" TextWrapping="Wrap"/>
                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Name="FinishedCopyCreditBtn" Classes="Primary" Padding="14,8" VerticalAlignment="Center" Content="📋 COPY CREDIT" ToolTip.Tip="Copy the attribution credit to clipboard." Click="OnCopyCreditClicked"/>
                    </Grid>
                </Border>
                <!-- Modern Viral Post Helper Card -->
                <Border Name="ViralPostCard" IsVisible="False" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,10" MaxWidth="720" HorizontalAlignment="Center">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="✨" FontSize="{DynamicResource AppFontSize14}" VerticalAlignment="Center"/>
                                <TextBlock Text="VIRAL POST HELPER (2026 EDITION)" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" FontSize="{DynamicResource AppFontSize12}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource AppSurfaceSubtleBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Name="ViralPostStatusBadge" Text="AI GENERATED" FontSize="{DynamicResource AppFontSize10}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Title Row -->
                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                            <TextBlock Text="TITLE:" FontWeight="Bold" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Name="ViralTitleTextBox" Grid.Column="1" IsReadOnly="True" FontSize="{DynamicResource AppFontSize12}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Name="CopyViralTitleBtn" Grid.Column="2" Classes="Primary" MinHeight="36" Padding="12,6" Content="📋 COPY TITLE" ToolTip.Tip="Copy viral title to clipboard." Click="OnCopyViralTitleClicked"/>
                        </Grid>

                        <!-- Caption & Tags Row -->
                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                            <TextBlock Text="CAPTION &amp; TAGS:" FontWeight="Bold" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Name="ViralDescriptionTextBox" Grid.Column="1" IsReadOnly="True" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap" MaxHeight="60" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Name="CopyViralDescBtn" Grid.Column="2" Classes="Primary" MinHeight="36" Padding="12,6" Content="📋 COPY CAPTION" ToolTip.Tip="Copy caption and hashtags to clipboard." Click="OnCopyViralDescriptionClicked"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <Grid Grid.Row="2" Margin="0,24,0,0" RowDefinitions="Auto,24,Auto" HorizontalAlignment="Center">
                <!-- Social Share Row -->
                <StackPanel Grid.Row="0" Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="SHARE DIRECTLY" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Click="OnWhatsAppClicked" Classes="WhatsApp" MinWidth="150" ToolTip.Tip="Share to WhatsApp">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="💬" FontFamily="Segoe UI Emoji" FontSize="{DynamicResource AppFontSize18}" VerticalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="WHATSAPP" FontWeight="Bold" FontSize="{DynamicResource AppFontSize12}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnInstagramClicked" Classes="Instagram" MinWidth="150" ToolTip.Tip="Share to Instagram">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📷" FontFamily="Segoe UI Emoji" FontSize="{DynamicResource AppFontSize18}" VerticalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="INSTAGRAM" FontWeight="Bold" FontSize="{DynamicResource AppFontSize12}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnYouTubeClicked" Classes="YouTube" MinWidth="150" ToolTip.Tip="Share to YouTube">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="▶" FontFamily="Segoe UI Emoji" FontSize="{DynamicResource AppFontSize18}" VerticalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="YOUTUBE" FontWeight="Bold" FontSize="{DynamicResource AppFontSize12}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnTikTokClicked" Classes="TikTok" MinWidth="150" ToolTip.Tip="Share to TikTok">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎵" FontFamily="Segoe UI Emoji" FontSize="{DynamicResource AppFontSize18}" VerticalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="TIKTOK" FontWeight="Bold" FontSize="{DynamicResource AppFontSize12}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Actions Row -->
                <StackPanel Grid.Row="2" Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="NEXT STEPS" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                        <Button Content="OPEN FOLDER"
                                Click="OnOpenFolderClicked" MinWidth="180"
                                Classes="Primary" FontWeight="Bold" Cursor="Hand"
                                ToolTip.Tip="Open the folder containing your saved video in Windows Explorer."
                                AutomationProperties.Name="Open containing folder in Windows Explorer"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Content="NEW FILE"
                                Click="OnUploadNewClicked" MinWidth="180"
                                Classes="Secondary" FontWeight="Bold" Cursor="Hand"
                                ToolTip.Tip="Start a new video editing project from scratch."
                                AutomationProperties.Name="Start a new video editing project"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Content="EXIT APP"
                                Click="OnExitClicked" MinWidth="180"
                                Classes="Danger" FontWeight="Bold" Cursor="Hand"
                                ToolTip.Tip="Close the application and end your session."
                                AutomationProperties.Name="Exit application"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
        <!-- Bottom-right resize grip -->
        <Border Name="ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"/>
    </Panel>
</Border>
</Window>




