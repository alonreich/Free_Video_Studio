<!-- AUTO-UPDATE — transient, non-persisted modal, so it takes the same CenterOwner exemption
     as ConfirmDialogWindow (see the ISSUE_06 note there). Do NOT add it to WindowBoundsHelper.
     The four answers are stacked vertically in importance order: the recommended action first,
     "Remind me later" second (UPDATEUX_01), and the two quieter long-term choices below a
     separator. All state is bound to UpdateAvailableViewModel (MVVM_01). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:vm="clr-namespace:FreeVideoStudio.App.ViewModels"
        x:DataType="vm:UpdateAvailableViewModel"
        x:Class="FreeVideoStudio.App.Controls.UpdateAvailableWindow"
        Title="Update Available"
        Width="580" SizeToContent="Height"
        MinHeight="280"
        Background="{DynamicResource AppSurfaceBrush}"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <Grid>
        <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0"
                BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="3">
            <Grid RowDefinitions="30, *, Auto">
                <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="DialogTitle" Text="Update Available" Classes="WindowTitleText"
                               Foreground="{DynamicResource TitleBarForeground}"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="25,20,25,10" Spacing="10">
                    <TextBlock Text="A new version of this app was released!"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Would you like to download and install it?" IsVisible="{Binding CanInstallItself}"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               FontSize="{DynamicResource AppFontSize13}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel HorizontalAlignment="Center" Margin="0,6,0,4" Spacing="3">
                        <TextBlock Text="{Binding YourVersion}" Foreground="{DynamicResource AppTextMutedBrush}"
                                   FontSize="{DynamicResource AppFontSize12}" TextAlignment="Center"/>
                        <TextBlock Text="{Binding NewVersion}" Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   FontSize="{DynamicResource AppFontSize12}" FontWeight="SemiBold" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- UPDATEUX_02 — size and rough time, before the user agrees. UPDATEUX_05 — or why
                         this copy cannot install the update itself. -->
                    <TextBlock Text="{Binding DownloadSizeText}" IsVisible="{Binding CanInstallItself}"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               FontSize="{DynamicResource AppFontSize12}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DownloadSizeText}" IsVisible="{Binding CannotInstallItself}"
                               Foreground="{DynamicResource AppWarningBrush}"
                               FontSize="{DynamicResource AppFontSize12}"
                               TextAlignment="Center" TextWrapping="Wrap"/>

                    <!-- Scrollable release notes fetched from GitHub release notes / body -->
                    <Expander Header="What's New in this Release"
                              IsExpanded="{Binding HasNotes, Mode=OneTime}" MaxHeight="240" Margin="0,5,0,0"
                              Background="{DynamicResource AppPanelBrush}"
                              Foreground="{DynamicResource AppTextPrimaryBrush}"
                              BorderBrush="{DynamicResource AppBorderBrush}"
                              BorderThickness="1" CornerRadius="6">
                        <Expander.Styles>
                            <Style Selector="Expander">
                                <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                            <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
                                <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,8"/>
                            </Style>
                            <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
                                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                            </Style>
                            <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked">
                                <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                            </Style>
                        </Expander.Styles>
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,10"
                                Margin="4,2,4,4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                                <TextBlock Text="{Binding ReleaseNotes}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource AppFontSize12}"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           LineHeight="18"/>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="25,5,25,25" Spacing="10">
                    <Button Classes="Success" Cursor="Hand" IsDefault="True"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding UpdateNowCommand}"
                            AutomationProperties.Name="Download and install the new version now"
                            ToolTip.Tip="Downloads the new version, keeps every setting exactly as it is, installs it and reopens the app. Windows will still ask once for Administrator permission.">
                        <TextBlock Text="{Binding UpdateButtonText}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>

                    <!-- UPDATEUX_01 — "not now" is a button, not a hidden Escape key. -->
                    <Button Classes="Secondary" Cursor="Hand" IsCancel="True"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding LaterCommand}"
                            AutomationProperties.Name="Remind me later"
                            ToolTip.Tip="Nothing is downloaded now. The app will offer this update again the next time it starts.">
                        <TextBlock Text="Remind me later." TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>

                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,5,0,0"/>

                    <Button Classes="Secondary" Cursor="Hand"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding SkipCommand}"
                            AutomationProperties.Name="Skip this version"
                            ToolTip.Tip="Stays quiet about this particular version from now on. Any newer version will be announced normally.">
                        <TextBlock Text="Skip this version — only tell me when an even newer one comes out."
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>

                    <Button Classes="Secondary" Cursor="Hand"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding NeverCommand}"
                            AutomationProperties.Name="Never tell me about updates again"
                            ToolTip.Tip="Turns update checking off completely. You can turn it back on any time in Settings.">
                        <TextBlock Text="Never tell me about updates again."
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
