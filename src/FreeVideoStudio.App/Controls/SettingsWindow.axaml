<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeVideoStudio.App.Controls"
        xmlns:vm="clr-namespace:FreeVideoStudio.App.ViewModels"
        x:CompileBindings="True"
        x:DataType="controls:SettingsWindow"
        x:Class="FreeVideoStudio.App.Controls.SettingsWindow"
        Title="Settings"
        Width="900" Height="720"
        MinWidth="800" MinHeight="600"
        Background="{DynamicResource AppSurfaceBrush}"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowStartupLocation="CenterOwner">
    <!-- ISSUE_09 (audit round 4): Topmost="True" removed — Settings floated above every OTHER
         application on the OS. It now yields to other apps like the rest of the 8 tracked windows.

         SETTINGSIA_01 (settings audit, 28 items): 10 tabs became 6 + About. Every value is BOUND to
         SettingsViewModel (SETTINGSVM_01) and is pending until SAVE; CANCEL / Esc / ✕ ask before
         throwing changes away (SETUNSAVED_01). SETWIDTH_01: every page shares one width
         (Classes="Page", 680px) and no button has a fixed Width, so labels never get cut off.
         SETCENTER_01: the first open (no saved bounds) is centred on the window that opened it;
         WindowBoundsHelper switches to Manual once bounds are saved.
         SETDECLUTTER_01 (settings round 4): one control per idea, every page one centred column. -->
    <Window.Styles>
        <Style Selector="StackPanel.Page">
            <Setter Property="Margin" Value="12,10,16,16"/>
            <Setter Property="Spacing" Value="10"/>
            <Setter Property="MaxWidth" Value="680"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.H1">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize16}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style Selector="TextBlock.Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize11}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- SETTIPS_01 — the ⓘ beside a label; hover the row to read the plain-English help. -->
        <Style Selector="TextBlock.Info">
            <Setter Property="Text" Value="ⓘ"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Help"/>
        </Style>
        <Style Selector="StackPanel.LabelRow">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- SETLABELFIT_01 — label columns are Auto (they were fixed 200/260px, and a horizontal LabelRow never
             wraps, so at the larger text sizes labels were cut off). MinWidth keeps the controls of the rows
             lined up at normal size; the column grows with the text size instead of clipping. -->
        <Style Selector="Grid > StackPanel.LabelRow">
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.SearchHit">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
    </Window.Styles>
    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, Auto, *, Auto">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- SETSEARCH_01 — instant search across every tab. -->
                <TextBox Grid.Row="1" Name="SettingsSearchBox" Margin="15,12,15,0" MaxWidth="680" HorizontalAlignment="Center" MinWidth="420"
                         Watermark="🔍  Search settings (for example: music, keys, folder, update)…"
                         AutomationProperties.Name="Search settings"
                         ToolTip.Tip="Type a word to find a setting. Click a result to jump straight to it. Press Esc to clear."/>

                <Grid Grid.Row="2" Margin="15,8,15,0">
                    <TabControl Name="SettingsTabControl" Background="Transparent">

                        <!-- ═════════════════════════ GENERAL ═════════════════════════ -->
                        <TabItem Header="General" Name="GeneralTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Classes="Page">
                                    <TextBlock Classes="H1" Text="Look" Margin="0,4,0,0"/>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                        <StackPanel Classes="LabelRow" ToolTip.Tip="The colours of the whole app.&#x0a;&#x0a;Dark: light text on a dark background (easy on the eyes, best for video).&#x0a;Light: dark text on a white background.&#x0a;Match Windows: follows the light/dark choice in your Windows settings.&#x0a;&#x0a;You see the change right away. CANCEL puts the old colours back.">
                                            <TextBlock Classes="Label" Text="Colours"/>
                                            <TextBlock Classes="Info"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Name="ThemeComboBox" MinWidth="220" HorizontalAlignment="Left"
                                                  ItemsSource="{x:Static vm:SettingsViewModel.ThemeChoices}"
                                                  SelectedIndex="{Binding Vm.ThemeIndex, Mode=TwoWay}"
                                                  AutomationProperties.Name="Colours"
                                                  ToolTip.Tip="Dark, Light, or the same as Windows."/>

                                        <StackPanel Grid.Row="1" Classes="LabelRow" ToolTip.Tip="Makes ALL the words in the app bigger or smaller.&#x0a;&#x0a;Press A+ for bigger text, A– for smaller text. Normal is the out-of-the-box size.&#x0a;You see the change right away. CANCEL puts the old size back.">
                                            <TextBlock Classes="Label" Text="Text size"/>
                                            <TextBlock Classes="Info"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Name="FontSmallerBtn" Classes="Secondary" Content="A–" MinWidth="44" Command="{Binding Vm.DecreaseFontCommand}" IsEnabled="{Binding Vm.CanDecreaseFont}" AutomationProperties.Name="Smaller text" ToolTip.Tip="Smaller text"/>
                                            <Border Classes="Card" Padding="10,6" MinWidth="120">
                                                <TextBlock Name="FontScaleLabel" Text="{Binding Vm.FontScaleLabel}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            </Border>
                                            <Button Name="FontBiggerBtn" Classes="Secondary" Content="A+" MinWidth="44" Command="{Binding Vm.IncreaseFontCommand}" IsEnabled="{Binding Vm.CanIncreaseFont}" AutomationProperties.Name="Bigger text" ToolTip.Tip="Bigger text"/>
                                            <TextBlock Text="Sample text Aa" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,8,0,0"/>
                                    <!-- SETUPDATEONE_01 — one 3-way choice (was two dependent check boxes + a Stable/Beta pair, SETNOBETA_01). -->
                                    <StackPanel Classes="LabelRow" ToolTip.Tip="How the app keeps itself up to date. It asks GitHub (where the app is published) a few minutes after it opens, and every few hours while it stays open.&#x0a;&#x0a;Download automatically: a new version downloads by itself while you work, ready to install when you are.&#x0a;Just tell me: the app only says a new version exists.&#x0a;Never check: the app never checks by itself. You can still press 'Check for updates now' on the About tab.">
                                        <TextBlock Classes="H1" Text="Updates" Margin="0"/>
                                        <TextBlock Classes="Info"/>
                                    </StackPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <RadioButton GroupName="UpdateMode" Name="UpdateAutoRadio" Content="Download automatically" IsChecked="{Binding Vm.UpdateAuto, Mode=TwoWay}"/>
                                        <RadioButton GroupName="UpdateMode" Name="UpdateNotifyRadio" Content="Just tell me" IsChecked="{Binding Vm.UpdateNotify, Mode=TwoWay}"/>
                                        <RadioButton GroupName="UpdateMode" Name="UpdateNeverRadio" Content="Never check" IsChecked="{Binding Vm.UpdateNever, Mode=TwoWay}"/>
                                    </WrapPanel>

                                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,8,0,0"/>
                                    <!-- AUDIO_06 / SETCLICKONE_01 — one slider: all the way left = off. -->
                                    <TextBlock Classes="H1" Text="Click sounds"/>
                                    <Grid ColumnDefinitions="*, Auto" MaxWidth="480" HorizontalAlignment="Left">
                                        <Slider Name="UiSoundVolumeSlider" Grid.Column="0" Minimum="0" Maximum="100" MinWidth="240" MaxWidth="400" MinHeight="44"
                                                Value="{Binding Vm.UiSoundVolume, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"
                                                AutomationProperties.Name="Click sound volume"
                                                ToolTip.Tip="The small clicks and chimes the app plays when you press a button. Slide all the way left to turn them off.&#x0a;They only come out of your speakers while you work. They are NEVER in your exported video, and they are muted while you record a voice-over."/>
                                        <TextBlock Name="UiSoundVolumeLabel" Grid.Column="1" Text="{Binding Vm.UiSoundVolumeLabel}" Foreground="{DynamicResource AppTextMutedBrush}" FontWeight="Bold" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>

                                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,8,0,0"/>
                                    <!-- SETBACKUP_01 -->
                                    <TextBlock Classes="H1" Text="Backup"/>
                                    <TextBlock Classes="Hint" Text="Save all your settings to one file, or load them back (for example on a new computer). AI keys are never put in the backup."/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Name="BackupSettingsBtn" Classes="Secondary" Content="Backup Settings…" Click="OnBackupSettings" Cursor="Hand"
                                                ToolTip.Tip="Saves every setting in this window to a file you choose. Your AI keys are left out on purpose."/>
                                        <Button Name="ImportSettingsBtn" Classes="Secondary" Content="Import Settings…" Click="OnImportSettings" Cursor="Hand"
                                                ToolTip.Tip="Loads settings from a backup file. You can look them over first: nothing changes until you press SAVE."/>
                                    </StackPanel>
                                    <TextBlock Name="BackupStatusText" Classes="Hint" Text=""/>

                                    <!-- SETADVANCED_01 — rarely-needed options, folded away. -->
                                    <Expander Name="GeneralAdvancedExpander" Header="Advanced" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                              ToolTip.Tip="Options most people never need to change.">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <StackPanel Classes="LabelRow" ToolTip.Tip="Making the final video is heavy work. A graphics card does it fast; the processor does it slowly.&#x0a;&#x0a;Automatic checks your computer and picks the fastest chip. Leave it on Automatic unless exports are suddenly very slow, then pick your graphics card by name.&#x0a;Chips this computer can't use are greyed out.">
                                                    <TextBlock Classes="Label" Text="Speed up exports with"/>
                                                    <TextBlock Classes="Info"/>
                                                </StackPanel>
                                                <!-- SETCHIPS_01 — chips this PC can't use are greyed out (the saved one always stays pickable). -->
                                                <ComboBox Grid.Column="1" Name="VideoEncoderComboBox" MinWidth="260" HorizontalAlignment="Left"
                                                          ItemsSource="{Binding Vm.EncoderItems}" SelectedIndex="{Binding Vm.EncoderIndex, Mode=TwoWay}"
                                                          AutomationProperties.Name="Speed up exports with"
                                                          ToolTip.Tip="Automatic is recommended.">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:EncoderChoiceItem">
                                                            <TextBlock Text="{Binding Display}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                    <ComboBox.Styles>
                                                        <Style Selector="ComboBoxItem" x:DataType="vm:EncoderChoiceItem">
                                                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                                                        </Style>
                                                    </ComboBox.Styles>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Name="VideoEncoderStatusText" Classes="Hint" Text="{Binding Vm.DetectedChipsLine}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- SETDANGER_01 — destructive actions live here only, behind a confirmation. -->
                                    <Border Name="DangerZoneBorder" Margin="0,18,0,0" BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Danger Zone" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" Foreground="{DynamicResource AppDangerBrush}"/>
                                            <TextBlock Classes="Hint" Text="This cannot be taken back once you press SAVE. It asks first."/>
                                            <Button Name="ResetAllSettingsBtn" Classes="Danger" Content="Reset all settings" Click="OnResetAllSettings" Cursor="Hand" HorizontalAlignment="Left"
                                                    ToolTip.Tip="Puts every setting on every tab back to how it was when the app was installed. Your AI keys are kept."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ═════════════════════════ EDITING ═════════════════════════ -->
                        <TabItem Header="Editing" Name="EditingTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Classes="Page">
                                    <!-- SETGAME_01 — ONE game choice: the crop layout AND the AI camera view. -->
                                    <TextBlock Classes="H1" Text="Your game" Margin="0,4,0,0"/>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <StackPanel Classes="LabelRow" ToolTip.Tip="Pick the game you record. Every game puts its health bar, map and weapons in different places.&#x0a;&#x0a;The app uses this to cut those parts out neatly for phone videos, and the AI camera uses it to know what to follow.&#x0a;'No Mask' means: do not cut anything out.">
                                            <TextBlock Classes="Label" Text="Game"/>
                                            <TextBlock Classes="Info"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Name="MaskOverlayProfileComboBox" MinWidth="260" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding Vm.GameProfiles}" SelectedIndex="{Binding Vm.GameIndex, Mode=TwoWay}"
                                                  AutomationProperties.Name="Game"
                                                  ToolTip.Tip="The game you record. Changes the cut-out layout and the AI camera."/>
                                    </Grid>

                                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,8,0,0"/>
                                    <!-- SETSTARTONE_01 — one choice for how every new video starts. -->
                                    <StackPanel Classes="LabelRow" ToolTip.Tip="What a freshly opened video starts with.&#x0a;&#x0a;Like my last video: speed, quality, phone format, teammates and fades start the way your last exported video was made.&#x0a;With my defaults: they always start with the values below.">
                                        <TextBlock Classes="H1" Text="New videos start" Margin="0"/>
                                        <TextBlock Classes="Info"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="StartMode" Name="StartLikeLastRadio" Content="Like my last video" IsChecked="{Binding Vm.StartLikeLast, Mode=TwoWay}"/>
                                        <RadioButton GroupName="StartMode" Name="StartDefaultsRadio" Content="With my defaults" IsChecked="{Binding Vm.StartWithDefaults, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" Margin="28,0,0,0" IsEnabled="{Binding Vm.StartWithDefaults}">
                                        <StackPanel Classes="LabelRow" ToolTip.Tip="How fast a new video plays.&#x0a;1.0x is real speed, 1.1x is a little faster (good for gameplay), 2.0x is double speed.">
                                            <TextBlock Classes="Label" Text="Speed"/>
                                            <TextBlock Classes="Info"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" MaxWidth="360" HorizontalAlignment="Left">
                                            <Slider Name="DefaultSpeedSlider" Minimum="0.1" Maximum="4.0" TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="0.5" MinWidth="200"
                                                    Value="{Binding Vm.DefaultSpeed, Mode=TwoWay}" AutomationProperties.Name="Starting speed" ToolTip.Tip="Drag to pick the starting speed (0.1x to 4.0x)."/>
                                            <TextBlock Grid.Column="1" Text="{Binding Vm.DefaultSpeedLabel}" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Classes="LabelRow" ToolTip.Tip="How sharp the finished video looks. Sharper = bigger file.">
                                            <TextBlock Classes="Label" Text="Quality"/>
                                            <TextBlock Classes="Info"/>
                                        </StackPanel>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Name="QualityCombo" MinWidth="200" HorizontalAlignment="Left" ItemsSource="{Binding Vm.QualityNames}" SelectedIndex="{Binding Vm.QualityIndex, Mode=TwoWay}" AutomationProperties.Name="Starting quality" ToolTip.Tip="The quality every new video starts on."/>

                                        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                            <CheckBox Name="DefaultPortraitCheckBox" Content="Phone format (9:16)" Margin="0,0,18,0" IsChecked="{Binding Vm.DefaultPortrait, Mode=TwoWay}"
                                                      ToolTip.Tip="Makes a tall video for TikTok, Shorts and Reels."/>
                                            <CheckBox Name="DefaultTeammatesCheckBox" Content="Show teammates" Margin="0,0,18,0" IsChecked="{Binding Vm.DefaultTeammates, Mode=TwoWay}"
                                                      ToolTip.Tip="Keeps your teammates' names and health bars in the video. Games with 'No Mask' never show them."/>
                                            <CheckBox Name="DefaultFadeCheckBox" Content="Fade in and out" IsChecked="{Binding Vm.DefaultFade, Mode=TwoWay}"
                                                      ToolTip.Tip="The video gently fades from black at the start and back to black at the end."/>
                                        </WrapPanel>
                                    </Grid>

                                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,8,0,0"/>
                                    <!-- SETMERGERMOVED_01 — the Video Merger switches (Skip cover pictures, Even out the volume) live in the merger only. -->
                                    <TextBlock Classes="H1" Text="Caption text"/>
                                    <!-- CAPTIONWIPE_01 -->
                                    <CheckBox Name="KeepCaptionCheckBox" Content="Keep my caption for the next video" IsChecked="{Binding Vm.KeepOverlayTextBetweenVideos, Mode=TwoWay}"
                                              ToolTip.Tip="This is about the words you type across the top of the video.&#x0a;&#x0a;OFF (normal): every new video starts with an empty box, so you can never accidentally publish a clip with the last one's title.&#x0a;&#x0a;ON: the words stay and carry over to the next video. Handy for a series with the same title, but then it is on you to change it."/>

                                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,8,0,0"/>
                                    <!-- SETSAFEONE_01 — one switch replaces the eleven "Ask before…" boxes. -->
                                    <TextBlock Classes="H1" Text="Safety"/>
                                    <CheckBox Name="AskBeforeRiskyCheckBox" Content="Ask 'Are you sure?' before things you can't undo" IsChecked="{Binding Vm.AskBeforeRiskyActions, Mode=TwoWay}"
                                              ToolTip.Tip="ON (recommended): the app asks first before closing with work in progress, leaving your edit for the Video Merger or Crop Tool, clearing the merger's whole list, resetting a whole crop layout, or deleting a voice recording.&#x0a;&#x0a;Things you can take back with Ctrl+Z (deleting a segment, cutting a part, removing a clip…) never ask.&#x0a;&#x0a;OFF: the app never asks."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ═════════════════════════ FILES & FOLDERS ═════════════════════════ -->
                        <!-- OUTNAME_01 / ISSUE_04 — where finished videos are saved and how they are named. -->
                        <TabItem Header="Files &amp; Folders" Name="FilesTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Classes="Page">
                                    <!-- SETMUSICDIR_01 — read-only + Browse: a half-typed path can no longer be saved. -->
                                    <TextBlock Classes="H1" Text="Music folder" Margin="0,4,0,0"/>
                                    <TextBlock Classes="Hint" Text="Where the Add Music wizard looks for your songs (mp3 files)."/>
                                    <TextBox Name="DefaultMusicFolderTextBox" IsReadOnly="True" Text="{Binding Vm.MusicFolderDisplay}" AutomationProperties.Name="Music folder"
                                             ToolTip.Tip="The folder the app searches for background music. Use Browse to change it."/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Name="BrowseMusicFolderBtn" Classes="Primary" Content="Browse…" Click="OnBrowseMusicFolder" Cursor="Hand" ToolTip.Tip="Pick the folder that holds your music."/>
                                        <Button Name="ResetMusicFolderBtn" Classes="Secondary" Content="Use Windows Music" Click="OnResetMusicFolder" Cursor="Hand" ToolTip.Tip="Go back to your Windows Music folder."/>
                                    </StackPanel>

                                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,8,0,0"/>
                                    <!-- SETFOLDERONE_01 — one save folder for the Main App and the Video Merger. -->
                                    <TextBlock Classes="H1" Text="Finished videos"/>
                                    <TextBlock Classes="Hint" Text="Each video gets the name you type plus the next free number, so nothing is ever overwritten."/>

                                    <TextBlock Classes="Label" Text="Save to" Margin="0,6,0,0"/>
                                    <TextBox Name="SaveFolderTextBox" IsReadOnly="True" Text="{Binding Vm.SaveFolderDisplay}" AutomationProperties.Name="Save folder" ToolTip.Tip="Where the Main App and the Video Merger save finished videos."/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Name="ChangeSaveFolderBtn" Click="OnChangeSaveFolder" Classes="Primary" Content="Change folder…" Cursor="Hand" ToolTip.Tip="Pick the folder finished videos are saved into."/>
                                        <Button Name="ResetSaveFolderBtn" Click="OnResetSaveFolder" Classes="Secondary" Content="Use Downloads" Cursor="Hand" ToolTip.Tip="Go back to saving into your Windows Downloads folder."/>
                                    </StackPanel>

                                    <!-- SETNAMEONE_01 — ONE file name; the Video Merger adds "-merged" to it. -->
                                    <TextBlock Classes="Label" Text="File name" Margin="0,6,0,0"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBox Name="MainOutputBaseNameTextBox" Text="{Binding Vm.MainOutputBaseName, Mode=TwoWay}" MinWidth="300" MaxLength="80" AutomationProperties.Name="File name"
                                                 ToolTip.Tip="The name in front of the number. Example: Clips gives Clips-1.mp4, Clips-2.mp4 … from the Main App, and Clips-merged-1.mp4, Clips-merged-2.mp4 … from the Video Merger. Letters Windows does not allow in file names are removed for you."/>
                                        <Button Name="ResetMainOutputBaseNameBtn" Click="OnResetMainOutputBaseName" Classes="Secondary" Content="Default" Cursor="Hand" ToolTip.Tip="Restore the default name."/>
                                    </StackPanel>
                                    <!-- SETNAMEWARN_01 — what SAVE will change in the typed name, said before SAVE. -->
                                    <TextBlock Name="MainOutputNameWarningText" Text="{Binding Vm.MainOutputNameWarning}" IsVisible="{Binding Vm.MainOutputNameWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{DynamicResource AppDangerBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap"/>
                                    <TextBlock Name="MainOutputNamePreviewText" Classes="Hint" Text="{Binding Vm.MainOutputNamePreview}"/>
                                    <TextBlock Name="MergerOutputNamePreviewText" Classes="Hint" Text="{Binding Vm.MergerOutputNamePreview}"/>

                                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,8,0,0"/>
                                    <!-- MEMEPENDING_01 — the meme folder is pending until SAVE, like every other setting. -->
                                    <TextBlock Classes="H1" Text="Meme folder"/>
                                    <TextBlock Classes="Hint" Text="All your meme videos and pictures live in one folder. The app fills the meme list on the main screen from it."/>
                                    <TextBox Name="MemeFolderTextBox" IsReadOnly="True" Text="{Binding Vm.MemeFolderDisplay}" AutomationProperties.Name="Meme folder" ToolTip.Tip="The folder the app scans for memes."/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Name="ChangeMemeFolderBtn" Classes="Primary" Content="Change folder…" Click="OnChangeMemeFolder" Cursor="Hand" ToolTip.Tip="Pick a different folder to keep your memes in. Takes effect when you press SAVE."/>
                                        <Button Name="OpenMemeFolderBtn" Classes="Secondary" Content="Open folder" Click="OnOpenMemeFolder" Cursor="Hand" ToolTip.Tip="Open the meme folder in Windows Explorer, to add your own files."/>
                                        <Button Name="ResetMemeFolderBtn" Classes="Secondary" Content="Use default" Click="OnResetMemeFolder" Cursor="Hand" ToolTip.Tip="Go back to the default meme folder (Videos\FreeVideoStudio\Memes)."/>
                                    </StackPanel>
                                    <TextBlock Name="OutputFilesStatusText" Text="{Binding Vm.OutputFilesStatus}" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ═════════════════════════ SOUND & MUSIC ═════════════════════════ -->
                        <TabItem Header="Sound &amp; Music" Name="SoundTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="GeneralPanel" Classes="Page">
                                    <!-- SETSOUNDONE_01 — one 4-way choice replaces two switches, two strength handles and a reset button. -->
                                    <StackPanel Classes="LabelRow" Margin="0,4,0,0" ToolTip.Tip="When your video has background music, the app stops the music from hiding your game sounds: the music gets quieter for a moment when the game gets loud, and makes a little room for voices and game sounds.&#x0a;&#x0a;Off: the music is never changed.&#x0a;Gentle: the music gives way only a little.&#x0a;Normal (recommended): the tuned out-of-the-box setting.&#x0a;Strong: game sounds always come through clearly.&#x0a;&#x0a;You hear it in the main preview and in every export.">
                                        <TextBlock Classes="H1" Text="Keep game sounds clear" Margin="0"/>
                                        <TextBlock Classes="Info"/>
                                    </StackPanel>
                                    <TextBlock Classes="Hint" Text="When your video has music: how much the music gives way to your game sounds."/>
                                    <WrapPanel Orientation="Horizontal">
                                        <RadioButton GroupName="ClearSound" Name="ClearOffRadio" Content="Off" IsChecked="{Binding Vm.ClearOff, Mode=TwoWay}"/>
                                        <RadioButton GroupName="ClearSound" Name="ClearGentleRadio" Content="Gentle" IsChecked="{Binding Vm.ClearGentle, Mode=TwoWay}"/>
                                        <RadioButton GroupName="ClearSound" Name="ClearNormalRadio" Content="Normal" IsChecked="{Binding Vm.ClearNormal, Mode=TwoWay}"/>
                                        <RadioButton GroupName="ClearSound" Name="ClearStrongRadio" Content="Strong" IsChecked="{Binding Vm.ClearStrong, Mode=TwoWay}"/>
                                    </WrapPanel>

                                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,8,0,0"/>
                                    <!-- SETLOUD_01 — one 3-way choice (was a list + a contradicting master switch). -->
                                    <StackPanel Classes="LabelRow" Margin="0,12,0,0" ToolTip.Tip="An explosion or a shout far louder than the rest of the video can hurt somebody wearing headphones.&#x0a;&#x0a;Ask me: when you upload such a video, the app asks whether to soften those moments.&#x0a;Always soften: does it without asking.&#x0a;Never soften: leaves them alone (also in the Video Merger).&#x0a;&#x0a;Either way, a safety limiter always stops the sound from distorting.">
                                        <TextBlock Classes="H1" Text="Sudden loud moments" Margin="0"/>
                                        <TextBlock Classes="Info"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="LoudMoments" Name="LoudAskRadio" Content="Ask me" IsChecked="{Binding Vm.LoudAsk, Mode=TwoWay}"/>
                                        <RadioButton GroupName="LoudMoments" Name="LoudAlwaysRadio" Content="Always soften" IsChecked="{Binding Vm.LoudAlways, Mode=TwoWay}"/>
                                        <RadioButton GroupName="LoudMoments" Name="LoudNeverRadio" Content="Never soften" IsChecked="{Binding Vm.LoudNever, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ═════════════════════════ SHORTCUTS ═════════════════════════ -->
                        <TabItem Header="Shortcuts" Name="ShortcutsTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="KeyBindsPanel" Classes="Page">
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" Text="Click a key button, then press the new key. Esc cancels. Rows marked 'Ctrl +' are pressed together with Ctrl."/>
                                    <ItemsControl Name="KeyBindsList" ItemsSource="{Binding Vm.KeyBindRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:KeyBindRowViewModel">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,3" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                    <Button Grid.Column="1" Classes="Primary" MinWidth="150" HorizontalContentAlignment="Center" Content="{Binding Display}"
                                                            Click="OnKeyBindButtonClick" AutomationProperties.Name="{Binding Label}" ToolTip.Tip="Click, then press the key you want."/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Name="KeyBindStatusText" Text="{Binding Vm.KeyBindStatus}" Foreground="{DynamicResource AppDangerBrush}" FontSize="{DynamicResource AppFontSize12}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ═════════════════════════ AI ═════════════════════════ -->
                        <!-- AIPROVIDER_UI_01 / SETAIONE_01 — ONE AI company for every feature, ONE key box (SETKEYONE_01).
                             AI permissions are given by saving a key (SETNOCONSENTUI_01). -->
                        <TabItem Header="AI" Name="AiFeaturesTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Classes="Page" Spacing="14">
                                    <TextBlock Classes="Hint" Margin="0,4,0,0" Text="AI runs in the cloud with your own key. Nothing is sent until you use an AI feature."/>
                                    <Border Classes="Card" BorderBrush="{DynamicResource AppWarningBrush}" IsVisible="{Binding Vm.AiNeedsKey}">
                                        <TextBlock Classes="Hint" Foreground="{DynamicResource AppWarningBrush}" Text="Add an AI key in 'AI keys' first. Greyed-out features switch on as soon as their company has a key."/>
                                    </Border>
                                    <!-- SETKEYSFIRST_01 — the "AI keys" panel moves here (top) when no key is saved yet. -->
                                    <StackPanel Name="AiKeysTopHost"/>

                                    <TextBlock Classes="H1" Text="Features" Margin="0"/>
                                    <Border Classes="Card">
                                        <StackPanel Spacing="6" IsEnabled="{Binding Vm.AiViralReady}">
                                            <CheckBox Name="AiViralPostHelperCheckBox" FontWeight="SemiBold" Content="Write my post (after export)"
                                                      IsChecked="{Binding Vm.AiViralPostHelperEnabled, Mode=TwoWay}"
                                                      ToolTip.Tip="After you export, the AI writes a title, a caption and hashtags for your video, with one-click copy and a NEW VERSION button.&#x0a;&#x0a;To do that it sends 3 still pictures of the exported video to your AI company."/>
                                            <TextBlock Classes="Hint" Text="Writes a title, caption and hashtags for the video you just exported. Sends 3 still pictures of it to your AI company."/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="Card">
                                        <StackPanel Spacing="6" IsEnabled="{Binding Vm.AiKillTrackerReady}">
                                            <CheckBox Name="AiEliminationTrackerCheckBox" FontWeight="SemiBold" Content="Mark my kills on the timeline"
                                                      IsChecked="{Binding Vm.AiEliminationTrackerEnabled, Mode=TwoWay}"
                                                      ToolTip.Tip="When a video opens, the AI looks at its loudest action moments and puts a red ✕ above the timeline at each of YOUR kills. Click a ✕ to jump there.&#x0a;&#x0a;To do that it sends 2 still pictures per loud moment (at most 60 per video) to your AI company."/>
                                            <TextBlock Classes="Hint" Text="Puts a red ✕ above the timeline at each of your kills. Sends up to 60 still pictures per video to your AI company."/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Classes="Hint" Text="Always available where you work: AI SMART ZOOM and AI COMMENTARY in the Speed Editor, MAGIC WAND in the Crop Tool, and AI Auto-Fit in the Add Music wizard. Saving a key lets them send pictures and short clips to that company."/>

                                    <!-- AIUSAGE_04 — what AI cost in this session (tokens reported by the company; dollars are estimates). -->
                                    <TextBlock Name="AiSessionUsageText" Classes="Hint" TextWrapping="Wrap"
                                               AutomationProperties.Name="AI usage this session"/>

                                    <!-- SETAIONE_01 — one company for every feature; the model is under Advanced (SETAIMODEL_01). -->
                                    <TextBlock Classes="H1" Text="AI company" Margin="0"/>
                                    <Border Classes="Card">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Text="Used by every AI feature" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <TextBlock Name="AiDefaultRecommendedBadge" Grid.Column="1" Text="★ Recommended: Google Gemini · gemini-3.8-flash"
                                                           Foreground="{DynamicResource AppAccentBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <ComboBox Name="AiDefaultVendorCombo" MinWidth="200" AutomationProperties.Name="AI company" ToolTip.Tip="Which AI company to use. You need a key from that company."/>
                                                <Button Name="AiDefaultUseRecommendedBtn" Classes="Secondary" Content="Use recommended" Cursor="Hand" ToolTip.Tip="Google Gemini with the recommended model."/>
                                            </StackPanel>
                                            <Expander Name="AiModelExpander" Header="Advanced: AI model" HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Which of that company's AI models to use. The recommended one is fast and cheap. Most people never change this.">
                                                <Grid ColumnDefinitions="*, 10, Auto" Margin="0,8,0,0">
                                                    <ComboBox Name="AiDefaultModelCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="AI model" ToolTip.Tip="Which of that company's AI models to use. The recommended one is fast and cheap."/>
                                                    <Button Name="AiDefaultRefreshBtn" Grid.Column="2" Classes="Secondary" Content="Refresh" Cursor="Hand" ToolTip.Tip="Asks the company which models your key can use and updates the list."/>
                                                </Grid>
                                            </Expander>
                                        </StackPanel>
                                    </Border>

                                    <!-- SETKEYONE_01 — paste ANY key: the company is recognised from it. -->
                                    <Expander Name="AiKeysExpander" Header="AI keys" HorizontalAlignment="Stretch"
                                              ToolTip.Tip="A key is like a password from the AI company that lets the app use its AI on your account. Keys are stored encrypted, for your Windows account only.">
                                        <StackPanel Spacing="10" Margin="0,8,0,0">
                                            <TextBlock Classes="Hint" Text="Paste a key from Google, Anthropic or OpenAI. The app recognises the company by itself."/>
                                            <Grid ColumnDefinitions="*, Auto, Auto">
                                                <TextBox Name="AiNewKeyTextBox" PasswordChar="•" Watermark="Paste any AI key here…" MinWidth="240" Margin="0,0,10,0"
                                                         AutomationProperties.Name="Paste an AI key"/>
                                                <!-- SETREVEAL_01 — show the key while checking it for typos; hidden again on leaving the tab or window. -->
                                                <ToggleButton Name="AiNewKeyRevealBtn" Grid.Column="1" Classes="Secondary" Content="👁" MinWidth="40" Margin="0,0,10,0" Cursor="Hand"
                                                              IsChecked="{Binding #AiNewKeyTextBox.RevealPassword, Mode=TwoWay}" AutomationProperties.Name="Show the key"
                                                              ToolTip.Tip="Shows the key as letters so you can check it. It goes back to dots when you leave this tab."/>
                                                <Button Name="AiAddKeyBtn" Grid.Column="2" Classes="Primary" Content="Add key" Cursor="Hand" MinWidth="90"
                                                        ToolTip.Tip="Recognises the company, checks the key with it, and keeps it (saved when you press SAVE)."/>
                                            </Grid>
                                            <TextBlock Name="AiAddKeyStatusText" Classes="Hint" Text="" TextWrapping="Wrap"/>
                                            <!-- One row per saved key (built in SettingsWindow.AiTracking.cs). -->
                                            <StackPanel Name="AiSavedKeysPanel" Spacing="8"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Classes="Hint" Text="No key yet? Get one:" VerticalAlignment="Center"/>
                                                <Button Name="AiGetFreeKeyBtn" Classes="Secondary" Content="Google (free)" Cursor="Hand" ToolTip.Tip="Opens Google AI Studio in your browser, where you can make a free key."/>
                                                <Button Name="AiGetClaudeKeyBtn" Classes="Secondary" Content="Anthropic" Cursor="Hand" ToolTip.Tip="Opens the Anthropic Console in your browser, where you can make a key."/>
                                                <Button Name="AiGetOpenAiKeyBtn" Classes="Secondary" Content="OpenAI" Cursor="Hand" ToolTip.Tip="Opens the OpenAI platform in your browser, where you can make a key."/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <!-- SETZOOMONE_01 — one "Zoom strength" slider; the rest of the camera is tuned. -->
                                    <Expander Header="AI Smart Zoom camera" HorizontalAlignment="Stretch"
                                              ToolTip.Tip="How close AI SMART ZOOM follows the action in the Speed Editor.">
                                        <StackPanel Spacing="4" Margin="0,8,0,0" ToolTip.Tip="How close the camera moves in. Bigger number = closer.&#x0a;When the action moves fast, the camera backs off a little by itself so nothing runs out of the picture.">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Classes="Label" Text="Zoom strength"/>
                                                <TextBlock Name="AiBaseZoomLabel" Grid.Column="1" Text="{Binding Vm.AiZoomBaseLabel}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                            </Grid>
                                            <Slider Name="AiBaseZoomSlider" Minimum="1.5" Maximum="4.0" TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="0.5" Value="{Binding Vm.AiZoomBaseScale, Mode=TwoWay}" AutomationProperties.Name="Zoom strength"/>
                                            <TextBlock Classes="Hint" Text="The camera follows the game you picked on the Editing tab."/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ═════════════════════════ ABOUT ═════════════════════════ -->
                        <TabItem Header="About" Name="AboutTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Classes="Page" Spacing="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Free Video Studio" FontSize="{DynamicResource AppFontSize18}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Name="AboutVersionText" Text="Version" FontSize="{DynamicResource AppFontSize13}" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
                                        <TextBlock Text="Free Video Studio — Trim, speed-ramp, add music and export gameplay clips." Classes="Hint"/>
                                        <TextBlock Text="Copyright © 2026 Alon Reich. Licensed under the GNU GPL v3." Classes="Hint"/>
                                    </StackPanel>
                                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1"/>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="System" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="8" RowSpacing="4">
                                            <TextBlock Grid.Row="0" Text="Runtime:" Foreground="{DynamicResource AppTextMutedBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Name="AboutPlatformText" Grid.Row="0" Grid.Column="1" Text="" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="Video chip:" Foreground="{DynamicResource AppTextMutedBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Name="AboutGpuText" Grid.Row="1" Grid.Column="1" Text="{Binding Vm.EncoderSummary}" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="App data folder:" Foreground="{DynamicResource AppTextMutedBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Name="AboutStorageText" Grid.Row="2" Grid.Column="1" Text="" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1"/>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Updates" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Classes="Hint" Text="How the app updates itself is set on the General tab."/>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Name="CheckUpdatesNowBtn" Classes="Primary" Content="Check for updates now" Cursor="Hand" Margin="0,0,12,6"
                                                    ToolTip.Tip="Asks GitHub right now whether a newer version of Free Video Studio exists."/>
                                            <TextBlock Name="UpdateStatusText" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" TextWrapping="Wrap" MaxWidth="400"/>
                                        </WrapPanel>
                                        <TextBlock Name="UpdateLastCheckText" Classes="Hint" FontSize="{DynamicResource AppFontSize12}"/>
                                        <Button Name="WhatsNewBtn" Classes="Secondary" Content="What's new in this version" Cursor="Hand" HorizontalAlignment="Left"
                                                ToolTip.Tip="Opens the page that lists everything that changed in each version of Free Video Studio."/>
                                        <Button Name="SkipPendingBtn" Classes="Secondary" Content="Skip this version" IsVisible="False" Cursor="Hand" HorizontalAlignment="Left"
                                                ToolTip.Tip="Stops the update that is downloading or waiting, and does not offer this version again. A newer version will still be offered."/>
                                        <Border Name="SkippedReleaseBorder" Classes="Card" Padding="10,8" IsVisible="False">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Name="SkippedReleaseLabel" Text="" Foreground="{DynamicResource AppWarningBrush}" VerticalAlignment="Center" FontSize="{DynamicResource AppFontSize12}"/>
                                                <Button Name="ClearSkipBtn" Classes="Secondary" Content="Offer it again" Cursor="Hand" ToolTip.Tip="Forgets the skipped version so it can be offered again."/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- SETSEARCH_01 — results float over the tabs while the search box has text. -->
                    <Border Name="SearchResultsBorder" IsVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="680" MinWidth="420"
                            Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="4" ZIndex="10">
                        <ListBox Name="SearchResultsList" MaxHeight="300" Background="Transparent" AutomationProperties.Name="Search results"/>
                    </Border>
                </Grid>

                <!-- Footer: restore this tab · status · CANCEL / SAVE -->
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="15,12,15,12">
                    <Button Name="RestoreTabBtn" Classes="Secondary" Content="Restore this tab" Click="OnRestoreTab" Cursor="Hand"
                            ToolTip.Tip="Puts every setting on the tab you are looking at back to how it was when the app was installed. Nothing changes until you press SAVE."/>
                    <TextBlock Name="FooterStatusText" Grid.Column="1" Margin="14,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource AppTextMutedBrush}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        <!-- ISSUE_08 (audit round 4): CANCEL is Secondary suite-wide (red = destructive data loss only) -->
                        <Button Name="CancelBtn" Classes="Secondary" Content="CANCEL" MinWidth="90" Click="OnCancelClicked" ToolTip.Tip="Close without saving (Esc)"/>
                        <Button Name="SaveBtn" Classes="Success" Content="SAVE" MinWidth="90" Click="OnSaveClicked" ToolTip.Tip="Save your changes and close (Ctrl+Enter, or Enter when you are not typing in a box)"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
