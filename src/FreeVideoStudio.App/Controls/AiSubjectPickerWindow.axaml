<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FreeVideoStudio.App.Controls.AiSubjectPickerWindow"
        Title="AI Smart Zoom — Choose Who to Follow"
        Width="1140" Height="780" MinWidth="760" MinHeight="560"
        Background="{DynamicResource AppSurfaceBrush}"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <Grid>
        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="3">
            <Grid RowDefinitions="30, Auto, *, Auto, Auto">
                <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="PickerWindowTitleText" Text="AI SMART ZOOM — CHOOSE WHO TO FOLLOW" Classes="WindowTitleText" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>

                <StackPanel Grid.Row="1" Margin="28,12,28,6" Spacing="6">
                    <TextBlock Name="PickerHeadlineText" Text="Stage 1 of 3 · Choose who to follow" FontSize="{DynamicResource AppFontSize20}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <Border Background="{DynamicResource AppSurfaceSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,10">
                        <StackPanel Spacing="3">
                            <TextBlock Name="PickerIntroText" Text="Click the enemy in each picture where you can see them."
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSize13}" TextWrapping="Wrap"/>
                            <TextBlock Name="PickerStep2GuideText" IsVisible="False" Text=""
                                       Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Name="FallbackNoticeText" IsVisible="False" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock Name="LookaheadNoticeText" IsVisible="False" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize13}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </StackPanel>

                <Grid Grid.Row="2" ColumnDefinitions="*,12,*,12,*" Margin="28,6,28,10">
                    <Border Name="Frame1Border" Grid.Column="0" Background="{DynamicResource AppSurfaceSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True">
                        <Grid RowDefinitions="Auto, *, Auto">
                            <Border Background="{DynamicResource AppScrimBrush}" Padding="8,5">
                                <TextBlock Name="Frame1TimeLabel" Text="Picture 1 (Start)" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                                <Grid Name="Frame1HitGrid" Background="Transparent" Cursor="Hand" ClipToBounds="True"
                                      ToolTip.Tip="Click the enemy in Picture 1. Spin the mouse wheel to zoom, drag with the right or middle mouse button to look around.">
                                    <Border Name="Frame1Viewport" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" Background="{DynamicResource AppScrimBrush}">
                                        <Grid>
                                            <Canvas Name="Frame1Stage">
                                                <Image Name="Frame1Image" Stretch="Fill"/>
                                            </Canvas>
                                            <Canvas Name="Frame1Canvas" IsHitTestVisible="False" ClipToBounds="True"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto, Auto" Margin="2,6,6,6">
                                    <Button Name="Frame1ZoomInBtn" Grid.Row="0" Content="+" Classes="Secondary" Width="30" MinHeight="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Zoom in on this picture"/>
                                    <Slider Name="Frame1ZoomSlider" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,4" Cursor="Hand" ToolTip.Tip="Zoom this picture in or out"/>
                                    <Button Name="Frame1ZoomOutBtn" Grid.Row="2" Content="−" Classes="Secondary" Width="30" MinHeight="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Zoom out to see the sides of this picture"/>
                                    <Button Name="Frame1ZoomResetBtn" Grid.Row="3" Content="⟲" Classes="Secondary" Width="30" MinHeight="28" Margin="0,4,0,0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Reset the zoom of this picture"/>
                                </Grid>
                            </Grid>
                            <Border Grid.Row="2" Background="{DynamicResource AppScrimBrush}" Padding="8,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
                                <Grid ColumnDefinitions="*, Auto, Auto">
                                    <TextBlock Name="Frame1Badge" Text="Waiting for selection" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Name="Frame1NextImageBtn" Grid.Column="1" Content="Next Image" Classes="Secondary" FontSize="{DynamicResource AppFontSize11}" MinHeight="26" Margin="4,0,0,0" Cursor="Hand"
                                            ToolTip.Tip="Can't spot the enemy here? Shows another picture about a second away. Click again for another one."/>
                                    <Button Name="Frame1ClearBtn" Grid.Column="2" Content="Clear" Classes="Secondary" FontSize="{DynamicResource AppFontSize11}" MinHeight="26" Margin="4,0,0,0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Name="Frame2Border" Grid.Column="2" Background="{DynamicResource AppSurfaceSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True">
                        <Grid RowDefinitions="Auto, *, Auto">
                            <Border Background="{DynamicResource AppScrimBrush}" Padding="8,5">
                                <TextBlock Name="Frame2TimeLabel" Text="Picture 2 (Middle)" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                                <Grid Name="Frame2HitGrid" Background="Transparent" Cursor="Hand" ClipToBounds="True"
                                      ToolTip.Tip="Click the enemy in Picture 2. Spin the mouse wheel to zoom, drag with the right or middle mouse button to look around.">
                                    <Border Name="Frame2Viewport" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" Background="{DynamicResource AppScrimBrush}">
                                        <Grid>
                                            <Canvas Name="Frame2Stage">
                                                <Image Name="Frame2Image" Stretch="Fill"/>
                                            </Canvas>
                                            <Canvas Name="Frame2Canvas" IsHitTestVisible="False" ClipToBounds="True"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto, Auto" Margin="2,6,6,6">
                                    <Button Name="Frame2ZoomInBtn" Grid.Row="0" Content="+" Classes="Secondary" Width="30" MinHeight="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Zoom in on this picture"/>
                                    <Slider Name="Frame2ZoomSlider" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,4" Cursor="Hand" ToolTip.Tip="Zoom this picture in or out"/>
                                    <Button Name="Frame2ZoomOutBtn" Grid.Row="2" Content="−" Classes="Secondary" Width="30" MinHeight="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Zoom out to see the sides of this picture"/>
                                    <Button Name="Frame2ZoomResetBtn" Grid.Row="3" Content="⟲" Classes="Secondary" Width="30" MinHeight="28" Margin="0,4,0,0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Reset the zoom of this picture"/>
                                </Grid>
                            </Grid>
                            <Border Grid.Row="2" Background="{DynamicResource AppScrimBrush}" Padding="8,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
                                <Grid ColumnDefinitions="*, Auto, Auto">
                                    <TextBlock Name="Frame2Badge" Text="Waiting for selection" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Name="Frame2NextImageBtn" Grid.Column="1" Content="Next Image" Classes="Secondary" FontSize="{DynamicResource AppFontSize11}" MinHeight="26" Margin="4,0,0,0" Cursor="Hand"
                                            ToolTip.Tip="Can't spot the enemy here? Shows another picture about a second away. Click again for another one."/>
                                    <Button Name="Frame2ClearBtn" Grid.Column="2" Content="Clear" Classes="Secondary" FontSize="{DynamicResource AppFontSize11}" MinHeight="26" Margin="4,0,0,0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Name="Frame3Border" Grid.Column="4" Background="{DynamicResource AppSurfaceSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True">
                        <Grid RowDefinitions="Auto, *, Auto">
                            <Border Background="{DynamicResource AppScrimBrush}" Padding="8,5">
                                <TextBlock Name="Frame3TimeLabel" Text="Picture 3 (End)" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                                <Grid Name="Frame3HitGrid" Background="Transparent" Cursor="Hand" ClipToBounds="True"
                                      ToolTip.Tip="Click the enemy in Picture 3. Spin the mouse wheel to zoom, drag with the right or middle mouse button to look around.">
                                    <Border Name="Frame3Viewport" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" Background="{DynamicResource AppScrimBrush}">
                                        <Grid>
                                            <Canvas Name="Frame3Stage">
                                                <Image Name="Frame3Image" Stretch="Fill"/>
                                            </Canvas>
                                            <Canvas Name="Frame3Canvas" IsHitTestVisible="False" ClipToBounds="True"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto, Auto" Margin="2,6,6,6">
                                    <Button Name="Frame3ZoomInBtn" Grid.Row="0" Content="+" Classes="Secondary" Width="30" MinHeight="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Zoom in on this picture"/>
                                    <Slider Name="Frame3ZoomSlider" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,4" Cursor="Hand" ToolTip.Tip="Zoom this picture in or out"/>
                                    <Button Name="Frame3ZoomOutBtn" Grid.Row="2" Content="−" Classes="Secondary" Width="30" MinHeight="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Zoom out to see the sides of this picture"/>
                                    <Button Name="Frame3ZoomResetBtn" Grid.Row="3" Content="⟲" Classes="Secondary" Width="30" MinHeight="28" Margin="0,4,0,0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Reset the zoom of this picture"/>
                                </Grid>
                            </Grid>
                            <Border Grid.Row="2" Background="{DynamicResource AppScrimBrush}" Padding="8,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
                                <Grid ColumnDefinitions="*, Auto, Auto">
                                    <TextBlock Name="Frame3Badge" Text="Waiting for selection" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Name="Frame3NextImageBtn" Grid.Column="1" Content="Next Image" Classes="Secondary" FontSize="{DynamicResource AppFontSize11}" MinHeight="26" Margin="4,0,0,0" Cursor="Hand"
                                            ToolTip.Tip="Can't spot the enemy here? Shows another picture about a second away. Click again for another one."/>
                                    <Button Name="Frame3ClearBtn" Grid.Column="2" Content="Clear" Classes="Secondary" FontSize="{DynamicResource AppFontSize11}" MinHeight="26" Margin="4,0,0,0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3" IsVisible="False" Background="{DynamicResource AppSurfaceSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="28,0,28,10" Padding="14,10">
                    <StackPanel Spacing="6">
                        <TextBlock Name="SubjectsSectionHeaderText" Text="SUGGESTED TARGET OPTIONS" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" LetterSpacing="1"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Name="SubjectsContainer" Orientation="Horizontal" Spacing="14" Margin="4,4,4,6"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="28,0,28,10">
                    <TextBlock Text="Zoom:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <ToggleButton Name="PickerZoomLessBtn" Content="Less" MinHeight="34" MinWidth="70" Cursor="Hand" ToolTip.Tip="The camera stays wider. The target looks smaller."/>
                    <ToggleButton Name="PickerZoomNormalBtn" Content="Normal" MinHeight="34" MinWidth="70" Cursor="Hand" ToolTip.Tip="The usual amount of zoom."/>
                    <ToggleButton Name="PickerZoomMoreBtn" Content="More" MinHeight="34" MinWidth="70" Cursor="Hand" ToolTip.Tip="The camera goes closer. The target looks bigger."/>
                </StackPanel>

                <Grid Grid.Row="4" ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto" Margin="28,0,28,16">
                    <Button Name="CancelPickerBtn" Grid.Column="0" Classes="Secondary" Content="CANCEL" MinWidth="105" MinHeight="42" Cursor="Hand" IsCancel="True"
                            ToolTip.Tip="Closes this list. Nothing changes in your video."/>
                    <Button Name="SkipBlockBtn" Grid.Column="1" Classes="Secondary" Content="SKIP BLOCK" MinHeight="42" Cursor="Hand" Margin="8,0,0,0" IsVisible="False"
                            ToolTip.Tip="Skips zooming this block and moves to the next block in the batch."/>
                    <Button Name="DescribeManuallyBtn" Grid.Column="2" Classes="Secondary" Content="Describe Manually" MinHeight="42" Cursor="Hand" Margin="8,0,0,0"
                            ToolTip.Tip="Didn't see the right option above? Click to describe who or what you want Cloud AI to mark in these pictures."/>
                    <Button Name="ResampleBtn" Grid.Column="2" Classes="Secondary" Content="Try Another Moment" MinHeight="42" Cursor="Hand" Margin="8,0,0,0" IsVisible="False"
                            ToolTip.Tip="Samples different moments within this segment to find your target."/>
                    <TextBlock Name="SelectionStatusText" Grid.Column="3" Text="Click the enemy in each picture where you can see them."
                               FontSize="{DynamicResource AppFontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="10,0"/>
                    <Button Name="BackStageBtn" Grid.Column="4" Classes="Secondary" Content="← BACK" MinWidth="100" MinHeight="42" Cursor="Hand" Margin="0,0,8,0" IsVisible="False"
                            ToolTip.Tip="Returns to Stage 1 to choose or adjust pictures."/>
                    <Button Name="ConfirmPickerBtn" Grid.Column="5" Classes="Success" Content="Next: Check Selections →" MinWidth="230" MinHeight="42" Cursor="Hand" IsEnabled="False" IsDefault="True"
                            ToolTip.Tip="Review your selections."/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
