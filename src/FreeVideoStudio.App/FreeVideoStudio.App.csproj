<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FreeVideoStudio.Core\FreeVideoStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeVideoStudio.App.Tests" />
    <InternalsVisibleTo Include="FreeVideoStudio.AvRegression.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.2" />
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.1.0" />

  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Sounds\click.wav"   LogicalName="UiSound.click.wav" />
    <EmbeddedResource Include="Assets\Sounds\mark.wav"    LogicalName="UiSound.mark.wav" />
    <EmbeddedResource Include="Assets\Sounds\open.wav"    LogicalName="UiSound.open.wav" />
    <EmbeddedResource Include="Assets\Sounds\close.wav"   LogicalName="UiSound.close.wav" />
    <EmbeddedResource Include="Assets\Sounds\process.wav" LogicalName="UiSound.process.wav" />
    <EmbeddedResource Include="Assets\Sounds\error.wav"   LogicalName="UiSound.error.wav" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="SkiaSharp" />
    <InternalsVisibleTo Include="FreeVideoStudio.App.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <LinkerArg Include="/DEPENDENTLOADFLAG:0x800" />
  </ItemGroup>

  <ItemGroup>
    <Watch Include="**\*.axaml" />
    <UpToDateCheckInput Include="**\*.axaml" />
  </ItemGroup>

  <Target Name="CopyDevBinaries" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And Exists('$(MSBuildThisFileDirectory)..\..\binaries\mpv.exe')">
    <ItemGroup>
      <DevFrontendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\mpv.exe" />
      <DevFrontendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\libmpv-2.dll" />
      <DevBackendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\ffmpeg.exe" />
      <DevBackendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\ffprobe.exe" />
      <DevBackendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\av*.dll" />
      <DevBackendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\sw*.dll" />
      <DevBackendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\postproc*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DevFrontendBinaries)" DestinationFolder="$(OutDir)frontend" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DevBackendBinaries)" DestinationFolder="$(OutDir)backend" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <AssemblyName>FreeVideoStudio</AssemblyName>
    <PackageId>FreeVideoStudio</PackageId>
    <RootNamespace>FreeVideoStudio.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <SuppressAotAnalysisWarnings>false</SuppressAotAnalysisWarnings>
    <IlcTrimMetadata>false</IlcTrimMetadata>
    <ApplicationIcon>..\..\assets\icons\FreeVideoStudio.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  <NoWarn>$(NoWarn);CS1998;CS0414</NoWarn>
  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <Version>2026.10.13.2238</Version>
    <AssemblyVersion>2026.10.13.2238</AssemblyVersion>
    <FileVersion>2026.10.13.2238</FileVersion>
    <InformationalVersion>2026.10.13.2238</InformationalVersion>
    <Company>Alon Reich</Company>
    <Authors>Alon Reich</Authors>
    <Product>Free Video Studio</Product>
    <AssemblyTitle>Free Video Studio</AssemblyTitle>
    <Description>Trim, speed-ramp, add music and export gameplay clips for social video.</Description>
    <Copyright>Copyright © 2026 Alon Reich. Licensed under the GNU GPL v3.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

</Project>
