<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>FreeVideoStudio.Core</AssemblyName>
    <PackageId>FreeVideoStudio.Core</PackageId>
    <RootNamespace>FreeVideoStudio.Core</RootNamespace>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeVideoStudio.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.1.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
  </ItemGroup>

  <!-- ISSUE_03: the Win32 version block a user sees in Properties > Details comes from the ENTRY
       assembly (the App project), not from here. These are carried anyway so every managed
       assembly in the product reports the same publisher and version - a mismatched Company on a
       satellite assembly is exactly the kind of detail a security reviewer flags. Keep in step
       with FreeVideoStudio.App.csproj on every release. -->
  <PropertyGroup>
    <Version>2026.10.10.0926</Version>
    <AssemblyVersion>2026.10.10.0926</AssemblyVersion>
    <FileVersion>2026.10.10.0926</FileVersion>
    <InformationalVersion>2026.10.10.0926</InformationalVersion>
    <Company>Alon Reich</Company>
    <Authors>Alon Reich</Authors>
    <Product>Free Video Studio</Product>
    <Copyright>Copyright © 2026 Alon Reich. All rights reserved.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\LegacyAppDataNames.txt" LogicalName="LegacyAppDataNames.txt" />
  </ItemGroup>
</Project>
