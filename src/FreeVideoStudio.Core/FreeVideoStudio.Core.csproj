<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>FreeVideoStudio.Core</AssemblyName>
    <PackageId>FreeVideoStudio.Core</PackageId>
    <RootNamespace>FreeVideoStudio.Core</RootNamespace>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeVideoStudio.Core.Tests" />
    <InternalsVisibleTo Include="FreeVideoStudio.App.Tests" />
    <InternalsVisibleTo Include="FreeVideoStudio.AvRegression.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.1.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
  </ItemGroup>

  <PropertyGroup>
    <Version>2026.11.23.0836</Version>
    <AssemblyVersion>2026.11.23.0836</AssemblyVersion>
    <FileVersion>2026.11.23.0836</FileVersion>
    <InformationalVersion>2026.11.23.0836</InformationalVersion>
    <Company>Alon Reich</Company>
    <Authors>Alon Reich</Authors>
    <Product>Free Video Studio</Product>
    <Copyright>Copyright © 2026 Alon Reich. Licensed under the GNU GPL v3.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\LegacyAppDataNames.txt" LogicalName="LegacyAppDataNames.txt" />
    <EmbeddedResource Include="Assets\FreezeSounds\Church_Bell.wav" LogicalName="FreezeSound.Church_Bell.wav" />
    <EmbeddedResource Include="Assets\FreezeSounds\Church_Bell_Mid.wav" LogicalName="FreezeSound.Church_Bell_Mid.wav" />
    <EmbeddedResource Include="Assets\FreezeSounds\Church_Bell_Late.wav" LogicalName="FreezeSound.Church_Bell_Late.wav" />
    <EmbeddedResource Include="Assets\FreezeSounds\Cinematic_Dramatic_Slow-Down.wav" LogicalName="FreezeSound.Cinematic_Dramatic_Slow-Down.wav" />
  </ItemGroup>
</Project>
